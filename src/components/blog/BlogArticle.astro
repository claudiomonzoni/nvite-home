---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

interface Props {
  post: CollectionEntry<"blog">;
  language: "es" | "en";
}

const { post, language } = Astro.props;
const isEnglish = language === "en";
const { Content } = await render(post);
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const translationPair = allPosts.filter((entry) => entry.data.translationKey === post.data.translationKey);
const spanishPost = translationPair.find((entry) => entry.data.language === "es");
const englishPost = translationPair.find((entry) => entry.data.language === "en");
const spanishUrl = spanishPost ? `/blog/${spanishPost.data.slug || spanishPost.id}` : "/blog";
const englishUrl = englishPost ? `/en/blog/${englishPost.data.slug || englishPost.id}` : "/en/blog";
const languageUrls = { es: spanishUrl, en: englishUrl };
const alternates = [
  ...(spanishPost ? [{ lang: "es-MX", href: new URL(spanishUrl, Astro.site).href }] : []),
  ...(englishPost ? [{ lang: "en-US", href: new URL(englishUrl, Astro.site).href }] : []),
];
const slug = post.data.slug || post.id;
const basePath = isEnglish ? "/en/blog" : "/blog";
const canonical = new URL(`${basePath}/${slug}`, Astro.site).href;
const image = post.data.coverImage
  ? new URL(post.data.coverImage, Astro.site).href
  : undefined;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt || post.data.publishedAt).toISOString(),
  inLanguage: isEnglish ? "en-US" : "es-MX",
  author: {
    "@type": "Person",
    name: post.data.author,
    worksFor: { "@type": "Organization", name: "Nvitaciones" },
  },
  publisher: {
    "@type": "Organization",
    name: "Nvitaciones",
    url: Astro.site,
  },
  mainEntityOfPage: canonical,
  ...(image ? { image } : {}),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: isEnglish ? "Home" : "Inicio", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: isEnglish ? "Guides & Ideas" : "Guías e ideas", item: new URL(basePath, Astro.site).href },
    { "@type": "ListItem", position: 3, name: post.data.title, item: canonical },
  ],
};
const safeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<Layout
  title={`${post.data.title} | Nvitaciones`}
  description={post.data.description}
  image={image}
  ogType="article"
  publishedAt={post.data.publishedAt}
  alternates={alternates}
>
  <Nav languageUrls={languageUrls} />
  <script type="application/ld+json" set:html={safeJsonLd(articleSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />

  <main class="grid contenido blog-article">
    <nav class="blog-breadcrumbs" aria-label={isEnglish ? "Breadcrumb" : "Migas de pan"}>
      <a href="/">{isEnglish ? "Home" : "Inicio"}</a>
      <span aria-hidden="true">/</span>
      <a href={basePath}>{isEnglish ? "Guides & Ideas" : "Guías e ideas"}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{post.data.title}</span>
    </nav>

    <article>
      <header class="blog-article__header">
        <p class="blog-article__category">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <p class="blog-article__dek">{post.data.description}</p>
        <div class="blog-article__byline">
          <span class="blog-article__avatar" aria-hidden="true">MS</span>
          <span class="blog-article__author-copy">
            <strong>{post.data.author}</strong>
            <small>{isEnglish ? "Nvitaciones editorial signature" : "Firma editorial de Nvitaciones"}</small>
          </span>
          <time datetime={post.data.publishedAt.toISOString()}>
            {post.data.publishedAt.toLocaleDateString(isEnglish ? "en-US" : "es-MX", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </div>
        {post.data.coverImage && (
          <figure class="blog-article__cover-wrap grid pantalla">
            <img
              class="blog-article__cover"
              src={post.data.coverImage}
              alt={post.data.coverImageAlt || ""}
              fetchpriority="high"
            />
            <figcaption>{isEnglish ? "A celebration on Mexico's Pacific coast · Editorial image" : "Una celebración junto al Pacífico · Imagen editorial"}</figcaption>
          </figure>
        )}
      </header>

      <div class="blog-article__content">
        <Content />
      </div>

      <footer class="blog-article__footer">
        <div class="blog-article__footer-copy">
          <span>{isEnglish ? "A few details before the day" : "Unos detalles antes del gran día"}</span>
          <h2>{isEnglish ? "Share your day with clarity." : "Comparte tu gran día con claridad."}</h2>
          <p>{isEnglish ? "Explore digital wedding invitations that bring event details together and make it easier for guests to RSVP." : "Explora invitaciones digitales que reúnen los detalles de tu boda y facilitan el RSVP de tus invitados."}</p>
        </div>
        <a class="blog-article__cta" href="/bodas">{isEnglish ? "Explore wedding invitations" : "Ver invitaciones de boda"}</a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style lang="scss">
  @use "../../estilos/_variables.scss" as *;

  .blog-article {
    margin: 7rem auto 7rem;
    color: $gris;
  }

  .blog-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    color: $primario;
    font-size: 0.82rem;
  }

  .blog-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .blog-article__header {
    max-width: 960px;
    margin: 2.5rem auto 3rem;
    padding: clamp(1.4rem, 4vw, 3rem) clamp(1.2rem, 5vw, 4rem) 0;
    border-radius: 1.25rem;
    background: $fondoGlobal;
    box-shadow: 0 0.8rem 2rem rgba($primario, 0.07);
  }

  .blog-article__category {
    margin-bottom: 0.8rem;
    color: $primario;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .blog-article h1 {
    max-width: 850px;
    margin: 0 0 1rem;
    color: $primario;
    font-size: clamp(2.3rem, 5.5vw, 5rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .blog-article__dek {
    max-width: 720px;
    color: $primario;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .blog-article__byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.4rem 0 1.5rem;
    color: $primario;
  }

  .blog-article__avatar {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba($primario, 0.18);
    border-radius: 50%;
    background: $terciario;
    color: $primario;
    font-family: var(--font-hurme), sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .blog-article__author-copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .blog-article__author-copy strong {
    font-size: 0.85rem;
  }

  .blog-article__author-copy small,
  .blog-article__byline time {
    color: $gris;
    font-size: 0.75rem;
  }

  .blog-article__byline time {
    margin-left: auto;
  }

  .blog-article__cover-wrap {
    position: relative;
    width: 100%;
    min-width: 0;
    margin: 1.5rem 0 0;
    overflow: hidden;
    border-radius: 0.95rem 0.95rem 0 0;
  }

  .blog-article__cover {
    display: block;
    width: 100%;
    max-height: 610px;
    aspect-ratio: 16 / 8.2;
    object-fit: cover;
    object-position: center 55%;
  }

  .blog-article__cover-wrap figcaption {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.45rem 0.7rem;
    border-radius: 2rem;
    background: rgba($fondoGlobal, 0.9);
    color: $primario;
    font-size: 0.7rem;
  }

  .blog-article__content {
    max-width: 740px;
    margin: 0 auto;
    color: $gris;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.85;
  }

  .blog-article__content :global(> p:first-child) {
    color: $primario;
    font-size: 1.15em;
    line-height: 1.75;
  }

  .blog-article__content :global(h2),
  .blog-article__content :global(h3) {
    margin: 2.2em 0 0.6em;
    color: $primario;
    line-height: 1.25;
  }

  .blog-article__content :global(h2) {
    margin-top: 2.4em;
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    letter-spacing: -0.025em;
  }

  .blog-article__content :global(h3) {
    font-size: 1.28rem;
  }

  .blog-article__content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.6rem;
  }

  .blog-article__content :global(blockquote) {
    position: relative;
    margin: 2.4rem -1rem;
    padding: 1.5rem 1.6rem 1.5rem 2rem;
    border-left: 4px solid $terciario;
    border-radius: 0 0.85rem 0.85rem 0;
    background: $terciario;
    color: $primario;
    font-family: var(--font-hurme), sans-serif;
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.4;
  }

  .blog-article__content :global(blockquote p) {
    margin: 0;
    color: inherit;
  }

  .blog-article__content :global(blockquote strong) {
    color: $primario;
    font-weight: 700;
  }

  .blog-article__content :global(.editorial-product-figure) {
    margin: 2.2rem 0;
    padding: 1rem;
    border-radius: 1rem;
    background: $terciario;
  }

  .blog-article__content :global(.editorial-product-figure__images) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 0.75rem;
  }

  .blog-article__content :global(.editorial-product-figure img) {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
    box-shadow: 0 0.4rem 1.4rem rgba($gris, 0.12);
  }

  .blog-article__content :global(.editorial-product-figure figcaption) {
    margin: 0.9rem 0.25rem 0.1rem;
    color: $gris;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .blog-article__footer {
    display: flex;
    max-width: 960px;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin: 4rem auto 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 1rem;
    background: $primario;
    color: $fondoGlobal;
  }

  .blog-article__footer-copy > span {
    color: $fondoGlobal;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .blog-article__footer h2 {
    margin: 0.55rem 0;
    color: $fondoGlobal;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .blog-article__footer-copy p {
    max-width: 560px;
    margin: 0;
    color: rgba($fondoGlobal, 0.85);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .blog-article__cta {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.4rem;
    background: $terciario;
    color: $primario;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .blog-article__cta:hover {
    transform: translateY(-2px);
    background: $terciario;
    color: $primario;
  }

  .blog-article__cta:focus-visible {
    outline: 3px solid $secundario;
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .blog-article {
      margin-top: 5.5rem;
      margin-bottom: 4rem;
    }

    .blog-article__header {
      margin: 1.6rem auto 2rem;
      padding: 1.35rem 1rem 0;
      border-radius: 1rem;
    }

    .blog-article h1 {
      font-size: clamp(2.25rem, 10vw, 3.5rem);
    }

    .blog-article__dek {
      font-size: 1rem;
      line-height: 1.55;
    }

    .blog-article__byline {
      gap: 0.55rem;
    }

    .blog-article__author-copy small {
      font-size: 0.68rem;
    }

    .blog-article__byline time {
      max-width: 84px;
      text-align: right;
      line-height: 1.3;
    }

    .blog-article__cover-wrap {
      margin-top: 1rem;
    }

    .blog-article__cover {
      min-height: 240px;
      aspect-ratio: 4 / 3;
      object-position: 58% center;
    }

    .blog-article__cover-wrap figcaption {
      right: 0.45rem;
      bottom: 0.45rem;
      font-size: 0.62rem;
    }

    .blog-article__content {
      font-size: 1rem;
      line-height: 1.75;
    }

    .blog-article__content :global(blockquote) {
      margin: 1.8rem 0;
      padding: 1.15rem 1rem;
      font-size: 1.2rem;
    }

    .blog-article__content :global(.editorial-product-figure) {
      margin: 1.8rem 0;
      padding: 0.65rem;
    }

    .blog-article__content :global(.editorial-product-figure__images) {
      gap: 0.4rem;
    }

    .blog-article__content :global(.editorial-product-figure img) {
      max-height: 360px;
    }

    .blog-article__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.2rem;
      margin-top: 3rem;
      padding: 1.4rem 1.2rem;
    }

    .blog-article__cta {
      justify-content: center;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-article__cta {
      transition: none;
    }
  }
</style>
