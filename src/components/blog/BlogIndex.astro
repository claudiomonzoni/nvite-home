---
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  language: "es" | "en";
  languageUrls: { es: string; en: string };
  alternates: Array<{ lang: string; href: string }>;
}

const { posts, language, languageUrls, alternates } = Astro.props;
const isEnglish = language === "en";
const hasPosts = posts.length > 0;
---

<Layout
  title={isEnglish ? "Guides & Ideas for Your Beach Wedding | Nvitaciones" : "Guías e ideas para tu boda en la playa | Nvitaciones"}
  description={isEnglish ? "Helpful ideas for planning a beach wedding in Mexico, sharing travel details with guests, and keeping every celebration organized." : "Ideas útiles para organizar una boda en la playa, compartir los detalles con tus invitados y disfrutar cada celebración con menos pendientes."}
  noIndex={!hasPosts}
  alternates={hasPosts ? alternates : []}
>
  <Nav languageUrls={languageUrls} />
  <main class="grid contenido blog-index">
    <nav class="blog-breadcrumbs" aria-label={isEnglish ? "Breadcrumb" : "Migas de pan"}>
      <a href="/">{isEnglish ? "Home" : "Inicio"}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{isEnglish ? "Guides & Ideas" : "Guías e ideas"}</span>
    </nav>

    <header class="blog-index__intro">
      <div class="blog-index__intro-main">
        <h1>{isEnglish ? "Guides" : "Guías"} <em>{isEnglish ? "& ideas" : "e ideas"}</em></h1>
        <p>{isEnglish ? "Thoughtful advice and inspiration for planning your celebration and sharing every detail your guests need." : "Consejos claros e inspiración para planear tu celebración y cuidar cada detalle que compartirás con tus invitados."}</p>
      </div>
    </header>

    {hasPosts ? (
      <section class="blog-grid" aria-label={isEnglish ? "Guides and articles" : "Guías y artículos"}>
        {posts.map((post: CollectionEntry<"blog">, index: number) => (
          <article class:list={["blog-card", { "blog-card--featured": index === 0 }]}>
            <a class="blog-card__link" href={`${isEnglish ? "/en/blog" : "/blog"}/${post.data.slug || post.id}`}>
              <div class="blog-card__media">
                {post.data.coverImage ? (
                  <img
                    class="blog-card__image"
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt || ""}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="blog-card__image blog-card__image--fallback" aria-hidden="true"></div>
                )}
              </div>
              <div class="blog-card__body">
                <div class="blog-card__meta">
                  <span class="blog-card__category">{post.data.category}</span>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {post.data.publishedAt.toLocaleDateString(isEnglish ? "en-US" : "es-MX", { month: "long", year: "numeric" })}
                  </time>
                </div>
                <h2>{post.data.title}</h2>
                <p class="blog-card__description">{post.data.description}</p>
                <span class="blog-card__read">{isEnglish ? "Read the guide" : "Leer la guía"}</span>
              </div>
            </a>
          </article>
        ))}
        <aside class="blog-editorial-quote">
          <span class="blog-editorial-quote__mark" aria-hidden="true">“</span>
          <blockquote>{isEnglish ? "The best memories begin long before the big day: with an idea, a plan, and a reason to celebrate." : "Los mejores recuerdos empiezan mucho antes del gran día: con una idea, un plan y ganas de celebrar."}</blockquote>
          <p>{isEnglish ? "A note from our editorial team" : "Una nota del equipo editorial"}</p>
        </aside>
      </section>
    ) : (
      <p class="blog-empty">{isEnglish ? "We are preparing practical guides for couples and their guests." : "Estamos preparando guías prácticas para las parejas y sus invitados."}</p>
    )}
  </main>
  <Footer />
</Layout>

<style lang="scss">
  @use "../../estilos/_variables.scss" as *;

  .blog-index {
    width: 100%;
    margin: 2rem auto 7rem;
    color: $gris;
  }

  .blog-breadcrumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    color: $primario;
    font-size: 0.82rem;
  }

  .blog-breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .blog-breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .blog-index__intro {
    display: grid;
    //min-height: clamp(22rem, 55vh, 34rem);
    place-items: center;
    margin: 1.6rem 0 2rem;
    padding: clamp(2rem, 4vw, 3rem) 1rem;
  }

  .blog-index__intro-main {
    display: flex;
    max-width: 860px;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin: 0 auto;
    text-align: center;
  }

  .blog-index__intro h1 {
    margin: 0;
    color: $primario;
    font-size: clamp(3.4rem, 8vw, 6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .blog-index__intro h1 em {
    color: inherit;
    font-style: normal;
  }

  .blog-index__intro-main > p {
    max-width: 440px;
    margin: 0;
    color: $primario;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.65;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }

  .blog-card {
    position: relative;
    grid-column: span 5;
    min-width: 0;
    border-radius: 1rem;
    background: $fondoGlobal;
    box-shadow: 0 0.35rem 1.2rem rgba($primario, 0.08);
  }

  .blog-card__link:focus-visible {
    outline: 3px solid $primario;
    outline-offset: -3px;
    border-radius: 1rem;
  }

  .blog-card--featured {
    grid-column: span 7;
  }

  .blog-card__media {
    display: block;
    overflow: hidden;
    border-radius: 1rem 1rem 0 0;
  }

  .blog-card__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    color: $gris;
    text-decoration: none;
  }

  .blog-card__image {
    display: block;
    width: 100%;
    flex: 0 0 auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .blog-card--featured .blog-card__image {
    aspect-ratio: 1.9 / 1;
  }

  .blog-card:hover .blog-card__image {
    transform: scale(1.035);
  }

  .blog-card__image--fallback {
    min-height: 0;
    background: $terciario;
  }

  .blog-card__body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.2rem 1.35rem 1.3rem;
    background: $fondoGlobal;
  }

  .blog-card--featured .blog-card__body {
    padding: 1.35rem 1.5rem 1.2rem;
  }

  .blog-card__meta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    color: $primario;
    font-size: 0.75rem;
  }

  .blog-card__category {
    margin: 0;
    color: $primario;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .blog-card h2 {
    margin: 0 0 0.55rem;
    color: $primario;
    font-size: clamp(1.25rem, 2vw, 1.7rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .blog-card--featured h2 {
    max-width: 700px;
    font-size: clamp(1.6rem, 2.8vw, 2.55rem);
  }

  .blog-card__description {
    margin: 0;
    color: $gris;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .blog-card__read {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
    color: $primario;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .blog-editorial-quote {
    position: relative;
    display: flex;
    grid-column: span 5;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 2.7rem);
    border-radius: 1rem;
    background: $primario;
    color: $fondoGlobal;
  }

  .blog-editorial-quote__mark {
    position: absolute;
    top: 1rem;
    left:1rem;
    //height: 3.4rem;
    color: $secundario;
    font-family: Georgia, serif;
    font-size: clamp(6rem, 13vw, 26vw);
    line-height: 1;
  }

  .blog-editorial-quote blockquote {
    position: relative;
    z-index: 1;
   // max-width: 420px;
    font-family: var(--font-hurme), sans-serif;
    font-size: clamp(1.5rem, 2.3vw, 2.15rem);
    line-height: 1.25;
  }

  .blog-editorial-quote p {
    position: relative;
    z-index: 1;
    margin: 1rem 0 0;
    color: $fondoGlobal;
    font-size: 0.8rem;
  }

  .blog-empty {
    max-width: 620px;
    margin: 0 auto 5rem;
    color: $gris;
    line-height: 1.7;
    text-align: center;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .blog-card,
    .blog-card--featured,
    .blog-editorial-quote {
      grid-column: span 1;
      min-height: 0;
    }

    .blog-card--featured {
      grid-column: 1 / -1;
      min-height: 0;
    }

    .blog-editorial-quote {
      min-height: 280px;
    }
  }

  @media (max-width: 600px) {
    .blog-index {
      margin-top: 1.2rem;
      margin-bottom: 4rem;
    }

    .blog-index__intro {
      min-height: 21rem;
      margin: 0.5rem 0 1.3rem;
      padding: 2rem 0.25rem;
    }

    .blog-index__intro h1 {
      font-size: clamp(3.5rem, 18vw, 5.4rem);
    }

    .blog-index__intro-main > p {
      max-width: 33rem;
      font-size: 0.98rem;
    }

    .blog-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }

    .blog-card,
    .blog-card--featured {
      grid-column: 1;
      min-height: 0;
    }

    .blog-card__body,
    .blog-card--featured .blog-card__body {
      padding: 1rem 1rem 1.1rem;
    }

    .blog-card h2,
    .blog-card--featured h2 {
      font-size: 1.35rem;
    }

    .blog-editorial-quote {
      grid-column: 1;
      min-height: 240px;
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card__image,
    .blog-card__read {
      transition: none;
    }
  }
</style>
