---
const { dondeEstoy } = Astro.props;
import { Icon } from "astro-icon/components";
import Btn from "./Btn.astro";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
const isEn = lang === "en";
---

<div class="banner azulBG">
  <div class="der">
    <div id="titulo">
      <h2>{isEn ? "Simple, transparent pricing" : "Simple, precios transparentes"}</h2>
      <p>{isEn ? "Unlimited sends, zero surprises" : "Envios ilimitados, sin sorpresas"}</p>
    </div>
    <div class="bande">
      <article class="lista destacada">
        <div class="bandeDestacada">
          <small>{isEn ? "Weddings & Celebrations" : "Bodas & 15 Años"}</small>
          <h2>
            {isEn ? "Classic Invitation" : "Nvitación Clásica"}
          </h2>
          <ul>
            <h4>{isEn ? "Personalization" : "Personalización"}</h4>
            <li>{isEn ? "Guest name" : "Nombre del invitado"}</li>
            <li>{isEn ? "Assign passes" : "Asigna Pases"}</li>
            <li>{isEn ? "Personal notes" : "Mensajes personales"}</li>
            <h4>{isEn ? "Atmosphere" : "Ambientación"}</h4>
            <li>{isEn ? "Your song" : "Tu canción"}</li>
            <li>{isEn ? "Image gallery" : "Galería de imágenes"}</li>
            <li>{isEn ? "Animated quote" : "Frase animada"}</li>
            <h4>{isEn ? "Event Information" : "Información del Evento"}</h4>
            <li>{isEn ? "Dress Code" : "Dress Code"}</li>
            <li>{isEn ? "Location maps" : "Mapas de ubicación"}</li>
            <li>{isEn ? "Countdown" : "Cuenta regresiva"}</li>
            <h4>{isEn ? "RSVP & Management" : "Confirmación y Control"}</h4>
            <li>{isEn ? "Gift registry" : "Sugerencia de regalos"}</li>
            <li>{isEn ? "Lodging suggestions" : "Sugerencia de hospedaje"}</li>
            <li>{isEn ? "Confirmation form" : "Formulario de confirmación"}</li>
            <li>{isEn ? "Guest dashboard" : "Panel de invitados"}</li>
          </ul>
          <div class="precio">
            <span>{isEn ? "$79" : "$1290"}<sup>{isEn ? "USD" : "MXN"}</sup></span>
            <small><b>{isEn ? "One-time payment / From $0.79 USD" : "Pago unico / Desde 13 pesos"}</b> {isEn ? "per guest and gets cheaper with more guests" : "por invitado y baja entre más invitados tengas"}</small>
          </div>
 
        </div>
      </article>

      <article class="lista">
        <small>{isEn ? "Weddings & Celebrations" : "Bodas & 15 Años"}</small>
        <h2>{isEn ? "Lux Invitation" : "Nvitación Lux"}</h2>

        <ul id="lux">
          <h3>{isEn ? "Everything in Classic, plus:" : "Todo lo que incluye la Clásica, más:"}</h3>

          <li class="resalta">
            <h4>
              <Icon name="mdi:table" size={25} /> {isEn ? "Table seating manager" : "Gestor de mesas"}
            </h4>
            <p>
              {isEn ? "Organize your guests and assign tables easily; then export everything to Excel to share with your team." : "Organiza a tus invitados y asigna sus mesas fácilmente; luego, exporta todo en Excel para compartirlo con tu equipo.."}
            </p>
          </li>
          <li class="resalta">
            <h4>
              <Icon name="mdi:account-balance-wallet-outline" size={25} /> {isEn ? "Vendor Management" : "Gestión de Proveedores"}
            </h4>
            <p>
              {isEn ? "Centralize vendor details, organize pending to-dos, and keep your budget under control." : "Centraliza sus datos, organiza tus tareas pendientes y mantén tus pagos bajo control."}
            </p>
          </li>

          <li class="resalta">
            <h4><Icon name="mdi:calendar" size={25} /> {isEn ? "Itinerary" : "Itinerario"}</h4>
            <p>
              {isEn ? "Let guests know what's next and enjoy every moment of your celebration." : "Haz que tus invitados sepan qué sigue y disfruten cada momento de tu celebración."}
            </p>
          </li>

          <li class="resalta">
            <h4>
              <Icon name="mdi:account-multiple-check-outline" size={25} /> {isEn ? "Confirmation progress" : "Porcentaje de confirmados"}
            </h4>
            <p>
              {isEn ? "Show guests how many have already RSVP'd to encourage quick confirmations!" : "Muestra a tus invitados cuántos ya confirmaron y dales ese último empujón para decir: ¡Sí, ahí estaremos!"}
            </p>
          </li>

          <li class="resalta">
            <h4><Icon name="mdi:qrcode" size={25} /> {isEn ? "Entrance QR Pass" : "QR de entrada"}</h4>
            <p>
              {isEn ? "Upon confirmation, guests receive a QR pass with assigned seats for smooth entrance." : "Al confirmar, tus invitados reciben un código QR en su invitación con pases y mesa asignada, asegurando un acceso rápido y ordenado."}
            </p>
          </li>
        </ul>
        <div class="precio">
          <span>{isEn ? "$99" : "$1688"}<sup>{isEn ? "USD" : "MXN"}</sup> </span>
          <small><b>{isEn ? "One-time payment / From $0.99 USD" : "Pago unico / Desde 17 pesos"} </b>{isEn ? "per guest and gets cheaper with more guests" : "por invitado y baja entre más invitados tengas"}</small>
        </div>
      </article>
   
    </div>
  </div>
</div>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;
  #titulo {
    text-align: center;
    margin-top: $margen;
    flex: 1 0 100%;
    h2 {
      font-weight: 600;
      color: $primario;
    }
    @include cel {
      margin-top: 0;
      text-align: left;
      padding-left: $margen-cel;
      padding-top: $margen-cel;
    }
  }
  h2 {
    color: $primario;
    font-weight: 600;
    font-size: clamp(2rem, 1.3vw, 2.2vw);
    position: relative;
  }
  h4{
        color: rgba($gris, .8);
        font-weight: 600;
  }
  .resalta {
    font-size: 1rem;
    list-style: none;
    margin-bottom: 1rem;

    h4 {
      font-weight: 600;
      display: flex;
      gap: .5rem;
      align-items: center;
      padding-bottom: .2rem;
    }
  }
  small {
    color: $gris;
  }
  b {
    color: $primario;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 0.9px;
  }
  .precio {
    display: flex;
    gap: 1rem;
    flex-direction: column;
    padding-bottom: 1rem;
    border-bottom: solid 1px $terciario;
    font-weight: bolder;
    color: $primario;
    font-size: clamp(1.5rem, 1.2vw, 1.5vw);
    small {
      color: $primario;
      font-weight: normal;
      font-size: 0.7rem;
    }
  }
  .banner {
    display: flex;
    flex-wrap: wrap;
  }
  .der,
  .izq {
    display: flex;
    justify-content: center;
    @include cel {
      flex: 1 0 100%;
    }
  }
  .der {
    flex-wrap: wrap;
    flex: 1 0 70%;
    @include tableta_land {
      flex: 1 0 80%;
    }
  }
  .izq {
    flex: 1 0 30%;
    width: 100px;
    align-items: center;
    @include tableta_land {
      flex: 1 0 20%;
    }
  }
  .bande {
    display: flex;
    margin: $margen-cel 0 $margen;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }
  .bandeDestacada {
    width: 80%;
    padding: $margen-min;
    @include cel {
      width: 100%;
    }
  }
  .lista {
    flex: 1;
    max-width: min(100%, 50ch);
    justify-content: center;
    align-self: center;
    padding: 2rem $margen-cel;
    @include hd {
      padding: 0 3rem;
    }
    li {
      font-size: 0.9rem;
    }
    li:nth-of-type(3n) {
      padding-bottom: 8px;
    }
    li:nth-of-type(12) {
      padding-bottom: 0!important;
    }
    a {
      justify-self: flex-start;
      svg {
        vertical-align: middle;
      }
    }

    @include cel {
      flex: 1 0 100%;
      border-right: none;

      position: relative;
      a {
        width: 100%;
      }
    }
    #lux {
      max-width: 90%;
    }
  }
  #lux {
    h3 {
      padding-bottom: $margen-min;
      //border: solid 1px rgba($primario, 0.4);
      background: rgba($secundario, 1);
      font-weight: 600;
      border-radius: $radio;
      text-align: center;
      padding: 10px $margen-min;
      margin-bottom: $margen-min;
      color: white;
      font-size: 0.9rem;
      @include cel {
        text-align: left;
      }
    }
    li {
      padding-bottom: 8px;
      p {
      }
    }
  }
  .destacada {
    display: flex;
    background: white;
    background: linear-gradient(
      0deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 1) 100%
    );
    border-radius: $radio;
    padding: 1rem;
    @extend .sombra;

    @include cel {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 1) 100%
      );
    }
  }
  #masvendido {
    border-bottom: solid 2px $primario;
    position: absolute;
    background: rgb(255, 255, 255, 0.4);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(3px);
    @extend .sombra;
    border-radius: $radio;
    color: $primario;
    font-size: clamp(0.8rem, 0.6vw, 1vw);
    padding: 0 0.5rem;
    transform: rotate(-5deg);
    right: 0;
    top: 35%;
  }
  .conteBtn {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    @include cel {
      gap: 0.2rem;
    }
  }
  .conteBtn > * {
    min-width: fit-content;
    text-align: center;
    flex: 1;
  }
  ul {
    padding: 1rem 0;
    li::marker {
      color: $secundario;
    }
  }
  @include cel {
    .izq,
    .der {
      flex: 1 0 100%;
    }
  }

  .azulBG {
    border-radius: $radio;
    background:
      url("/fondo-nvite-caracteristicas-banner.webp") no-repeat,
      linear-gradient(43deg, $fondoGlobal 30%, $terciario 100%) no-repeat;
    background-position:
      center left,
      top left;
    background-size: 50%, 100%;
    margin-bottom: $margen-min;
    @include cel {
      background:
        url("/fondo-nvite-caracteristicas-banner.webp") no-repeat,
        linear-gradient(0deg, $fondoGlobal 0%, $terciario 100%) no-repeat;
      background-position: center bottom;
      background-size: 120%;
    }
  }
  sup {
    font-size: 0.7rem;
  }
</style>
