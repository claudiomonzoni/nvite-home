---
interface Props {
  categoria: string;
  nombre: string;
}

const { categoria, nombre } = Astro.props;
const lang = Astro.locals.lang || "es";
const isEn = lang === "en";

// Mapeo seguro y bilingüe de categorías
function getCategoryInfo(cat: string, isEnglish: boolean) {
  const c = (cat || "").toLowerCase();
  if (c.includes("boda") || c.includes("wedding")) {
    return {
      ruta: "/bodas",
      nombre: isEnglish ? "Wedding Invitations" : "Invitaciones de Boda",
    };
  }
  if (c.includes("quince") || c.includes("xv")) {
    return {
      ruta: "/invitaciones-quince",
      nombre: isEnglish ? "Quinceañera Invitations" : "Invitaciones de XV Años",
    };
  }
  if (c.includes("pdf") || c.includes("cumple") || c.includes("birthday")) {
    return {
      ruta: "/invitaciones-pdf",
      nombre: isEnglish ? "PDF Invitations" : "Invitaciones PDF",
    };
  }
  return {
    ruta: "/bodas",
    nombre: isEnglish ? "Invitations" : "Invitaciones",
  };
}

const catInfo = getCategoryInfo(categoria, isEn);
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ul>
    <li><a href="/">{isEn ? "Home" : "Inicio"}</a></li>
    <li><a href={catInfo.ruta}>{catInfo.nombre}</a></li>
    <li><span aria-current="page">{nombre}</span></li>
  </ul>
</nav>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;
  .breadcrumb {
    padding: .4rem 0;
    margin-bottom: 1rem;
    font-size: .7rem;
    background-color: rgba($terciario, 0.4);
    border-radius: $radio;
    
  }
  
  .breadcrumb ul {
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  
  .breadcrumb li {
    list-style: none;
    display: flex;
  
  }

  .breadcrumb li:not(:last-child)::after {
    content: "\203A";
    font-size: 1rem;
    margin: 0 0.2rem;
    color: #ee6a6a;
  }

  .breadcrumb a {
    color: #ee6a6a;
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover {
    color: #0056b3;
  }

  .breadcrumb span {
    color: #6c757d;
  }
</style>
