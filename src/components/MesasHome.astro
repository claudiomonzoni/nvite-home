---
import { Image } from "astro:assets";
import mesaImg from "../assets/home/mesas-home.jpg";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);

// URLs de video según idioma (dejar listo para la versión en inglés)
const videoSrcEs = "https://res.cloudinary.com/dpnzqg5mx/video/upload/v1785879695/panel-pro.webmhd_r3hz0l.webm";
const videoSrcEn = "https://res.cloudinary.com/dpnzqg5mx/video/upload/v1785879695/panel-pro.webmhd_r3hz0l.webm"; // <- Reemplazar con la URL en inglés cuando esté lista
const videoSrc = lang === "en" ? videoSrcEn : videoSrcEs;
---

<div class="grid contenido">
  <div id="mesa-home">
    <div id="info">
      <div class="conte">
        <h2>
          <span>{t('landing.mesas.title')}</span>{t('landing.mesas.subtitle')}
        </h2>
        <p>
          {t('landing.mesas.desc')}
        </p>
        <div id="caracteristicas">
          <h3>{lang === 'en' ? 'Key Features' : 'Características clave'}</h3>
          <div id="conteGrid">
            <div class="item">
              <Icon name="mdi:ticket-confirmation-outline" size={24} />
              <h4>{t('landing.mesas.feat1.title')}</h4>
              <p>
                {t('landing.mesas.feat1.desc')}
              </p>
            </div>
            <div class="item">
              <Icon name="mdi:table" size={24} />
              <h4>{t('landing.mesas.feat2.title')}</h4>
              <p>
                {t('landing.mesas.feat2.desc')}
              </p>
            </div>
            <div class="item">
              <Icon name="mdi:account-balance-wallet-outline" size={24} />
              <h4>{t('landing.mesas.feat3.title')}</h4>
              <p>
                {t('landing.mesas.feat3.desc')}
              </p>
            </div>
            <div class="item">
              <Icon name="mdi:microsoft-excel" size={24} />
              <h4>{t('landing.mesas.feat4.title')}</h4>
              <p>
                {t('landing.mesas.feat4.desc')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="img">
      <div id="poster-container">
        <Image src={mesaImg} alt={lang === "en" ? "Guest seating and tables management" : "Gestión de mesas e invitados"} />
        <button
          id="play-btn"
          type="button"
          aria-label={lang === "en" ? "Play demo video" : "Reproducir video"}
        >
          <span class="play-icon" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</div>

<div id="video-modal" class="modal" aria-hidden="true">
  <div class="modal-overlay" data-close></div>
  <div
    class="modal-content"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <button class="modal-close" aria-label={lang === "en" ? "Close video" : "Cerrar video"} data-close>
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <div class="video-wrapper">
      <video id="modal-video" preload="none" playsinline controls>
        <source
          src={videoSrc}
          type="video/webm"
        />
      </video>
    </div>
  </div>
</div>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;
  h2 {
    font-weight: 600;
    color: $primario;
    position: relative;
    padding-bottom: $margen-cel;
    span {
      position: absolute;
      top: -2rem;
      left: 0;
      font-size: 1rem;
      font-weight: 200;
      color: $acento;
      font-weight: 200;
    }
  }
  #mesa-home {
    display: flex;
    margin: $margen 0;
 
    flex-wrap: wrap;
    @include cel {
      padding: 0;
      margin: $margen-cel 0;
    }
  }
  #info {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1 0 50%;
    padding: 2rem;
    box-sizing: border-box;
    border-top-left-radius: $radio;
    border-bottom-left-radius: $radio;
    background: rgba($terciario, 0.8);
    margin-right: -10px;
    .conte {
      max-width: min(100%, 50ch);
    }
    @include cel {
      padding: 3.3rem 2rem 2.5rem;
      margin-right: 0;
      margin-bottom: -10px;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
      border-top-right-radius: $radio;
      border-top-left-radius: $radio;
    }
  }
  #caracteristicas {
    margin-top: $margen-cel;
    h3 {
      font-size: 1.2rem;
      color: $secundario;
      margin-bottom: $margen-min;
    }
  }
  #conteGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    grid-gap: 2rem;
    .item {
      display: flex;
      flex-direction: column;
      font-size: 0.9rem;
      svg {
        color: rgba($primario, 0.8);
      }
      h4 {
        font-weight: 600;
        color: $primario;
      }
    }
  }
  #img {
    flex: 1 0 50%;
    border-radius: $radio;
    overflow: hidden;
  }
  #poster-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: $radio;
    overflow: hidden;
    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
  #play-btn {
    position: absolute;
    right: 1rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: #fff;
    color: $primario;
    cursor: pointer;
    z-index: 3;
    @extend .sombra2;
    transition: transform 180ms ease, background-color 180ms ease;

    &:focus-visible {
      outline: 2px solid $primario;
      outline-offset: 3px;
    }

    .play-icon {
      width: 0;
      height: 0;
      margin-left: 0.15rem;
      border-top: 0.4rem solid transparent;
      border-bottom: 0.4rem solid transparent;
      border-left: 0.6rem solid currentColor;
    }

    &:hover {
      transform: scale(1.08);
    }
  }
  :global(.modal) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2147483647 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    &.open {
      opacity: 1;
      visibility: visible;
    }
  }
  :global(.modal-overlay) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  :global(.modal-content) {
    position: relative;
    width: 90%;
    max-width: 960px;
    max-height: 90vh;
    border-radius: $radio;
    overflow: hidden;
    background: #000;
    animation: modalIn 0.3s ease forwards;
    z-index: 1;
  }
  @keyframes modalIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  :global(.modal-close) {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    cursor: pointer;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.2s ease;
    svg {
      width: 20px;
      height: 20px;
    }
    &:hover {
      background: rgba(255, 255, 255, 0.25);
      transform: rotate(90deg);
    }
  }
  :global(.video-wrapper) {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 10;
    video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
    }
  }
  @include cel {
    #poster-container {
      min-height: 300px;
    }
    :global(.modal-content) {
      width: 95%;
    }
    :global(.modal-close) {
      top: 8px;
      right: 8px;
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  class VideoModal {
    listenersAdded = false;
    constructor() {
      document.addEventListener('astro:page-load', () => this.init());
      if (document.readyState === 'complete') {
        this.init();
      }
    }

    init() {
      const modal = document.getElementById("video-modal") as HTMLElement | null;
      const video = document.getElementById(
        "modal-video",
      ) as HTMLVideoElement | null;
      const playBtn = document.getElementById("play-btn") as HTMLElement | null;
      const closeTriggers = document.querySelectorAll(
        "[data-close]",
      ) as NodeListOf<HTMLElement>;

      if (!modal || !video || !playBtn) return;

      if (!modal.dataset.portalized) {
        document.body.appendChild(modal);
        modal.dataset.portalized = "true";
      }

      const openModal = () => {
        modal.classList.add("open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch((error: unknown) => {
            console.error("Error al reproducir el video:", error);
          });
        }
      };

      const closeModal = () => {
        modal.classList.remove("open");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";

        video.pause();
        video.currentTime = 0;
      };

      if (!this.listenersAdded) {
        playBtn.addEventListener("click", openModal);

        closeTriggers.forEach((trigger) => {
          trigger.addEventListener("click", closeModal);
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && modal.classList.contains("open")) {
            closeModal();
          }
        });

        this.listenersAdded = true;
      }
    }
  }

  new VideoModal();
  document.addEventListener('astro:after-swap', () => {
    new VideoModal();
  });
</script>
