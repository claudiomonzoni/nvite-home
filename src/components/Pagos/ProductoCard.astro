---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getProductPrice } from "../../js/cart";
import Btn from "../Btn.astro";
import nvitacionesData from "../../pages/nvitaciones/nvitaciones.json";

type Props = {
  producto: CollectionEntry<"productos">;
};

const { producto } = Astro.props;
const lang = Astro.locals.lang || "es";
const nvitacionInfo = nvitacionesData.find(
  (item) => item.id === producto.data.id,
);

const precio = await getProductPrice(producto, lang);
const isUsd = precio.includes("USD") || precio.includes("$") && lang === "en";

// Calcular precio tachado igual que en [id].astro
let precioTachado = precio;
if (nvitacionInfo?.precioTachado) {
  const match = precio.match(/^([^\d]+)([\d,.]+)/);
  if (match) {
    const currency = match[1];
    const priceNumber = Number(match[2].replace(/,/g, ""));
    const priceTachadoNumber = Math.round(priceNumber * 1.4);
    const priceTachadoStr = priceTachadoNumber.toLocaleString(lang === "en" ? "en-US" : "es-MX", {
      minimumFractionDigits: 0,
    });
    precioTachado = `${currency}${priceTachadoStr}`;
  }
}

// Extraer el número del precio para el Schema
const priceNumberOnly = precio.replace(/[^\d.]/g, "");

// Calcular precio por invitado dinámicamente
const numericPrice = Number(precio.replace(/,/g, "").replace(/[^\d.]/g, ""));
const costPerGuest = lang === "en" ? (numericPrice / 100).toFixed(2) : Math.round(numericPrice / 100);

function localizeCategory(cat?: string, l: string = "es") {
  if (!cat) return l === "en" ? "Invitations" : "Sin categoría";
  if (l !== "en") return cat;
  const lower = cat.toLowerCase();
  if (lower.includes("boda")) return "Weddings";
  if (lower.includes("xv") || lower.includes("quince")) return "Quinceañera";
  if (lower.includes("cumple")) return "Birthdays";
  if (lower.includes("bautizo")) return "Baptism";
  if (lower.includes("baby")) return "Baby Shower";
  return cat;
}

function localizeVersion(ver?: string, l: string = "es") {
  if (!ver) return l === "en" ? "Standard" : "Sin versión";
  if (l !== "en") return ver;
  const lower = ver.toLowerCase();
  if (lower.includes("clas")) return "Classic";
  if (lower.includes("esenc")) return "Essential";
  if (lower.includes("lux")) return "Lux";
  return ver;
}

function localizeProductName(name: string, l: string = "es") {
  if (l !== "en") return name;
  return name
    .replace(/Invitaci[oó]n de Bodas?/gi, "Wedding Invitation")
    .replace(/Invitaci[oó]n de XV A[ñn]os?/gi, "Quinceañera Invitation")
    .replace(/Invitaci[oó]n de Quincea[ñn]era/gi, "Quinceañera Invitation")
    .replace(/Invitaci[oó]n/gi, "Invitation")
    .replace(/Cl[aá]sica/gi, "Classic")
    .replace(/Esencial/gi, "Essential");
}

function getLocalizedText(
  field?: any,
  l: string = "es",
  fallback: string = ""
): string {
  if (!field) return fallback;
  if (typeof field === "string") return field;
  return (l === "en" ? field.en : field.es) || field.es || field.en || fallback;
}

const displayedCategory = localizeCategory(producto.data.metadata?.Categoria, lang);
const displayedVersion = localizeVersion(producto.data.metadata?.Version || producto.data.metadata?.version || nvitacionInfo?.version, lang);
const customName = getLocalizedText(nvitacionInfo?.nombre || (nvitacionInfo as any)?.titulo, lang);
const displayedName = customName || localizeProductName(producto.data.name, lang);

const schemaProduct = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: displayedName,
  image: producto.data.images[0],
  description:
    producto.data.description || `Invitación digital ${producto.data.name}`,
  sku: producto.data.id,
  brand: {
    "@type": "Brand",
    name: "Nvitaciones",
  },
  offers: {
    "@type": "Offer",
    url: `https://nvitaciones.com/nvitaciones/${nvitacionInfo?.slug || producto.data.id}`,
    priceCurrency: lang === "en" ? "USD" : "MXN",
    price: priceNumberOnly,
    priceValidUntil: "2027-12-31",
    availability: "https://schema.org/InStock",
    seller: {
      "@type": "Organization",
      name: "Nvitaciones",
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaProduct)} />

<article class="producto-card">
  <div class="portada">
    <a href={`/nvitaciones/${nvitacionInfo?.slug || producto.data.id}`}>
      <!-- <div class="verNvitacion">Ver Nvitación</div> -->
      <div class="badge-invitado">
        {lang === 'en' ? `From $${costPerGuest} USD` : `Desde $${costPerGuest} MXN`}<br />
        <small>{lang === 'en' ? 'per guest · lower cost with more invites' : 'por invitado y baja entre más invites.'}</small>
      </div>
      <div class="crop">
        <Image
          src={producto.data.images[0]}
          alt={displayedName}
          height={320}
          width={320}
        />
      </div>
    </a>
  </div>
  <div class="info">
    <span>
      <b>{displayedCategory}</b> | {displayedVersion}
    </span>
    <div class="headinfo">
      <h2>{displayedName}</h2>
    </div>
    <!-- línea de ancla emocional -->
    <p class="price-anchor">
      ≈ ${costPerGuest} {lang === 'en' ? 'per guest · Unlimited sends' : 'por invitado · Envíos ilimitados'}
    </p>
  </div>
  <div class="conteBtn">
    <Btn
    liga={`/nvitaciones/${nvitacionInfo?.slug || producto.data.id}`}
    texto={lang === 'en' ? 'View demo →' : 'Ver mi ejemplo →'}
    clases="btn-bordes"
    claro={false}
    />
  </div>
</article>

<style lang="scss">
  @use "../../estilos/_variables.scss" as *;
  .producto-card {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto;
    gap: 0.5rem;
    border-radius: $radio;
    // box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.1);
    // background-color: white;
    height: 100%;
    max-width: 550px;
  }

  .portada {
    grid-column: 1 / -1;
    grid-row: 1;
    background: linear-gradient(
      to bottom,
      rgba($terciario, 0.3) 0%,
      rgba($terciario, 0.6) 50%,
      rgba($terciario, 1) 100%
    );
    // border-top-left-radius: $radio;
    // border-top-right-radius: $radio;
    border-radius: calc($radio * 2);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    position: relative;
    // height: calc(100% + 74px);
    // top: -74px;

    a {
      display: flex;
      justify-content: center;
      width: 100%;
      transform-origin: bottom;
    }
    .crop {
      position: relative;
      width: 100%;
      height: 70%;
      aspect-ratio: 1/1;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }
    img {
      object-fit: cover;
      width: 60%;
      height: auto;
    }
    .badge-invitado {
      position: absolute;
      z-index: 100;
      top: 80%;
      right: -5%;
      background: rgba($primario, 0.8);
      padding: 0.5rem $margen-min;
      color:#fff;
      font-size: 0.7rem;
      border-radius: $radio;
      backdrop-filter: blur(5px);
      line-height: 1rem;
      z-index: 100;
      small{
        font-size: .5rem;
      }
   
      @extend .sombra;
    }
  }

  .info {
    padding: 0 $margen-min;
  }
  .info span {
    font-size: clamp(0.7rem, calc(1.1vw + 0.5rem), 0.8rem);
    color: $acento;
    text-transform: capitalize;
    margin-bottom: $margen-cel;
    font-weight: 300;
  }
  .headinfo {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: $margen-min;
    border-bottom: solid 1px rgba($gris, 0.4);
    padding-bottom: $margen-min;
   flex-wrap: wrap;
    // margin-bottom: $margen-min;
  }

  .precio,
  .precioTachado {
    font-size: clamp(1rem, 1.1vw, 1.2rem);
    font-weight: bold;
    color: $primario;

    sup {
      font-size: 0.4em;
      font-weight: normal;
      color: $gris;
    }
  }

  .precioTachado {
    font-size: 0.7rem;
    font-weight: bold !important;
    color: $acento;
    text-decoration: line-through;
    padding-right: $margen-min;
  }

  .price-anchor {
    font-size: 12px;
    color: #888;
    margin-top: 6px;
    margin-bottom: 4px;
    font-style: normal;
    letter-spacing: 0.01em;
    @include cel{
      text-align: center;
      
    }
  }

  .price-note {
    font-size: 11px;
    color: #aaa;
    text-align: center;
    margin-top: -2px;
    margin-bottom: 8px;
  }

  h2 {
    font-size: clamp(1.5rem, 1.1vw, 1.6rem);
    margin-top:4px;
    padding: 0;
    color: $primario;
    flex: 1 0 100%;
  }
  .conteBtn {
   padding: 0 $margen-min;
   @include cel{
    text-align: center;
    margin-top: -20px;
   }
  }
  .categoria {
    text-transform: capitalize;
    color: $gris;
    font-size: 0.7rem;
    font-weight: lighter;
  }
</style>

<script>
  function initializeBuyNowButtons() {
    const buyNowButtons = document.querySelectorAll('[data-action="buy-now"]');

    buyNowButtons.forEach((button) => {
      button.addEventListener("click", handleBuyNow);
    });
  }

  async function handleBuyNow(event: Event) {
    event.preventDefault();
    const button = event.currentTarget as HTMLElement;
    const productId = button.getAttribute("data-productid");

    if (!productId) return;

    // Obtener los items actuales del carrito
    const cartItems = getCartItemsFromCookie();

    // Verificar si el producto ya existe en el carrito
    if (!cartItems.includes(productId)) {
      // Solo agregar si no existe
      cartItems.push(productId);

      // Guardar el carrito actualizado
      document.cookie = `cartItems=${JSON.stringify(cartItems)};path=/;max-age=31536000`;

      // Disparar evento de actualización del carrito
      document.dispatchEvent(new CustomEvent("cart:updated"));
    }

    // Redirigir al checkout
    window.location.href = "/nvitaciones/checkout";
  }

  function getCartItemsFromCookie() {
    const cookie = document.cookie
      .split(";")
      .find((c) => c.trim().startsWith("cartItems="))
      ?.split("=")[1];

    return cookie ? JSON.parse(cookie) : [];
  }

  // Inicializar en la carga inicial
  initializeBuyNowButtons();

  // Reinicializar después de la navegación
  document.addEventListener("astro:page-load", initializeBuyNowButtons);
</script>
