---
import { catalog, previewUrl, designLabel, type Design } from "../lib/catalog";
interface Props {
  selected: (typeof catalog)[number];
  packages: {
    packageId: string;
    slug: string;
    label: string;
    price: string | null;
  }[];
  lang: string;
  requestedDesign: string;
}
const { selected, packages, lang, requestedDesign } = Astro.props;
const en = lang === "en";
const designs = catalog.filter(
  (item) =>
    item.event === "bodas" &&
    item.packageId === selected.packageId &&
    item.languages.includes(lang),
);
const label = (design: Design) => designLabel(design, lang);
const packageUrl = (slug: string) => {
  const url = new URL(Astro.url);
  url.pathname = `/nvitaciones/${slug}`;
  url.searchParams.set("tema", requestedDesign);
  return url.pathname + url.search;
};
const splitPrice = (price: string) => {
  const match = price.match(/^(.*?)([.,]\d{2})$/);
  return match
    ? { amount: match[1], decimals: match[2] }
    : { amount: price, decimals: "" };
};
const copy = en
  ? {
      loading: "Loading invitation…",
      ready: "Interactive preview",
      error:
        "The preview could not be loaded. Retry or open the full invitation.",
      invalid:
        "This design is unavailable in this package. Select an available design to continue.",
    }
  : {
      loading: "Cargando invitación…",
      ready: "Vista previa interactiva",
      error:
        "No pudimos cargar la muestra. Reintenta o abre la invitación completa.",
      invalid:
        "Este diseño no está disponible en este paquete. Elige un diseño disponible para continuar.",
    };
---

<section
  class="selector"
  id="wedding-selector"
  data-package={selected.version}
  data-design={selected.design}
  data-requested={requestedDesign}
  data-initial={selected.design}
  data-en={String(en)}
  data-copy={JSON.stringify(copy)}
>
  <h2>{en ? "Choose your package" : "Elige tu paquete"}</h2>
  <nav
    class="packages"
    aria-label={en ? "Invitation package" : "Paquete de invitación"}
  >
    {
      packages.map((item) => {
        const price = item.price ? splitPrice(item.price) : null;
        return (
          <a
            href={packageUrl(item.slug)}
            aria-current={
              item.packageId === selected.packageId ? "page" : undefined
            }
          >
            <>
              <strong>{item.label}</strong>
              <span>
                {price ? (
                  <>
                    {price.amount}
                    {price.decimals && <sup>{price.decimals}</sup>}
                  </>
                ) : (
                  en ? "Unavailable" : "No disponible"
                )}
              </span>
            </>
            <small>
              {item.packageId === "lux"
                ? en
                  ? "RSVP, QR passes and timeline"
                  : "Confirmación, pases QR e itinerario"
                : en
                  ? "Music, gallery and RSVP"
                  : "Música, galería y confirmación"}
            </small>
          </a>
        );
      })
    }
  </nav>
  <h2>{en ? "Choose your design" : "Elige tu diseño"}</h2>
  <div
    class="designs"
    role="group"
    aria-label={en ? "Invitation design" : "Diseño de invitación"}
  >
    {
      designs.map((item) => (
        <button
          type="button"
          data-theme={item.design}
          data-url={previewUrl(item, lang)}
          data-label={label(item.design)}
          aria-pressed={
            item.design === selected.design &&
            requestedDesign === selected.design
              ? "true"
              : "false"
          }
        >
          <span>{label(item.design)}</span>
        </button>
      ))
    }
  </div>
  <p
    class="notice"
    data-notice
    role="status"
    hidden={requestedDesign === selected.design}
  >
    {copy.invalid}
  </p>
  <div class="preview-heading">
    <p data-preview-status role="status">{copy.loading}</p>
  </div>
  <div class="phone-preview">
    <div class="phone-screen">
      <iframe
        src={previewUrl(selected, lang)}
        title={en
          ? "Wedding invitation preview"
          : "Muestra de invitación de bodas"}
        data-demo
        loading="lazy"
        allow="autoplay"
        referrerpolicy="same-origin"></iframe>
    </div>
    <img
      class="phone-frame"
      src="/marco-cel.webp"
      width="914"
      height="1866"
      alt=""
      aria-hidden="true"
      draggable="false"
    />
  </div>
  <p class="preview-heading">
    <a
      data-full-preview
      href={previewUrl(selected, lang)}
      target="_blank"
      rel="noopener noreferrer"
    >
      {en ? "Open full invitation" : "Abrir muestra completa"}
    </a>
  </p>
  <button type="button" class="retry" data-retry hidden
    >{en ? "Retry preview" : "Reintentar muestra"}</button
  >
  <noscript
    ><p>
      {
        en
          ? "Enable JavaScript to change designs. You can open the full invitation using the link above."
          : "Activa JavaScript para cambiar de diseño. Puedes abrir la muestra completa con el enlace anterior."
      }
    </p></noscript
  >
</section>

<style lang="scss">
  @use "../estilos/variables" as *;
  .selector {
    color: #211831;
    width: 100%;
  }
  h2 {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.6rem;
    color: $primario;
    font-weight: 700;
  }
  h2:first-child {
    margin-top: 0;
  }
  .packages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .packages a {
    @extend .sombra;
    display: flex;
    flex-wrap:wrap;
    //flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem;
    border: 0;
    border-radius: 12px;
    background: white;
    color: inherit;
    text-decoration: none;
  }
  .packages a[aria-current] {
    display: flex;
    background: #f0eaf5;
    color: $gris;
  }
  .packages strong {
    flex: 1 auto 50%;
    color: $gris;
    font-size: .8rem;
    font-weight: 700;
  }
  .packages span {
    color: $primario;
    flex: 1 auto 50%;
    text-align: right;
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .packages span sup {
    font-size: 0.65em;
    line-height: 0;
    vertical-align: super;
  }
  .packages small {
    flex: 1 auto 100%;
    line-height: 1.5;
    font-size: 0.8rem;
  }

  .designs {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  .designs button {
    @extend .sombra;
    flex: 1;
    min-height: 30px;
    padding: 0.6rem 1rem;
    background: $fondoGlobal;
    border: 0;
    border-radius: 12px;
    cursor: pointer;
    text-align: center;
  }
  .designs button[aria-pressed="true"] {
    background: #f0eaf5;
    color: $primario;
    font-weight: 700;
  }
  .designs span {
    font-size: clamp(0.9rem, 0.8rem, 1rem);
  }
  a:hover,
  button:hover {
    background: #f0eaf5;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #4e3166;
    outline-offset: 3px;
  }
  .preview-heading {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.2rem 0 0.6rem;
    font-size: 0.8rem;
  }
  .preview-heading p {
    margin: 0;
  }
  .preview-heading a {
    color: $gris;
    text-underline-offset: 3px;
  }
  .phone-preview {
    position: relative;
    width: min(100%, 390px, calc(75svh * 914 / 1866));
    aspect-ratio: 914 / 1866;
    margin: auto;
  }
  .phone-screen {
    position: absolute;
    inset: 1.3% 5.8% 1.3% 5.9%;
    overflow: hidden;
    border-radius: 11% / 5.5%;
    background: white;
  }
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: white;
  }
  .phone-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }
  .notice {
    color: #6d2424;
    background: #fff1ee;
    padding: 0.7rem;
    line-height: 1.5;
  }
  .retry {
    @extend .sombra;
    margin: 0.7rem 0;
    min-height: 44px;
    padding: 0.7rem 1rem;
    cursor: pointer;
    border: 0;
    border-radius: 8px;
    background: white;
    color: #4e3166;
  }
  [hidden] {
    display: none;
  }
</style>

<script>
  function initializeWeddingSelector() {
    const root = document.getElementById("wedding-selector");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const frame = root.querySelector<HTMLIFrameElement>("[data-demo]")!;
    const status = root.querySelector<HTMLElement>("[data-preview-status]")!;
    const retry = root.querySelector<HTMLButtonElement>("[data-retry]")!;
    const full = root.querySelector<HTMLAnchorElement>("[data-full-preview]")!;
    const notice = root.querySelector<HTMLElement>("[data-notice]")!;
    const buttons = [
      ...root.querySelectorAll<HTMLButtonElement>("[data-theme]"),
    ];
    const copy = JSON.parse(root.dataset.copy!);
    const en = root.dataset.en === "true";
    let timer: ReturnType<typeof setTimeout>;
    const updatePurchase = (design: string, valid: boolean) => {
      document
        .querySelectorAll<HTMLElement>('[data-action="buy-now"]')
        .forEach((button) => {
          button.dataset.design = design;
          button.setAttribute("aria-disabled", String(!valid));
          const name =
            buttons.find((option) => option.dataset.theme === design)?.dataset
              .label || design;
          button.textContent = `${en ? "Choose" : "Elegir"} ${root.dataset.package} · ${name}`;
          button.style.opacity = valid ? "1" : ".5";
        });
    };
    const fail = () => {
      clearTimeout(timer);
      status.textContent = copy.error;
      retry.hidden = false;
    };
    const startLoading = () => {
      clearTimeout(timer);
      status.textContent = copy.loading;
      retry.hidden = true;
      timer = setTimeout(fail, 20000);
    };
    const loaded = () => {
      // Same-origin demos may redirect to 404; iframe load alone is not success.
      try {
        if (frame.contentWindow?.location.pathname.includes("/404")) {
          fail();
          return;
        }
      } catch {
        fail();
        return;
      }
      clearTimeout(timer);
      status.textContent = copy.ready;
      retry.hidden = true;
    };
    frame.addEventListener("load", loaded);
    frame.addEventListener("error", fail);
    const choose = (design: string, writeHistory = true) => {
      const selected = buttons.find(
        (button) => button.dataset.theme === design,
      );
      if (!selected) {
        notice.hidden = false;
        updatePurchase(root.dataset.design!, false);
        return;
      }
      root.dataset.design = design;
      notice.hidden = true;
      buttons.forEach((button) =>
        button.setAttribute("aria-pressed", String(button === selected)),
      );
      updatePurchase(design, true);
      full.href = selected.dataset.url!;
      if (frame.getAttribute("src") !== selected.dataset.url) {
        startLoading();
        frame.src = selected.dataset.url!;
      }
      const url = new URL(location.href);
      url.searchParams.set("tema", design);
      root
        .querySelectorAll<HTMLAnchorElement>(".packages a")
        .forEach((link) => {
          const target = new URL(link.href);
          target.searchParams.set("tema", design);
          link.href = target.href;
        });
      if (writeHistory && url.href !== location.href)
        history.pushState({}, "", url);
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => choose(button.dataset.theme!)),
    );
    retry.addEventListener("click", () => {
      startLoading();
      frame.src = full.href;
    });
    const onPop = () =>
      choose(
        new URL(location.href).searchParams.get("tema") ||
          root.dataset.initial!,
        false,
      );
    window.addEventListener("popstate", onPop);
    document.addEventListener(
      "astro:before-swap",
      () => {
        clearTimeout(timer);
        window.removeEventListener("popstate", onPop);
      },
      { once: true },
    );
    updatePurchase(
      root.dataset.design!,
      root.dataset.requested === root.dataset.design,
    );
    startLoading();
    if (
      frame.contentDocument?.readyState === "complete" &&
      frame.contentWindow?.location.href !== "about:blank"
    )
      loaded();
  }
  initializeWeddingSelector();
  document.addEventListener("astro:page-load", initializeWeddingSelector);
</script>
