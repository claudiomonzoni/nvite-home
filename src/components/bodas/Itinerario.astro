---
import Encabezados from './Encabezados.astro';

interface Props {
  listado: Array<any>;
    titulo: string;
}
const { listado, titulo } = Astro.props;

---

<section class="grid contenido">
  <Encabezados texto={titulo} />
  <ol>
    {
      listado.map((item, index) => (
        <li>
          <h4>{item.titulo}</h4>
          <p>{item.lugar}</p>
          <p>{item.hora}</p>
        </li>
      ))
    }
  </ol>
</section>

<script>
  // aqui el modal del mapa

  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  window.addEventListener("hero:ready", () => {
    console.log("hero:ready itinerario");
    const eventoItinerario = gsap.utils.toArray("ol li") as HTMLElement[];
    gsap.registerPlugin(ScrollTrigger);

    eventoItinerario.forEach((evento) => {
      const mm = gsap.matchMedia();

      mm.add("(min-width: 800px)", () => {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: evento,
            start: "top 100%",
            end: "bottom 70%",
            scrub: true,
          },
        });
        tl.from(evento.children, {
          ease: "power2.out",
          y: 160,
          opacity: 0,
          filter: "blur(20px)",
          stagger: 0.1,
        });
      });

      mm.add("(max-width: 799px)", () => {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: evento,
            start: "top 80%",
            end: "top 50%",
            scrub: true,
          },
        });
        tl.from(evento.children, {
          ease: "power2.out",
          y: 100,
          opacity: 0,
          filter: "blur(10px)",
          stagger: 0.1,
        });
      });
    });
  });
</script>
