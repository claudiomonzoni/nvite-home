---
import { Icon } from "astro-icon/components";
import { PROVEEDORES_COMUNES, isCommonProviderCovered } from "../../pages/api/proveedores.json.ts";
import { useTranslations } from "../../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);

export interface PagoProps {
  id: number;
  proveedorId: number;
  monto: number;
  fecha: Date | string;
  concepto?: string | null;
}

export interface TareaProps {
  id: number;
  proveedorId: number;
  titulo: string;
  fechaLimite?: Date | string | null;
  completada: boolean;
}

export interface ProveedorProps {
  id: number;
  usuarioId: number;
  nombre: string;
  categoria: string;
  contactoNombre?: string | null;
  contactoTelefono?: string | null;
  presupuestoTotal: number;
  fechaLimitePago?: Date | string | null;
  notas?: string | null;
  totalPagado: number;
  saldoPendiente: number;
  pagos: PagoProps[];
  tareas: TareaProps[];
}

interface Props {
  proveedores: ProveedorProps[];
  nombreEvento?: string | null;
}

const { proveedores = [], nombreEvento } = Astro.props;

// Calculate Global Metrics
const presupuestoTotalGlobal = proveedores.reduce((sum, p) => sum + (p.presupuestoTotal || 0), 0);
const totalPagadoGlobal = proveedores.reduce((sum, p) => sum + (p.totalPagado || 0), 0);
const saldoPendienteGlobal = Math.max(0, presupuestoTotalGlobal - totalPagadoGlobal);
const porcentajePagadoGlobal = presupuestoTotalGlobal > 0 ? Math.round((totalPagadoGlobal / presupuestoTotalGlobal) * 100) : 0;

export const CATEGORIAS_CONFIG = [
  { key: "all", es: "Todos", en: "All" },
  { key: "foto", es: "Fotografía y Video", en: "Photography & Video" },
  { key: "banquete", es: "Banquete", en: "Catering / Food" },
  { key: "salon", es: "Salón / Locación", en: "Venue / Location" },
  { key: "musica", es: "Música / DJ", en: "Music / DJ" },
  { key: "flores", es: "Flores y Decoración", en: "Flowers & Decor" },
  { key: "bebidas", es: "Bebidas y Barra", en: "Drinks & Bar" },
  { key: "postres", es: "Postres y Pastelería", en: "Cake & Desserts" },
  { key: "estilo", es: "Estilo y Vestuario", en: "Dress & Style" },
  { key: "otros", es: "Otros", en: "Others" },
];

export function getCategoryKey(cat: string = ""): string {
  const norm = (cat || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
  if (!norm || norm === "todos" || norm === "all") return "all";
  if (norm.includes("fotograf") || norm.includes("video") || norm.includes("photo")) return "foto";
  if (norm.includes("banquet") || norm.includes("cater") || norm.includes("food") || norm.includes("comida")) return "banquete";
  if (norm.includes("salon") || norm.includes("locacion") || norm.includes("venue") || norm.includes("location") || norm.includes("lugar")) return "salon";
  if (norm.includes("music") || norm.includes("dj") || norm.includes("musica") || norm.includes("banda") || norm.includes("grupo")) return "musica";
  if (norm.includes("flor") || norm.includes("flower") || norm.includes("decor")) return "flores";
  if (norm.includes("bebid") || norm.includes("drink") || norm.includes("bar") || norm.includes("coctel") || norm.includes("cocktail")) return "bebidas";
  if (norm.includes("postre") || norm.includes("dessert") || norm.includes("pastel") || norm.includes("cake") || norm.includes("dulce")) return "postres";
  if (norm.includes("estilo") || norm.includes("vest") || norm.includes("dress") || norm.includes("style") || norm.includes("traje") || norm.includes("suit") || norm.includes("maquillaj") || norm.includes("makeup")) return "estilo";
  return "otros";
}

export function getCategoryLabel(cat: string = "", currentLang: string = "es"): string {
  const key = getCategoryKey(cat);
  const found = CATEGORIAS_CONFIG.find((c) => c.key === key);
  if (found && key !== "otros") {
    return currentLang === "en" ? found.en : found.es;
  }
  return cat || (currentLang === "en" ? "Others" : "Otros");
}

const categoriasDisponibles = CATEGORIAS_CONFIG.map((c) => (lang === "en" ? c.en : c.es));

const comunesFaltantes = PROVEEDORES_COMUNES.filter(
  (c) => !isCommonProviderCovered(c, proveedores)
);
const todosComunesPrecargados = comunesFaltantes.length === 0;
---

<div id="gestor-proveedores-root" class="gestor-proveedores-wrapper" data-proveedores={JSON.stringify(proveedores)}>
  <!-- Top Bar Metrics -->
  <div class="metricas-container">
    <div class="card-metrica">
      <div class="icon-box primario">
        <Icon name="mdi:calculator-variant-outline" size={26} />
      </div>
      <div class="metrica-data">
        <span class="metrica-val">${presupuestoTotalGlobal.toLocaleString(lang === "en" ? "en-US" : "es-MX")}</span>
        <span class="metrica-lbl">{t('panel.vendors.budget')}</span>
      </div>
    </div>

    <div class="card-metrica">
      <div class="icon-box primario">
        <Icon name="mdi:cash-check" size={26} />
      </div>
      <div class="metrica-data">
        <span class="metrica-val">${totalPagadoGlobal.toLocaleString(lang === "en" ? "en-US" : "es-MX")}</span>
        <span class="metrica-lbl">{t('panel.vendors.paid')} ({porcentajePagadoGlobal}%)</span>
      </div>
    </div>

    <div class="card-metrica">
      <div class="icon-box primario">
        <Icon name="mdi:cash-clock" size={26} />
      </div>
      <div class="metrica-data">
        <span class="metrica-val">${saldoPendienteGlobal.toLocaleString(lang === "en" ? "en-US" : "es-MX")}</span>
        <span class="metrica-lbl">{t('panel.vendors.pending')}</span>
      </div>
    </div>
  </div>

  <!-- Action Bar & Category Filters -->
  <div class="controls-bar">
    <div class="filtros-scroll">
      {CATEGORIAS_CONFIG.map((catObj, idx) => {
        const catLabel = lang === "en" ? catObj.en : catObj.es;
        return (
          <button
            type="button"
            class={`cat-filter-btn ${idx === 0 ? "active" : ""}`}
            data-cat-key={catObj.key}
            data-categoria={catLabel}
          >
            {catLabel}
          </button>
        );
      })}
    </div>

    <div class="actions-group">
      <button
        type="button"
        id="btn-precargar-proveedores"
        class={`btn-action btn-precargar ${todosComunesPrecargados ? "disabled" : ""}`}
        title={todosComunesPrecargados ? (lang === 'en' ? 'Standard vendors already added' : 'Todos los proveedores comunes ya fueron agregados') : (lang === 'en' ? 'Quick load standard vendors' : 'Inyectar proveedores estándar')}
        disabled={todosComunesPrecargados}
      >
        <Icon name={todosComunesPrecargados ? "mdi:check-all" : "mdi:flash-outline"} size={18} />
        <span>{todosComunesPrecargados ? (lang === 'en' ? 'Preloaded' : 'Comunes Precargados') : (lang === 'en' ? 'Preload Standard' : 'Precargar Comunes')}</span>
      </button>

      <button type="button" id="btn-nuevo-proveedor" class="btn-primary-sm">
        <Icon name="mdi:store-plus-outline" size={18} />
        <span>{t('panel.vendors.add')}</span>
      </button>
    </div>
  </div>

  <!-- Main Providers Cards Grid (Responsivo en Celular) -->
  <div id="proveedores-grid" class="proveedores-cards-grid">
    {proveedores.length === 0 ? (
      <div class="empty-state-box">
        <Icon name="mdi:store-search-outline" size={54} />
        <h3>{t('panel.vendors.empty')}</h3>
        <p>{t('panel.vendors.emptySub')}</p>
      </div>
    ) : (
      proveedores.map((p) => {
        const numPagos = p.pagos ? p.pagos.length : 0;
        const pctPagado = p.presupuestoTotal > 0 ? Math.round((p.totalPagado / p.presupuestoTotal) * 100) : 0;
        const tareasCompletadas = p.tareas ? p.tareas.filter((t) => t.completada).length : 0;
        const totalTareas = p.tareas ? p.tareas.length : 0;
        const esLiquidado = p.presupuestoTotal > 0 && p.saldoPendiente === 0;

        return (
          <article
            class="prov-card-item"
            data-cat-key={getCategoryKey(p.categoria)}
            data-categoria={getCategoryLabel(p.categoria, lang)}
            data-provider-id={p.id}
          >
            <div class="card-head">
              <div class="card-head-left">
                <span class="cat-pill">{getCategoryLabel(p.categoria, lang)}</span>
                <h3 class="prov-name">{p.nombre}</h3>
              </div>
              <span class={`status-badge ${esLiquidado ? "liquidado" : p.saldoPendiente > 0 ? "pendiente" : "indefinido"}`}>
                {esLiquidado ? (lang === 'en' ? 'Paid in Full' : 'Liquidado') : p.saldoPendiente > 0 ? (lang === 'en' ? `Balance $${p.saldoPendiente.toLocaleString("en-US")}` : `Pendiente $${p.saldoPendiente.toLocaleString("es-MX")}`) : (lang === 'en' ? 'TBD' : 'Por definir')}
              </span>
            </div>

            <div class="prov-card-actions">
              <button type="button" class="btn-icon" data-id={p.id} title={t('panel.guest.edit')}>
                <Icon name="mdi:pencil-outline" size={20} />
                <span>{t('panel.guest.edit')}</span>
              </button>
              <button type="button" class="btn-icon delete btn-delete-prov-card" data-id={p.id} data-nombre={p.nombre} title={t('panel.guest.delete')}>
                <Icon name="mdi:delete-outline" size={20} />
                <span>{t('panel.guest.delete')}</span>
              </button>
            </div>

            <div class="card-contact-row">
              {p.contactoNombre && <span class="c-nombre"><Icon name="mdi:account-outline" size={18} /> {p.contactoNombre}</span>}
              {p.contactoTelefono && (
                <a
                  href={`https://wa.me/${p.contactoTelefono.replace(/\D/g, "")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa-btn"
                  title="WhatsApp"
                  onclick="event.stopPropagation()"
                >
                  <Icon name="mdi:whatsapp" size={18} /> {p.contactoTelefono}
                </a>
              )}
            </div>

            <!-- Resumen Financiero -->
            <div class="card-fin-box">
              <div class="fin-text-row">
                <span><strong>{numPagos} {lang === 'en' ? (numPagos === 1 ? 'payment' : 'payments') : (numPagos === 1 ? 'pago' : 'pagos')}:</strong> ${p.totalPagado.toLocaleString(lang === 'en' ? "en-US" : "es-MX")} / ${p.presupuestoTotal.toLocaleString(lang === 'en' ? "en-US" : "es-MX")}</span>
                <span class="pct-val">{pctPagado}%</span>
              </div>
              <div class="progress-track">
                <div class="progress-fill" style={`width: ${Math.min(100, pctPagado)}%;`}></div>
              </div>
            </div>

            <!-- Checklist status info -->
            <div class="card-checklist-row">
              <span><Icon name="mdi:checkbox-marked-circle-outline" size={18} /> {lang === 'en' ? `Checklist: ${tareasCompletadas} of ${totalTareas} completed` : `Checklist: ${tareasCompletadas} de ${totalTareas} completadas`}</span>
            </div>
          </article>
        );
      })
    )}
  </div>
</div>

<!-- MODAL: AGREGAR PROVEEDOR -->
<dialog id="agregar-prov-dialog" class="prov-modal">
  <div class="modal-box">
    <div class="modal-head">
      <h2>{lang === 'en' ? '+ Add New Vendor' : '+ Agregar Nuevo Proveedor'}</h2>
      <button type="button" class="btn-close-modal" data-close="agregar-prov-dialog" title="Cerrar ventana">X</button>
    </div>

    <form id="form-nuevo-proveedor" class="modal-form-body">
      <label class="form-label">
        <span>{lang === 'en' ? 'Vendor Name *' : 'Nombre del Proveedor *'}</span>
        <input type="text" id="new-nombre" name="nombre" required maxlength="80" placeholder={lang === 'en' ? "e.g. Photography Studio" : "Ej. Fotografía Studio Guadalajara"} />
      </label>

      <div class="fields-row">
        <label class="form-label">
          <span>{lang === 'en' ? 'Category *' : 'Categoría / Giro *'}</span>
          <select id="new-categoria" name="categoria" required>
            {categoriasDisponibles.filter((c) => c !== "Todos" && c !== "All").map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </label>

        <label class="form-label">
          <span>{lang === 'en' ? 'Total Budget ($)' : 'Presupuesto Comprometido ($)'}</span>
          <input type="number" id="new-presupuesto" name="presupuestoTotal" min="0" max="10000000" placeholder="0.00" />
        </label>
      </div>

      <div class="fields-row">
        <label class="form-label">
          <span>{lang === 'en' ? 'Contact Name' : 'Nombre de Contacto'}</span>
          <input type="text" id="new-contacto" name="contactoNombre" maxlength="80" placeholder={lang === 'en' ? "e.g. John Doe" : "Ej. Carlos Mendoza"} />
        </label>

        <label class="form-label">
          <span>{lang === 'en' ? 'Phone / WhatsApp' : 'Celular / WhatsApp'}</span>
          <input type="tel" id="new-telefono" name="contactoTelefono" maxlength="15" placeholder={lang === 'en' ? "10 digits" : "10 dígitos"} />
        </label>
      </div>

      <label class="form-label">
        <span>{lang === 'en' ? 'Payment Due Date (Optional)' : 'Fecha Límite de Liquidación (Opcional)'}</span>
        <input type="date" id="new-fecha-pago" name="fechaLimitePago" />
      </label>

      <label class="form-label">
        <span>{lang === 'en' ? 'Notes or Requirements' : 'Notas o Requerimientos'}</span>
        <textarea id="new-notas" name="notas" rows="2" placeholder={lang === 'en' ? "Contract details, venue requirements, playlist..." : "Detalles de contrato, ubicación, requerimientos..."}></textarea>
      </label>

      <div class="modal-foot">
        <button type="button" class="btn-cancel" data-close="agregar-prov-dialog">{t('panel.modal.cancel')}</button>
        <button type="submit" class="btn-submit">{lang === 'en' ? 'Save Vendor' : 'Guardar Proveedor'}</button>
      </div>
    </form>
  </div>
</dialog>

<!-- MODAL: DETALLE COMPLETO -->
<dialog id="detalle-prov-dialog" class="prov-modal modal-wide">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-head-titles">
        <span id="det-categoria-badge" class="cat-pill">{lang === 'en' ? 'Category' : 'Categoría'}</span>
        <h2 id="det-nombre-title">{lang === 'en' ? 'Edit Vendor' : 'Editar Proveedor'}</h2>
      </div>
      <button type="button" id="btn-cerrar-modal-detalle" class="btn-close-modal" title="Cerrar ventana">X</button>
    </div>

    <!-- Scroll Único del Cuerpo del Modal -->
    <div class="modal-scroll-body">
      <div class="modal-body-columns">
        <!-- Left Column: Data Edit & Payments -->
        <div class="col-stack">
          <!-- Accordion Panel 1: General Info -->
          <div class="sub-panel accordion-panel" data-panel="info">
            <input type="hidden" id="det-prov-id" name="id" />
            <div class="accordion-head">
              <div class="accordion-title">
                <Icon name="mdi:pencil-box-outline" size={22} />
                <h3>{lang === 'en' ? 'Vendor Information' : 'Información del Proveedor'}</h3>
              </div>
              <div class="accordion-right">
                <span id="badge-summary-info" class="accordion-badge">{lang === 'en' ? 'Basic info' : 'Datos básicos'}</span>
                <span class="chevron-toggle"><Icon name="mdi:chevron-down" size={20} /></span>
              </div>
            </div>

            <div class="accordion-content">
              <div class="fields-row">
                <label class="form-label">
                  <span>{lang === 'en' ? 'Vendor Name' : 'Nombre del Proveedor'}</span>
                  <input type="text" id="det-nombre" name="nombre" required maxlength="80" />
                </label>
                <label class="form-label">
                  <span>{lang === 'en' ? 'Category' : 'Categoría / Giro'}</span>
                  <select id="det-categoria" name="categoria">
                    {categoriasDisponibles.filter((c) => c !== "Todos" && c !== "All").map((cat) => (
                      <option value={cat}>{cat}</option>
                    ))}
                  </select>
                </label>
              </div>

              <div class="fields-row">
                <label class="form-label">
                  <span>{lang === 'en' ? 'Contact Name' : 'Nombre de Contacto'}</span>
                  <input type="text" id="det-contacto" name="contactoNombre" maxlength="80" />
                </label>
                <label class="form-label">
                  <span>{lang === 'en' ? 'Phone / WhatsApp' : 'Celular / WhatsApp'}</span>
                  <input type="tel" id="det-telefono" name="contactoTelefono" maxlength="15" />
                </label>
              </div>

              <div class="fields-row">
                <label class="form-label">
                  <span>{lang === 'en' ? 'Total Budget ($)' : 'Presupuesto Comprometido ($)'}</span>
                  <input type="number" id="det-presupuesto" name="presupuestoTotal" min="0" max="10000000" />
                </label>
                <label class="form-label">
                  <span>{lang === 'en' ? 'Payment Due Date (Optional)' : 'Fecha Límite Pago (Opcional)'}</span>
                  <input type="date" id="det-fecha-pago" name="fechaLimitePago" />
                </label>
              </div>
            </div>
          </div>

          <!-- Accordion Panel 2: Payments History -->
          <div class="sub-panel accordion-panel" data-panel="pagos">
            <div class="accordion-head">
              <div class="accordion-title">
                <Icon name="mdi:cash-register" size={22} />
                <h3>{lang === 'en' ? 'Payment History' : 'Historial de Abonos / Pagos'}</h3>
              </div>
              <div class="accordion-right">
                <span id="badge-summary-pagos" class="accordion-badge green">{lang === 'en' ? '$0 paid' : '$0 abonado'}</span>
                <span class="chevron-toggle"><Icon name="mdi:chevron-down" size={20} /></span>
              </div>
            </div>

            <div class="accordion-content">
              <div class="fin-summary-card">
                <div class="fin-stat">
                  <span class="l">{lang === 'en' ? 'Total' : 'Acordado'}</span>
                  <span id="det-fin-total" class="v">$0</span>
                </div>
                <div class="fin-stat">
                  <span class="l">{lang === 'en' ? 'Paid' : 'Abonado'}</span>
                  <span id="det-fin-pagado" class="v verde">$0</span>
                </div>
                <div class="fin-stat">
                  <span class="l">{lang === 'en' ? 'Balance' : 'Pendiente'}</span>
                  <span id="det-fin-pendiente" class="v rojo">$0</span>
                </div>
              </div>

              <form id="form-nuevo-pago" class="inline-add-form">
                <input type="number" id="inp-pago-monto" min="1" max="10000000" step="any" placeholder={lang === 'en' ? "Amount $" : "Monto $"} class="inp-monto" />
                <input type="date" id="inp-pago-fecha" class="inp-fecha" />
                <input type="text" id="inp-pago-concepto" placeholder={lang === 'en' ? "Description (e.g. 50% deposit)" : "Concepto (ej. Anticipo 50%)"} maxlength="80" class="inp-desc" />
                <button type="submit" class="btn-inline-add">{lang === 'en' ? '+ Add Payment' : '+ Abonar'}</button>
              </form>

              <div id="lista-pagos-container" class="items-list">
                <!-- Dynamic Payments Rows -->
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Checklist & Notes -->
        <div class="col-stack">
          <!-- Accordion Panel 3: Checklist -->
          <div class="sub-panel accordion-panel" data-panel="tareas">
            <div class="accordion-head">
              <div class="accordion-title">
                <Icon name="mdi:format-list-checks" size={22} />
                <h3>{lang === 'en' ? 'Task Checklist' : 'Checklist de Tareas'}</h3>
              </div>
              <div class="accordion-right">
                <span id="badge-summary-tareas" class="accordion-badge purple">{lang === 'en' ? '0 tasks' : '0 tareas'}</span>
                <span class="chevron-toggle"><Icon name="mdi:chevron-down" size={20} /></span>
              </div>
            </div>

            <div class="accordion-content">
              <div class="presets-bar">
                <span class="p-title">{lang === 'en' ? 'Quick add:' : 'Agregar rápido:'}</span>
                <button type="button" class="preset-chip" data-task={lang === 'en' ? "Deposit / Reserve date" : "Anticipo / Reserva apartado"}>
                  {lang === 'en' ? '+ Deposit' : '+ Anticipo'}
                </button>
                <button type="button" class="preset-chip" data-task={lang === 'en' ? "Sign service contract" : "Firmar contrato de servicio"}>
                  {lang === 'en' ? '+ Contract' : '+ Contrato'}
                </button>
                <button type="button" class="preset-chip" data-task={lang === 'en' ? "Define setup timeline" : "Definir horario de montaje"}>
                  {lang === 'en' ? '+ Setup' : '+ Montaje'}
                </button>
                <button type="button" class="preset-chip" data-task={lang === 'en' ? "Final deliverables" : "Entrega de material final"}>
                  {lang === 'en' ? '+ Delivery' : '+ Entregables'}
                </button>
              </div>

              <form id="form-nueva-tarea" class="inline-add-form">
                <input type="text" id="inp-tarea-titulo" placeholder={lang === 'en' ? "Task description..." : "Nombre de la tarea..."} maxlength="100" class="inp-desc" />
                <input type="date" id="inp-tarea-fecha" title={lang === 'en' ? "Due date (Optional)" : "Fecha límite (Opcional)"} class="inp-fecha" />
                <button type="submit" class="btn-inline-add primary">{lang === 'en' ? '+ Add' : '+ Agregar'}</button>
              </form>

              <div id="lista-tareas-container" class="items-list">
                <!-- Dynamic Tasks Rows -->
              </div>
            </div>
          </div>

          <!-- Accordion Panel 4: Notes & Requirements -->
          <div class="sub-panel accordion-panel" data-panel="notas">
            <div class="accordion-head">
              <div class="accordion-title">
                <Icon name="mdi:note-text-outline" size={22} />
                <h3>{lang === 'en' ? 'Notes & Requirements' : 'Notas y Requerimientos'}</h3>
              </div>
              <div class="accordion-right">
                <span id="badge-summary-notas" class="accordion-badge">{lang === 'en' ? 'Notes' : 'Notas'}</span>
                <span class="chevron-toggle"><Icon name="mdi:chevron-down" size={20} /></span>
              </div>
            </div>

            <div class="accordion-content">
              <textarea id="det-notas" name="notas" rows="3" placeholder={lang === 'en' ? "Power requirements, location, playlists..." : "Requerimientos de luz, ubicación, playlists..."}></textarea>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky Footer for Single Batch Save Action -->
    <div class="modal-footer-sticky">
      <div class="save-indicator">
        <span id="save-status-badge" class="badge-status">{lang === 'en' ? 'No changes' : 'Sin cambios'}</span>
      </div>
      <div class="footer-actions">
        <button type="button" id="btn-cancelar-edicion" class="btn-cancel">{t('panel.modal.cancel')}</button>
        <button type="button" id="btn-guardar-edicion-global" class="btn-submit btn-save-global">
           {t('panel.modal.save')}
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dialogAgregar = document.getElementById("agregar-prov-dialog") as HTMLDialogElement;
    const dialogDetalle = document.getElementById("detalle-prov-dialog") as HTMLDialogElement;

    const rootElem = document.getElementById("gestor-proveedores-root");
    let localProveedores: any[] = [];
    if (rootElem) {
      try {
        localProveedores = JSON.parse(rootElem.getAttribute("data-proveedores") || "[]");
      } catch (e) {}
    }

    // Decode HTML entities (e.g. &amp; -> &)
    const decodeHTML = (html: string) => {
      const txt = document.createElement("textarea");
      txt.innerHTML = html;
      return txt.value;
    };

    // Accordion Toggle Handlers
    document.querySelectorAll(".accordion-head").forEach((head) => {
      head.addEventListener("click", () => {
        const panel = head.closest(".accordion-panel");
        if (panel) {
          panel.classList.toggle("collapsed");
        }
      });
    });

    // In-memory draft state for active modal editing without flickering/reloads
    let draftProv: any = null;
    let isDirty = false;

    const setDirty = (dirty: boolean) => {
      isDirty = dirty;
      const badge = document.getElementById("save-status-badge");
      const btnSave = document.getElementById("btn-guardar-edicion-global");
      if (badge) {
        if (dirty) {
          badge.textContent = "● Cambios pendientes por guardar";
          badge.className = "badge-status dirty";
        } else {
          badge.textContent = "✓ Todo guardado";
          badge.className = "badge-status clean";
        }
      }
      if (btnSave) {
        if (dirty) {
          btnSave.classList.add("highlight");
        } else {
          btnSave.classList.remove("highlight");
        }
      }
    };

    const attemptCloseDetailModal = async () => {
      if (isDirty) {
        const confirmSave = confirm("Tienes cambios pendientes por guardar en este proveedor. ¿Deseas guardarlos antes de salir?\n\n[Aceptar] = Guardar cambios\n[Cancelar] = Descartar cambios y salir");
        if (confirmSave) {
          await saveGlobalEdits();
          return;
        }
      }
      setDirty(false);
      dialogDetalle.close();
    };

    // Close on backdrop click for both dialogs
    [dialogAgregar, dialogDetalle].forEach((dialog) => {
      if (dialog) {
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) {
            if (dialog === dialogDetalle) {
              attemptCloseDetailModal();
            } else {
              dialog.close();
            }
          }
        });
      }
    });

    const btnCerrarDetalle = document.getElementById("btn-cerrar-modal-detalle");
    if (btnCerrarDetalle) {
      btnCerrarDetalle.addEventListener("click", attemptCloseDetailModal);
    }

    const btnCancelarEdicion = document.getElementById("btn-cancelar-edicion");
    if (btnCancelarEdicion) {
      btnCancelarEdicion.addEventListener("click", attemptCloseDetailModal);
    }

    // Close buttons using data-close attribute (e.g. Agregar Proveedor modal)
    document.querySelectorAll("[data-close]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const dialogId = btn.getAttribute("data-close");
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog) {
            dialog.close();
          }
        }
      });
    });

    // Category Filter Buttons
    const filterBtns = document.querySelectorAll(".cat-filter-btn");
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const catKeySelected = btn.getAttribute("data-cat-key");
        const cards = document.querySelectorAll(".prov-card-item");

        cards.forEach((card) => {
          const cardCatKey = card.getAttribute("data-cat-key");
          if (!catKeySelected || catKeySelected === "all" || cardCatKey === catKeySelected) {
            (card as HTMLElement).style.display = "flex";
          } else {
            (card as HTMLElement).style.display = "none";
          }
        });
      });
    });

    // Open Agregar Dialog
    const btnNuevo = document.getElementById("btn-nuevo-proveedor");
    if (btnNuevo && dialogAgregar) {
      btnNuevo.addEventListener("click", () => dialogAgregar.showModal());
    }

    // Form Nuevo Proveedor
    const formNuevo = document.getElementById("form-nuevo-proveedor") as HTMLFormElement;
    if (formNuevo) {
      formNuevo.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(formNuevo);
        const nombre = (formData.get("nombre") as string || "").trim();
        const categoria = (formData.get("categoria") as string || "").trim();
        const presupuestoTotal = Number(formData.get("presupuestoTotal")) || 0;
        const contactoNombre = (formData.get("contactoNombre") as string || "").trim();
        const contactoTelefono = (formData.get("contactoTelefono") as string || "").trim();

        if (!nombre || !categoria) {
          alert("El nombre y la categoría son requeridos.");
          return;
        }
        if (nombre.length > 80) {
          alert("El nombre del proveedor no puede exceder los 80 caracteres.");
          return;
        }
        if (contactoNombre.length > 80) {
          alert("El nombre de contacto no puede exceder los 80 caracteres.");
          return;
        }
        if (contactoTelefono.length > 15) {
          alert("El teléfono de contacto no puede exceder los 15 caracteres.");
          return;
        }
        if (presupuestoTotal < 0 || presupuestoTotal > 10000000) {
          alert("El presupuesto debe ser un número entre 0 y 10,000,000.");
          return;
        }

        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch("/api/proveedores.json", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json();
            alert(err.error || "Error al agregar proveedor");
          }
        } catch (error) {
          alert("Error de conexión");
        }
      });
    }

    // Precargar Proveedores Comunes
    const btnPrecargar = document.getElementById("btn-precargar-proveedores") as HTMLButtonElement | null;
    if (btnPrecargar) {
      btnPrecargar.addEventListener("click", async () => {
        if (btnPrecargar.disabled) {
          alert("Todos los proveedores comunes ya han sido agregados a tu lista.");
          return;
        }

        const provs = localProveedores || [];
        const listaComunes = [
          { nombre: "Fotografía y Video", categoria: "Fotografía y Video" },
          { nombre: "Banquete y Catering", categoria: "Banquete" },
          { nombre: "Locación / Salón de Eventos", categoria: "Salón / Locación" },
          { nombre: "Música / DJ / Grupo En Vivo", categoria: "Música / DJ" },
          { nombre: "Flores y Decoración", categoria: "Flores y Decoración" },
          { nombre: "Bebidas y Barra de Cocteles", categoria: "Bebidas y Barra" },
          { nombre: "Mesa de Dulces / Pastel", categoria: "Postres y Pastelería" },
          { nombre: "Vestido / Traje / Maquillaje", categoria: "Estilo y Vestuario" },
        ];

        const norm = (s: string = "") => s.toLowerCase().trim();
        const checkCovered = (item: any) => {
          const tNom = norm(item.nombre);
          const tCat = norm(item.categoria);
          return provs.some((p: any) => {
            const pNom = norm(p.nombre || "");
            const pCat = norm(p.categoria || "");
            if (pNom === tNom || pCat === tCat) return true;
            if (pCat && tCat && (pCat.includes(tCat) || tCat.includes(pCat))) return true;
            if ((tCat.includes("fotografía") || tCat.includes("video")) && (pCat.includes("fotograf") || pCat.includes("video") || pNom.includes("foto") || pNom.includes("video"))) return true;
            if (tCat.includes("banquete") && (pCat.includes("banquete") || pNom.includes("banquete") || pNom.includes("catering"))) return true;
            if ((tCat.includes("salón") || tCat.includes("locación")) && (pCat.includes("salón") || pCat.includes("salon") || pCat.includes("locación") || pCat.includes("locacion") || pNom.includes("salón") || pNom.includes("salon"))) return true;
            if ((tCat.includes("música") || tCat.includes("dj")) && (pCat.includes("música") || pCat.includes("musica") || pCat.includes("dj") || pNom.includes("dj") || pNom.includes("música") || pNom.includes("musica"))) return true;
            if ((tCat.includes("flores") || tCat.includes("decoración")) && (pCat.includes("flor") || pCat.includes("decor") || pNom.includes("flor") || pNom.includes("decor"))) return true;
            if ((tCat.includes("bebidas") || tCat.includes("barra")) && (pCat.includes("bebida") || pCat.includes("barra") || pNom.includes("bebida") || pNom.includes("barra"))) return true;
            if ((tCat.includes("postres") || tCat.includes("pastelería")) && (pCat.includes("postre") || pCat.includes("pastel") || pNom.includes("dulce") || pNom.includes("pastel"))) return true;
            if ((tCat.includes("estilo") || tCat.includes("vestuario")) && (pCat.includes("estilo") || pCat.includes("vestuario") || pNom.includes("vestido") || pNom.includes("traje"))) return true;
            return false;
          });
        };

        const faltantes = listaComunes.filter((item) => !checkCovered(item));

        if (faltantes.length === 0) {
          alert("Todos los proveedores comunes ya han sido agregados a tu lista.");
          btnPrecargar.disabled = true;
          btnPrecargar.classList.add("disabled");
          return;
        }

        const confirmMsg =
          faltantes.length === 8
            ? "¿Deseas precargar la lista de los 8 proveedores más comunes (Fotografía, Banquete, DJ, Flores, etc.)?"
            : `¿Deseas agregar los ${faltantes.length} proveedores comunes faltantes a tu lista?`;

        if (!confirm(confirmMsg)) {
          return;
        }

        btnPrecargar.disabled = true;
        btnPrecargar.style.opacity = "0.6";

        try {
          const res = await fetch("/api/proveedores.json", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "precargar" }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || "Proveedores precargados correctamente.");
            window.location.reload();
          } else {
            alert(data.error || "Error al precargar proveedores");
            btnPrecargar.disabled = false;
            btnPrecargar.style.opacity = "1";
          }
        } catch (e) {
          alert("Error de conexión");
          btnPrecargar.disabled = false;
          btnPrecargar.style.opacity = "1";
        }
      });
    }

    // Render payments locally in memory (0ms delay)
    const renderPagos = () => {
      const container = document.getElementById("lista-pagos-container");
      if (!container || !draftProv) return;

      const pagos = draftProv.pagos || [];
      const totalPagado = pagos.reduce((sum: number, p: any) => sum + Number(p.monto || 0), 0);
      draftProv.totalPagado = totalPagado;
      draftProv.saldoPendiente = Math.max(0, Number(draftProv.presupuestoTotal || 0) - totalPagado);

      (document.getElementById("det-fin-total") as HTMLElement).textContent = `$${Number(draftProv.presupuestoTotal || 0).toLocaleString("es-MX")}`;
      (document.getElementById("det-fin-pagado") as HTMLElement).textContent = `$${Number(totalPagado).toLocaleString("es-MX")}`;
      (document.getElementById("det-fin-pendiente") as HTMLElement).textContent = `$${Number(draftProv.saldoPendiente).toLocaleString("es-MX")}`;

      const summaryBadge = document.getElementById("badge-summary-pagos");
      if (summaryBadge) {
        summaryBadge.textContent = `$${Number(totalPagado).toLocaleString("es-MX")} abonado`;
      }

      if (pagos.length === 0) {
        container.innerHTML = `<p class="empty-msg">No hay abonos registrados aún.</p>`;
        return;
      }

      container.innerHTML = pagos
        .map((p: any, idx: number) => {
          const fechaStr = p.fecha ? new Date(p.fecha).toLocaleDateString("es-MX") : "";
          return `
            <div class="item-row" data-pago-index="${idx}">
              <div class="row-text">
                <strong>$${Number(p.monto).toLocaleString("es-MX")}</strong>
                <span class="sub">${p.concepto || 'Abono'} (${fechaStr})</span>
              </div>
              <button type="button" class="btn-del-mini btn-del-pago-draft" data-index="${idx}" title="Eliminar abono">✕</button>
            </div>
          `;
        })
        .join("");

      container.querySelectorAll(".btn-del-pago-draft").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-index"));
          draftProv.pagos.splice(idx, 1);
          renderPagos();
          setDirty(true);
        });
      });
    };

    // Render tasks locally in memory (0ms delay)
    const renderTareas = () => {
      const container = document.getElementById("lista-tareas-container");
      if (!container || !draftProv) return;

      const tareas = draftProv.tareas || [];
      const completadas = tareas.filter((t: any) => t.completada).length;

      const summaryBadge = document.getElementById("badge-summary-tareas");
      if (summaryBadge) {
        summaryBadge.textContent = `${completadas} de ${tareas.length} completadas`;
      }

      if (tareas.length === 0) {
        container.innerHTML = `<p class="empty-msg">No hay tareas en el checklist.</p>`;
        return;
      }

      container.innerHTML = tareas
        .map((t: any, idx: number) => {
          const fechaStr = t.fechaLimite ? new Date(t.fechaLimite).toLocaleDateString("es-MX") : "";
          return `
            <div class="item-row ${t.completada ? 'done' : ''}" data-tarea-index="${idx}">
              <label class="chk-label">
                <input type="checkbox" class="chk-tarea-draft" data-index="${idx}" ${t.completada ? 'checked' : ''} />
                <span class="t-title">${t.titulo}</span>
              </label>
              ${fechaStr ? `<span class="date-chip">📅 ${fechaStr}</span>` : ''}
              <button type="button" class="btn-del-mini btn-del-tarea-draft" data-index="${idx}" title="Eliminar tarea">✕</button>
            </div>
          `;
        })
        .join("");

      container.querySelectorAll(".chk-tarea-draft").forEach((chk) => {
        chk.addEventListener("change", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          draftProv.tareas[idx].completada = (e.target as HTMLInputElement).checked;
          renderTareas();
          setDirty(true);
        });
      });

      container.querySelectorAll(".btn-del-tarea-draft").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-index"));
          draftProv.tareas.splice(idx, 1);
          renderTareas();
          setDirty(true);
        });
      });
    };

    const openDetailModal = async (provId: number | string) => {
      try {
        let found = localProveedores.find((p: any) => String(p.id) === String(provId));

        if (!found) {
          try {
            const res = await fetch("/api/proveedores.json");
            if (res.ok) {
              const list = await res.json();
              found = list.find((p: any) => String(p.id) === String(provId));
            }
          } catch (err) {}
        }

        if (!found) {
          console.warn("Proveedor no encontrado para ID:", provId);
          return;
        }

        // Clone into draft memory object
        draftProv = JSON.parse(JSON.stringify(found));
        draftProv.pagos = draftProv.pagos || [];
        draftProv.tareas = draftProv.tareas || [];

        // Safe element setters with HTML entity decoding
        const setVal = (id: string, val: any) => {
          const elem = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
          if (elem) elem.value = decodeHTML(String(val ?? ""));
        };
        const setText = (id: string, text: string) => {
          const elem = document.getElementById(id);
          if (elem) elem.textContent = decodeHTML(text);
        };

        setVal("det-prov-id", draftProv.id);
        setText("det-nombre-title", draftProv.nombre);
        setText("det-categoria-badge", draftProv.categoria);
        setVal("det-nombre", draftProv.nombre);
        setVal("det-categoria", draftProv.categoria);
        setVal("det-contacto", draftProv.contactoNombre || "");
        setVal("det-telefono", draftProv.contactoTelefono || "");
        setVal("det-presupuesto", draftProv.presupuestoTotal || 0);
        setVal("det-fecha-pago", draftProv.fechaLimitePago ? new Date(draftProv.fechaLimitePago).toISOString().split("T")[0] : "");
        setVal("det-notas", draftProv.notas || "");

        renderPagos();
        renderTareas();
        setDirty(false);

        // Reset all accordion panels to expanded on open
        document.querySelectorAll(".accordion-panel").forEach((panel) => panel.classList.remove("collapsed"));

        if (dialogDetalle && !dialogDetalle.open) {
          dialogDetalle.showModal();
        }
      } catch (e) {
        console.error("Error opening detail modal:", e);
      }
    };

    // Clean Event Delegation on Providers Grid
    const provGrid = document.getElementById("proveedores-grid");
    if (provGrid) {
      provGrid.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        if (target.closest(".wa-btn")) {
          return;
        }
        const btnDelete = target.closest(".btn-delete-prov-card");
        if (btnDelete) {
          const id = btnDelete.getAttribute("data-id");
          const nombre = btnDelete.getAttribute("data-nombre");
          if (!id) return;
          if (!confirm(`¿Estás seguro de eliminar el proveedor "${nombre}" y todos sus registros?`)) {
            return;
          }
          try {
            const res = await fetch(`/api/proveedores.json?id=${id}`, {
              method: "DELETE",
            });
            if (res.ok) {
              window.location.reload();
            } else {
              alert("Error al eliminar proveedor");
            }
          } catch (err) {
            console.error(err);
            alert("Error al eliminar proveedor");
          }
          return;
        }
        const card = target.closest(".prov-card-item");
        if (card) {
          const provId = card.getAttribute("data-provider-id");
          if (provId) {
            openDetailModal(provId);
          }
        }
      });
    }

    // Mark dirty on basic field input changes
    ["det-nombre", "det-categoria", "det-contacto", "det-telefono", "det-presupuesto", "det-fecha-pago", "det-notas"].forEach((fieldId) => {
      const elem = document.getElementById(fieldId);
      if (elem) {
        elem.addEventListener("input", () => {
          if (draftProv) {
            draftProv.nombre = (document.getElementById("det-nombre") as HTMLInputElement).value;
            draftProv.categoria = (document.getElementById("det-categoria") as HTMLSelectElement).value;
            draftProv.contactoNombre = (document.getElementById("det-contacto") as HTMLInputElement).value;
            draftProv.contactoTelefono = (document.getElementById("det-telefono") as HTMLInputElement).value;
            draftProv.presupuestoTotal = Number((document.getElementById("det-presupuesto") as HTMLInputElement).value) || 0;
            draftProv.fechaLimitePago = (document.getElementById("det-fecha-pago") as HTMLInputElement).value || null;
            draftProv.notas = (document.getElementById("det-notas") as HTMLTextAreaElement).value;
            
            // Recalculate totals
            const totalPagado = (draftProv.pagos || []).reduce((sum: number, p: any) => sum + Number(p.monto || 0), 0);
            draftProv.totalPagado = totalPagado;
            draftProv.saldoPendiente = Math.max(0, draftProv.presupuestoTotal - totalPagado);

            (document.getElementById("det-fin-total") as HTMLElement).textContent = `$${draftProv.presupuestoTotal.toLocaleString("es-MX")}`;
            (document.getElementById("det-fin-pendiente") as HTMLElement).textContent = `$${draftProv.saldoPendiente.toLocaleString("es-MX")}`;

            setDirty(true);
          }
        });
      }
    });

    // Local Payment Addition (0ms delay, no reload)
    const formPago = document.getElementById("form-nuevo-pago") as HTMLFormElement;
    if (formPago) {
      formPago.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!draftProv) return;

        const inputMonto = document.getElementById("inp-pago-monto") as HTMLInputElement;
        const inputFecha = document.getElementById("inp-pago-fecha") as HTMLInputElement;
        const inputConcepto = document.getElementById("inp-pago-concepto") as HTMLInputElement;

        const monto = Number(inputMonto.value);
        if (!monto || monto <= 0 || monto > 10000000) {
          alert("Ingresa un monto válido entre $1 y $10,000,000.");
          return;
        }
        const concepto = inputConcepto.value.trim();
        if (concepto.length > 80) {
          alert("El concepto de pago no puede exceder los 80 caracteres.");
          return;
        }

        draftProv.pagos.push({
          id: Date.now(),
          proveedorId: draftProv.id,
          monto,
          fecha: inputFecha.value || new Date().toISOString().split("T")[0],
          concepto: concepto || "Abono",
        });

        inputMonto.value = "";
        inputConcepto.value = "";
        
        renderPagos();
        setDirty(true);
      });
    }

    // Task presets
    document.querySelectorAll(".preset-chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        const taskName = btn.getAttribute("data-task");
        const inputT = document.getElementById("inp-tarea-titulo") as HTMLInputElement;
        if (inputT && taskName) {
          inputT.value = taskName;
          inputT.focus();
        }
      });
    });

    // Local Task Addition (0ms delay, no reload)
    const formTarea = document.getElementById("form-nueva-tarea") as HTMLFormElement;
    if (formTarea) {
      formTarea.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!draftProv) return;

        const inputTitulo = document.getElementById("inp-tarea-titulo") as HTMLInputElement;
        const inputFecha = document.getElementById("inp-tarea-fecha") as HTMLInputElement;

        const titulo = inputTitulo.value.trim();
        if (!titulo) {
          alert("Ingresa el título de la tarea");
          return;
        }
        if (titulo.length > 100) {
          alert("El título de la tarea no puede exceder los 100 caracteres.");
          return;
        }

        draftProv.tareas.push({
          id: Date.now(),
          proveedorId: draftProv.id,
          titulo,
          fechaLimite: inputFecha.value || null,
          completada: false,
        });

        inputTitulo.value = "";
        
        renderTareas();
        setDirty(true);
      });
    }

    // Single Batch Save Action Handler
    const saveGlobalEdits = async () => {
      if (!draftProv) return;

      // Validaciones finales antes de guardar
      if (!draftProv.nombre || !draftProv.categoria) {
        alert("El nombre y la categoría son requeridos.");
        return;
      }
      if (draftProv.nombre.length > 80) {
        alert("El nombre del proveedor no puede exceder los 80 caracteres.");
        return;
      }
      if (draftProv.contactoNombre && draftProv.contactoNombre.length > 80) {
        alert("El nombre de contacto no puede exceder los 80 caracteres.");
        return;
      }
      if (draftProv.contactoTelefono && draftProv.contactoTelefono.length > 15) {
        alert("El teléfono de contacto no puede exceder los 15 caracteres.");
        return;
      }
      if (draftProv.presupuestoTotal < 0 || draftProv.presupuestoTotal > 10000000) {
        alert("El presupuesto debe ser un número entre 0 y 10,000,000.");
        return;
      }

      try {
        const res = await fetch("/api/proveedores.json", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(draftProv),
        });

        if (res.ok) {
          setDirty(false);
          window.location.reload();
        } else {
          alert("Error al guardar los cambios del proveedor");
        }
      } catch (e) {
        alert("Error de conexión al guardar los cambios");
      }
    };

    const btnSaveGlobal = document.getElementById("btn-guardar-edicion-global");
    if (btnSaveGlobal) {
      btnSaveGlobal.addEventListener("click", saveGlobalEdits);
    }
  });
</script>

