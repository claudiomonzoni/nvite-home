---
import "swiper/css";
import "swiper/css/pagination";
import "swiper/css/navigation";
import SliderControls from "./SliderControls.astro";

const reviews = [
  {
    name: "Berenice Jimenez / CDMX",
    image: "https://lh3.googleusercontent.com/a-/ALV-UjXmoVWw6nsrNe1efzBInej_NPnj5jfaEl9zibKvXPgy2Gg4JquS=s50-c-rp-mo-br100",
    text: "Nos hicieron unas invitaciones para boda y nos encantaron, están súper lindas y practicas, me las entregaron muy rápido y tienen muy buen estilo. Los súper recomiendo✨🤩 100/10",
    rating: 5
  },
  {
    name: "Chucho González / Zihuatanejo Gro.",
    image: "https://lh3.googleusercontent.com/a-/ALV-UjXo4JUASbjgi76039aHG8vnbYGWYwWbLFXzi159ciP60lmteUQK=s50-c-rp-mo-br100",
    text: "Estuvieron excelentes, a todos mis amigos les encantaron, saludos",
    rating: 5
  },
  {
    name: "Graciela Campos / Merida, Yuc.",
    image: "https://lh3.googleusercontent.com/a/ACg8ocJzrSiEJc6JE_GX_v4va33Nf9VLdrofwZIeBBK15bn1V2SE_w=s50-c-rp-mo-br100",
    text: "Bellísimas invitaciones 😍 fueron enviadas para nuestra boda y encantaron, súper profesionales en toda la atención",
    rating: 5
  },
  {
    name: "Sofía Martínez / Morelia, Mich.",
    image: "/sofia.webp",
    text: "La invitación LUX quedó perfecta y todos confirmaron, ¡muy recomendable!",
    rating: 5
  },
  {
    name: "Andrea P. / Guadalajara, Jal.",
    image: "/andrea.webp",
    text: "Me encantó el diseño LUX y fueron muy atentos.",
    rating: 5
  },
  {
    name: "Fátima Osorio / CDMX",
    image: "/fatima.webp",
    text: "Me ayudaron durante todo el proceso desde la compra hasta que mande mi primer invitación.",
    rating: 5
  }
];

const schemaReviews = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Invitaciones Digitales Nvitaciones",
  "image": "https://nvitaciones.com/invitaciones-digitales-cover-nvitacines-cel.webp",
  "description": "Organiza a tus invitados con invitaciones digitales. Envía por WhatsApp, confirma asistencias y gestiona tus invitados fácilmente con Nvitaciones.",
  "sku": "nvitaciones-digitales",
  "brand": {
    "@type": "Brand",
    "name": "Nvitaciones"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "MXN",
    "lowPrice": "450",
    "highPrice": "1500",
    "offerCount": "3"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": reviews.length.toString()
  },
  "review": reviews.map(review => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": review.name
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": review.rating.toString(),
      "bestRating": "5"
    },
    "reviewBody": review.text
  }))
};

import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
---

<script type="application/ld+json" set:html={JSON.stringify(schemaReviews)} />

<section class="testimonios">
  <div class="testimonios__container">
    <h2 class="testimonios__title">{t('landing.testimonials.title')}</h2>
    <p>{t('landing.testimonials.subtitle')}</p>

    <div class="swiper testimonios-swiper">
      <div class="swiper-wrapper">
        {reviews.map(review => (
          <div class="swiper-slide">
            <div class="testimonios__card">
              <img
                src={review.image}
                alt={`Cliente ${review.name}`}
                class="testimonios__image"
                loading="lazy"
                decoding="async"
              />
              <h3 class="testimonios__name">{review.name}</h3>
              <p class="testimonios__text">
                "{review.text}"
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <SliderControls count={reviews.length} id="testimonios-controls" />
  </div>
</section>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  .testimonios {
    padding: 5rem 0;
    background: linear-gradient(180deg, $fondoGlobal, $terciario);
    h2 {
      margin-bottom: 0;
      color: $primario;
      font-weight: 600;
    }
    p {
      text-align: center;
      margin-bottom: 2rem;
    }

    &__container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    &__title {
      font-size: 2.5rem;
      font-weight: bold;
      text-align: center;
      margin-bottom: 3rem;
      color: $acento;
    }

    &__card {
      background-color: $fondoGlobal;
      padding: 2rem;
      border-radius: $radio;
    }

    &__image {
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      margin: 0 auto 1rem;
      display: block;
    }

    &__name {
      font-size: 1.25rem;
      text-align: center;
      color: $primario;
    }

    &__text {
      text-align: center;
      margin-top: 1rem;
      color: $primario;
    }
    @include cel {
      padding: 2rem 0 5rem 0;
    }
  }
</style>

<script>
  async function initializeTestimonios() {
    const swiperElement = document.querySelector(".testimonios-swiper");
    const controls = document.querySelector("#testimonios-controls");
    if (!swiperElement || !controls) return;

    const [{ default: Swiper }, { Navigation, Autoplay }] = await Promise.all([
      import("swiper"),
      import("swiper/modules")
    ]);

    const existingSwiper = (swiperElement as any).swiper;
    if (existingSwiper) {
      existingSwiper.destroy(true, true);
    }

    const playBtn = controls.querySelector(".play-btn");
    const playIcon = playBtn?.querySelector(".play-icon");
    const pauseIcon = playBtn?.querySelector(".pause-icon");
    const replayIcon = playBtn?.querySelector(".replay-icon");
    const segments = controls.querySelectorAll(".pill-segment");

    let isPlaying = true;

    function updatePlayPauseIcon(running: boolean) {
      isPlaying = running;
      if (running) {
        replayIcon?.classList.add("hidden");
        playIcon?.classList.add("hidden");
        pauseIcon?.classList.remove("hidden");
      } else {
        pauseIcon?.classList.add("hidden");
        replayIcon?.classList.add("hidden");
        playIcon?.classList.remove("hidden");
      }
    }

    function updateSegments(index: number, progressPct: number = 0) {
      segments.forEach((el, idx) => {
        const progressEl = el.querySelector(".segment-progress") as HTMLElement | null;
        if (idx === index) {
          el.classList.add("active-segment");
          if (progressEl) progressEl.style.width = Math.round(progressPct) + "%";
        } else {
          el.classList.remove("active-segment");
          if (progressEl) progressEl.style.width = "0%";
        }
      });
    }

    const swiper = new Swiper(".testimonios-swiper", {
      modules: [Navigation, Autoplay],
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      autoplay: {
        delay: 4000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 3,
        },
      },
      on: {
        init(s) {
          updatePlayPauseIcon(true);
          updateSegments(s.realIndex, 0);
        },
        slideChange(s) {
          updateSegments(s.realIndex, 0);
        },
        autoplayTimeLeft(_s, _timeLeft, percentage) {
          const progress = (1 - percentage) * 100;
          const activeSegmentProgress = controls.querySelector(".active-segment .segment-progress") as HTMLElement | null;
          if (activeSegmentProgress) {
            activeSegmentProgress.style.width = Math.round(progress) + "%";
          }
        },
        autoplayStart() {
          updatePlayPauseIcon(true);
        },
        autoplayStop() {
          updatePlayPauseIcon(false);
        },
      },
    });

    playBtn?.addEventListener("click", () => {
      if (swiper.autoplay.running) {
        swiper.autoplay.stop();
      } else {
        swiper.autoplay.start();
      }
    });

    segments.forEach((seg, idx) => {
      seg.addEventListener("click", () => {
        swiper.slideToLoop(idx);
        if (swiper.autoplay.running) {
          swiper.autoplay.start(); // restart timer
        }
      });
    });
  }

  // Inicializar en transiciones de página
  document.addEventListener("astro:page-load", initializeTestimonios);

  // Inicializar si el documento ya está cargado
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initializeTestimonios();
  }
</script>
