---
import Nav from "./Nav.astro";
import Btn from "./Btn.astro";

import { Icon } from "astro-icon/components";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Logos from "./Logos.astro";

interface Props {
  h1: string;
  p: string;
  textoValidacion: string;
  imagenDesktop: ImageMetadata;
  imagenMobile: ImageMetadata;
  alt?: string;
}
const {
  h1,
  p,
  textoValidacion,
  imagenDesktop,
  imagenMobile,
  alt = "nvitaciones digitales para eventos bodas y quince años",
} = Astro.props;

const optimizedDesktop = await getImage({ src: imagenDesktop, format: "webp", width: 1200 });
const optimizedMobile = await getImage({ src: imagenMobile, format: "webp", width: 600 });
const lang = Astro.locals.lang || "es";
---

<Nav />

<section class="grid contenido" id="conteHero">
  <div id="hero">
    <h1 set:html={h1} id="heroh1" />

    <picture class="imgContainer">
      <source srcset={optimizedDesktop.src} media="(min-width: 479px)" />
      <source srcset={optimizedMobile.src} media="(max-width: 479px)" />
      <Image
        src={imagenDesktop}
        alt={alt}
        loading="eager"
        fetchpriority="high"
      />
    </picture>

    <div id="heroCta">
      <p set:html={p} />
      <Btn
        liga="#nvitaciones"
        texto={lang === "en" ? "View invitations" : "Ver invitaciones"}
        clases="btn-ver-nvitaciones"
        claro={false}
      >
        <Icon name="mdi:chevron-double-down" size={25} />
      </Btn>
      <div id="enviados">
        <picture>
          <source srcset="/sello-nvitaciones.svg" media="(min-width: 479px)" />
          <source
            srcset="/sello-nvitaciones-cel.svg"
            media="(max-width: 479px)"
          />
          <img
            src="/sello-nvitaciones.svg"
            alt="Más de 23,788 invitaciones enviadas en México"
            loading="lazy"
            decoding="async"
            width="66"
            height="85"
          />
        </picture>
        <p set:html={textoValidacion} />
      </div>
      <Logos />
    </div>

  </div>
</section>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  #conteHero {
    position: relative;
    top: 0;
    z-index: 1;
    background: $fondoGlobal;
    background:
      url("/fondo-hojas-home.svg") no-repeat center center,
      linear-gradient(90deg, $fondoGlobal 20%, $secundario 70%);
    @include cel {
      position: relative;
      background: $fondoGlobal;
      background:
        url("/fondo-hojas-home-cel.svg") no-repeat center 130%,
        linear-gradient(160deg, $fondoGlobal 50%, $secundario 70%);
      background-size: 160%, cover;
    }
  }
  #hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 2fr) minmax(15rem, 1.1fr);
    grid-template-rows: 1fr;
    margin-top: 6rem;
    & > * { min-width: 0; }
    @media (min-width: 480px) and (max-width: 1023px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      .imgContainer { order: 2; grid-column: 1 / -1; }
      #heroCta { order: 1; padding: 1.5rem; }
    }
    @include cel {
      margin-top: 8rem;
      grid-template-columns: 1fr;
    }
  }
  #heroh1 {
    order: 0;
    font-size: var(--type-body);
    color: $primario;
    line-height: 1.4;
    letter-spacing: normal;
    text-wrap: pretty;
    padding: $margen-cel 0;
    @include cel {
      padding: $margen-min;
      line-height: 1.4;
    }
  }

  :global(#spanHeroH1) {
    position: relative;
    line-height: 1.08;
    font-size: clamp(2.25rem, 3.4vw, 4rem);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
    color: $primario;
    display: block;
    padding-top: .5rem;
    @include cel {
      padding-top: .8rem!important;
      left: 0px;
      line-height: 1.1;
    }
  }

  .imgContainer {
    order: 1;
    @include cel {
      order: 2;
    }
  }
  #heroCta {
    order: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1rem, 1.5vw, 2rem);
    p {
      color: #35394f;
      font-size: var(--type-body);
      line-height: 1.55;
    }

    @include cel {
      order: 1;
      padding: $margen-min;
      p {
        padding-top: 1rem;
        color: $primario;
      }
      :global(#pHero) {
        display: none;
      }
    }
  }
  #enviados{
    display: flex;
    gap: 1rem;
    margin: 1rem 0;
    align-items: center;
    img {
      width: 3rem;
      height: 3rem;
      object-fit: contain;
      
    }
    p {
      
      color: #35394f;
      font-size: var(--type-small);
      line-height: 1.5;
      padding:0;
      @include cel {
        font-weight: 600;
        font-size: 1rem;
        color: $primario;
      }
    }
  }

  // Hace que todas las secciones y elementos siguientes pasen por encima del Hero
  :global(#conteHero ~ *:not(.site-footer)) {
    position: relative;
    z-index: 10;
    background-color: $fondoGlobal;
  }
</style>
