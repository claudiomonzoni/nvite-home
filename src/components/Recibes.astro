---
import { Icon } from "astro-icon/components";
import Btn from "./Btn.astro";

const lang = Astro.locals.lang || "es";
const isEn = lang === "en";
---

<div class="flex">
  <div id="recibes">
    <div class="a">
      <h2>{isEn ? "Included with your" : "Recibes con tu invitación de"} <b>{isEn ? "Nvita invitation:" : "Nvita:"}</b></h2>
      <ul>
        <li><b>{isEn ? "Personalized support" : "Trato personalizado"}</b> {isEn ? "during and after your purchase" : "durante y despues de tu compra"}</li>
        <li>{isEn ? "Receive your customized invitation" : "Recibes tu invitación, con los datos de tu evento"} <b>{isEn ? "2 business days" : "2 días hábiles"}</b> {isEn ? "after purchase" : "despues de tu compra"}</li>
        <li>
          {isEn ? "Access to the" : "Acceso a un"} <b>{isEn ? "Guest Dashboard" : "panel de invitados"}</b> {isEn ? "for complete control" : "para tener control total de tus invitaciones"}
        </li>
        <li>{isEn ? "Unlimited invitation sends, all versions included" : "Tu invitación, sin importar la versión, tiene envios ilimitados"}</li>
        <li>
          {isEn ? "Your invitation stays online" : "Tu invitación queda en línea"} <b>{isEn ? "up to 1 month" : "hasta 1 mes"}</b> {isEn ? "after your event" : "despues de la fecha de tu evento"}
        </li>
        <li>
          {isEn ? "Optimized display on mobile and desktop screens" : "Tu invitación se verá bien en celulares y pantallas de laptops o pc"}
        </li>
      </ul>
      <small>{isEn ? "*Guest dashboard not included in basic version" : "*Panel de invitados no aplica en la versión \"basic\""}</small>
     <br>
      <Btn
      liga="#formu"
      texto={isEn ? "Get your invitation" : "Obtén tu invitación"}
      claro={false}
      blank={false}
      >
      <Icon name="bag" size={25} />
      </Btn>
    </div>
    <div class="b">
        <img src="/nvite-panel-invitados.webp" alt="panel de invitados nvita.me" />
  </div>
  </div>
</div>

<style lang="scss">
  @use "../estilos/variables.scss" as *;
  b{
    color: $primario;
  }

  #recibes {
    @extend .sombra;
    margin-bottom:$margen;
    background:
      url("/fondo-nvite-caracteristicas-3.png"),
      linear-gradient(330deg, $fondo 0%, white 70%) $fondo;
    background-size: contain, contain;
    background-repeat: no-repeat, no-repeat;
    background-position: right, center;
    background-blend-mode: color-dodge, normal;
    border-radius: $radio;
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    flex: 1 0 30%;
    // padding: $margen-cel $margen-cel 0 $margen-cel;

}
small{
    font-size: 0.7rem;
}
li{
    list-style: circle;
    margin-top: 0.6rem;
  }
  .a{
    flex: 1 0 70%;

  }
   .b{
    flex: 1 0 30%;

  }
  .a{
    padding: $margen;
  }
  .b{
    display: flex;
    flex-wrap: wrap;
    img{
        flex: 1 0 100%;

    }
    a{
        flex: 1 0 100%;
    }
  }
  @include cel{
    h2{
        text-align: center;
    }
    .a{
        padding: $margen-cel;
    }
  }
</style>
