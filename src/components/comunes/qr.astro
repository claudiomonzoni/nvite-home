---

import QRCode from "qrcode";
import { useTranslations } from "../../i18n/ui";

type Props = {
  invitacion?: string | null;
  nombreInvitacion?: string | null;
  pases?: string | number | null;
  mesa?: string | number | null;
  confirmado?: boolean | null;
  noAsiste?: boolean | null;
  value?: string;
  title?: string;
  subtitle?: string;
  alt?: string;
  size?: number;
  lang?: string | null;
};

const {
  invitacion = null,
  nombreInvitacion = null,
  pases,
  mesa,
  confirmado = false,
  noAsiste = false,
  value,
  title,
  subtitle,
  alt,
  size = 240,
  lang = Astro.locals.lang || "es",
} = Astro.props as Props;

const t = useTranslations(lang);
const displayTitle = title ?? t("qr.title");
const displaySubtitle = subtitle ?? t("qr.subtitle");
const displayName = invitacion ?? nombreInvitacion ?? t("qr.invitation");
const displayPases =
  pases === null || pases === undefined || pases === ""
    ? t("qr.noPasses")
    : String(pases);

const displayMesa =
  mesa === null || mesa === undefined || mesa === ""
    ? t("qr.noTable")
    : String(mesa);

const qrValue =
  value ??
  `${t("qr.guest")}: ${displayName}\n${t("qr.passes")}: ${displayPases}\n${t("qr.assignedTable")}: ${displayMesa}`;

const shouldRender = Boolean(confirmado || noAsiste);
const qrDataUrl = confirmado && !noAsiste
  ? await QRCode.toDataURL(qrValue, {
      width: size,
      margin: 1,
      color: {
        dark: "#111827",
        light: "#ffffff",
      },
    })
  : "";
---

{shouldRender ? (
  <div class={`qr-card ${noAsiste ? 'qr-card--no-asiste' : ''}`}>
    <div class="qr-card__info">
      <p class="qr-card__eyebrow">{displayTitle}</p>
      <h3>{displayName}</h3>

      {noAsiste ? (
        <div class="qr-card__no-asistencia">
          <p>{t("qr.noAttendance")}</p>
        </div>
      ) : (
        <ul class="qr-card__list">
          <li>
            <span>{t("qr.passesLabel")}</span>
            {displayPases}
          </li>
          <li>
            <span>{t("qr.tableLabel")}</span>
            {displayMesa}
          </li>
        </ul>
      )}
    </div>

    {!noAsiste && (
      <div class="qr-card__image">
        <img src={qrDataUrl} alt={alt ?? `${t("qr.alt")} ${displayName}`} />
        {displaySubtitle && <p class="qr-card__subtitle">{displaySubtitle}</p>}
      </div>
    )}
  </div>
) : null}

<style>
  .qr-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    margin: 3rem auto ;
    max-width:750px;
  }

  .qr-card--no-asiste {
    grid-template-columns: 1fr;
    max-width: 500px;
    margin: 0 auto;
  }

  .qr-card__eyebrow {
    margin-bottom: .35rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color:$primario;
    text-align: center;
  }

  .qr-card h3 {
    text-align: center;
    margin: 0 0 1rem;
    font-size: clamp(3.2rem, 2vw, 1.5rem);
    color: $primario!important;
  }

  .qr-card__no-asistencia {
    padding: 1rem;
    border-radius: 0.75rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #6b2e2e;
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .qr-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  .qr-card__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: $margen-min 0.6rem;
    border-radius: 0.75rem;
    background: $terciario;
    font-size:1.5rem;
  }


  .qr-card__image {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .qr-card__image img {
    width: min(100%, 150px);
    height: auto;
    border-radius: 0.75rem;
    background: #fff;
    padding: 0.5rem;
  }

  .qr-card__subtitle {
    margin: 0;
    text-align: center;
    color: #6b7280;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .qr-card {
      grid-template-columns: 1fr;
    }
  }
</style>