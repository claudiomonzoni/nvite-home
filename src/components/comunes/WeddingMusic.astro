---
interface Props { src: string; lang?: string; labels?: { listen?: string }; }
const { src, lang = 'es', labels = {} } = Astro.props;
const en = lang.startsWith('en');
const text = {
  listen: labels.listen || (en ? 'Listen to our wedding song' : 'Escucha la <b>canción</b> de nuestra boda'),
  play: en ? 'Play song' : 'Reproducir canción', pause: en ? 'Pause song' : 'Pausar canción',
  mute: en ? 'Mute' : 'Silenciar', unmute: en ? 'Unmute' : 'Activar sonido',
  seek: en ? 'Song progress' : 'Avance de la canción',
  error: en ? 'The song could not be played. Please try again.' : 'No se pudo reproducir la canción. Intenta de nuevo.',
};
---
<div id="rola">
  <h3 set:html={text.listen} />
  <audio controls id="audioInvitacion" src={src} preload="metadata">
    {en ? 'Your device does not support audio.' : 'Tu dispositivo no soporta el audio.'}
  </audio>
  <div class="music-player" hidden data-play={text.play} data-pause={text.pause} data-mute={text.mute} data-unmute={text.unmute} data-error={text.error}>
    <button class="music-toggle" type="button" aria-label={text.play}>
      <svg class="music-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
      <svg class="music-pause" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M7 5h3v14H7zm7 0h3v14h-3z" /></svg>
    </button>
    <div class="music-progress">
      <input class="music-seek" type="range" min="0" max="100" step="0.1" value="0" disabled aria-label={text.seek} aria-valuetext="0:00" />
    </div>
    <button class="music-mute" type="button" aria-label={text.mute} aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6l5 4Z"/><path class="music-sound" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/><path class="music-silent" d="m16 9 5 6m0-6-5 6" hidden/></svg>
    </button>
  </div>
  <p class="music-status" role="status" aria-live="polite"></p>
</div>
<script>
  const audio = document.querySelector<HTMLAudioElement>('#rola audio');
  const player = document.querySelector<HTMLElement>('#rola .music-player');
  if (audio && player) {
    const toggle = player.querySelector<HTMLButtonElement>('.music-toggle')!;
    const mute = player.querySelector<HTMLButtonElement>('.music-mute')!;
    const seek = player.querySelector<HTMLInputElement>('.music-seek')!;
    const status = document.querySelector<HTMLElement>('#rola .music-status')!;
    const time = (seconds: number) => `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
    let seeking = false;
    audio.controls = false; audio.hidden = true; player.hidden = false;
    const updatePlayback = () => {
      const playing = !audio.paused && !audio.ended;
      toggle.setAttribute('aria-label', (playing ? player.dataset.pause : player.dataset.play)!);
      player.querySelector('.music-play')!.toggleAttribute('hidden', playing);
      player.querySelector('.music-pause')!.toggleAttribute('hidden', !playing);
    };
    const updateProgress = () => {
      const ready = Number.isFinite(audio.duration) && audio.duration > 0;
      seek.disabled = !ready;
      if (!seeking) {
        seek.value = String(ready ? audio.currentTime / audio.duration * 100 : 0);
        seek.setAttribute('aria-valuetext', time(audio.currentTime));
      }
      player.style.setProperty('--music-progress', `${seek.value}%`);
    };
    const play = () => {
      status.textContent = '';
      audio.play().catch(() => { status.textContent = player.dataset.error!; updatePlayback(); });
    };
    toggle.addEventListener('click', () => audio.paused ? play() : audio.pause());
    mute.addEventListener('click', () => { audio.muted = !audio.muted; });
    audio.addEventListener('volumechange', () => {
      mute.setAttribute('aria-label', (audio.muted ? player.dataset.unmute : player.dataset.mute)!);
      mute.setAttribute('aria-pressed', String(audio.muted));
      player.querySelector('.music-sound')!.toggleAttribute('hidden', audio.muted);
      player.querySelector('.music-silent')!.toggleAttribute('hidden', !audio.muted);
    });
    seek.addEventListener('input', () => {
      seeking = true;
      seek.setAttribute('aria-valuetext', time(Number(seek.value) / 100 * audio.duration));
      player.style.setProperty('--music-progress', `${seek.value}%`);
    });
    seek.addEventListener('change', () => {
      if (Number.isFinite(audio.duration)) audio.currentTime = Number(seek.value) / 100 * audio.duration;
      seeking = false; updateProgress();
    });
    ['play', 'pause', 'ended'].forEach(event => audio.addEventListener(event, updatePlayback));
    ['loadedmetadata', 'durationchange', 'timeupdate', 'emptied'].forEach(event => audio.addEventListener(event, updateProgress));
    audio.addEventListener('error', () => { status.textContent = player.dataset.error!; });
    window.addEventListener('iniciarInvitacion', play);
    updatePlayback(); updateProgress();
  }
</script>
<style>
  #rola .music-player { --music-progress: 0%; position: relative; isolation: isolate; display: flex; align-items: center; gap: 1rem; width: min(100%, 32rem); box-sizing: border-box; margin: 1.5rem auto 0; padding: 1rem; border: 0; border-radius: 4px; color: var(--texto, var(--primario)); background: transparent; }
  #rola .music-player::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: var(--fondo); filter: brightness(0.94); pointer-events: none; }
  #rola .music-player[hidden], #rola .music-player [hidden] { display: none; }
  #rola .music-player button { appearance: none; -webkit-appearance: none; display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; box-sizing: border-box; padding: 10px; margin: 0; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
  #rola .music-player .music-toggle { background: var(--primario); color: var(--brisa-on-primary, #fffdf8); }
  #rola .music-player svg { display: block; width: 24px; height: 24px; max-width: none; margin: 0; }
  #rola .music-toggle svg, #rola .music-toggle svg path { fill: currentColor; }
  #rola .music-mute svg path { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  #rola .music-progress { flex: 1; min-width: 0; display: flex; align-items: center; }
  #rola .music-seek { appearance: none; -webkit-appearance: none; display: block; width: 100%; height: 24px; padding: 0; margin: 0; color: inherit; background: transparent; cursor: pointer; }
  #rola .music-seek::-webkit-slider-runnable-track { height: 3px; border-radius: 2px; background: linear-gradient(to right, currentColor 0%, currentColor var(--music-progress), color-mix(in srgb, currentColor, transparent 75%) var(--music-progress), color-mix(in srgb, currentColor, transparent 75%) 100%); }
  #rola .music-seek::-moz-range-track { height: 3px; border-radius: 2px; background: color-mix(in srgb, currentColor, transparent 75%); }
  #rola .music-seek::-moz-range-progress { height: 3px; border-radius: 2px; background: currentColor; }
  #rola .music-seek::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 12px; height: 12px; margin-top: -4.5px; border: 0; border-radius: 50%; background: currentColor; }
  #rola .music-seek::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 50%; background: currentColor; }
  #rola .music-seek:disabled { opacity: 0.45; cursor: default; }
  #rola .music-player :is(button, input):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  #rola .music-status { font: 400 0.8rem var(--font-body, sans-serif); margin: 0.75rem auto 0; max-width: 32rem; }
  #rola .music-status:empty { display: none; }
  @media (max-width: 479px) { #rola .music-player { gap: 0.6rem; padding: 0.7rem; } }
</style>
