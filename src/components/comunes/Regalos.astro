---
// tipo se refiere al tipo de Regalos, si es mesas, efectivo o transferencia
interface Mesa {
  url: string;
  titulo: string;
}

interface Props {
  frase: string;
  beneficiario?: string;
  banco?: string;
  cuenta?: string;
  tipo: Array<string>;
  mesas?: Array<Mesa>;
  labels?: {
    title?: string;
    stores?: string;
    cash?: string;
    cashMessage?: string;
    transfers?: string;
    beneficiary?: string;
    bank?: string;
    account?: string;
  };
}
const {
  frase,
  beneficiario,
  banco,
  cuenta,
  tipo,
  mesas,
  labels = {},
} = Astro.props;

const l = {
  title: labels.title || "Regalos",
  stores: labels.stores || "Mesa de Regalos",
  cash: labels.cash || "Lluvia de sobres",
  cashMessage:
    labels.cashMessage ||
    "Si así lo deseas, puedes darnos el regalo en efectivo, el cual podrán colocar en un sobre",
  transfers: labels.transfers || "Transferencias:",
  beneficiary: labels.beneficiary || "Beneficiario",
  bank: labels.bank || "Banco",
  account: labels.account || "Cuenta",
};
import { Icon } from "astro-icon/components";
import Anchor from "../comunes/Anchor.astro";
---

<div id="bandejaRegalos">
<div class="titulo">
    <Icon name={"mdi:wallet-giftcard"} size={40} />
  <h2>{l.title}</h2>
</div>
  <p set:html={frase} />
  {
    tipo.includes("mesa") && Array.isArray(mesas) && mesas.length > 0 && (
      <div id="regalo">
        <h3>{l.stores}</h3>
        <div id="botones">

        {mesas.map((mesa) => (
          <Anchor
          url={mesa.url}
          id={"estilo"}
          tema={"primario"}
          clases={"large"}
          conBorde={false}
          redondo={true}
          icono={"mdi:shopping-search-outline"}
          texto={mesa.titulo}
          />
        ))}
        </div>
      </div>
    )
  }

  {
    tipo.includes("lluvia") && (
      <div id="lluvia">
        <h3>{l.cash}</h3>
        <p>{l.cashMessage}</p>
      </div>
    )
  }

  {
    tipo.includes("transferencias") && beneficiario && banco && cuenta && (
      <div id="transferencias">
        <h3>{l.transfers}</h3>
        <p>
          Si prefieres hacer una transferencia, puedes hacerlo a la siguiente
          cuenta bancaria:
        </p>
        <ul>
          <li>
            <b>{l.beneficiary}</b>: {beneficiario}
          </li>
          <li>
            <b>{l.bank}</b>: {banco}
          </li>
          <li>
            <b>{l.account}</b>: {cuenta}
          </li>
        </ul>
      </div>
    )
  }
</div>

