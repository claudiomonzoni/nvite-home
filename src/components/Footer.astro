---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
const isEnglish = lang === "en";
const year = new Date().getFullYear();
---

<footer class="site-footer grid pantalla" aria-label={isEnglish ? "Site footer" : "Pie de página del sitio"}>
  <div class="grid contenido">
    <div class="site-footer__inner">
      <div class="site-footer__main">
        <section class="site-footer__brand" aria-label={isEnglish ? "About Nvitaciones" : "Acerca de Nvitaciones"}>
          <a class="site-footer__logo-link" href="/" aria-label={isEnglish ? "Nvitaciones home" : "Inicio de Nvitaciones"}>
            <img
              class="site-footer__logo"
              src="/nvita-logo.svg"
              alt={isEnglish ? "Nvitaciones digital invitations" : "Nvitaciones, invitaciones digitales"}
              width="1182"
              height="189"
              loading="lazy"
            />
          </a>
          <p class="site-footer__tagline">
            {isEnglish
              ? "Digital invitations and thoughtful tools for weddings and quinceañeras."
              : "Invitaciones digitales y herramientas para celebrar bodas y XV años con más calma."}
          </p>
         
        </section>

        <nav class="site-footer__group" aria-label={isEnglish ? "Explore" : "Explora"}>
          <h2>{isEnglish ? "Explore" : "Explora"}</h2>
          <ul>
            <li><a href="/bodas">{t("nav.bodas")}</a></li>
            <li><a href="/invitaciones-quince">{t("nav.quince")}</a></li>
            <li><a href={isEnglish ? "/en/blog" : "/blog"}>{isEnglish ? "Guides & Ideas" : "Guías e ideas"}</a></li>
          </ul>
        </nav>

        <nav class="site-footer__group" aria-label={isEnglish ? "Help and resources" : "Ayuda y recursos"}>
          <h2>{isEnglish ? "Help" : "Ayuda"}</h2>
          <ul>
            <li><a href="/manual">{isEnglish ? "User guide" : "Manual de uso"}</a></li>
            <li><a href="/bodas#faq">{isEnglish ? "Frequently asked questions" : "Preguntas frecuentes"}</a></li>
            <li>
              <a
                href="https://wa.me/527551132468"
                target="_blank"
                rel="noopener noreferrer"
              >{isEnglish ? "Contact us on WhatsApp" : "Escríbenos por WhatsApp"}</a>
            </li>
          </ul>
        </nav>

        <nav class="site-footer__group site-footer__social" aria-label={isEnglish ? "Follow Nvitaciones" : "Sigue a Nvitaciones"}>
          <h2>{isEnglish ? "Follow us" : "Síguenos"}</h2>
          <ul>
            <li><a href="https://www.instagram.com/nvitaciones/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href="https://www.facebook.com/nvitaciones" target="_blank" rel="noopener noreferrer">Facebook</a></li>
            <li><a href="https://www.tiktok.com/@nvitaciones" target="_blank" rel="noopener noreferrer">TikTok</a></li>
          </ul>
        </nav>
      </div>

      <section class="site-footer__dashboard" aria-label={isEnglish ? "Invitation dashboard" : "Panel de invitación"}>
        <div>
          <h2>{isEnglish ? "Already have an invitation?" : "¿Ya tienes tu invitación?"}</h2>
          <p>{isEnglish ? "Manage your guest list, RSVPs, and event details from your dashboard." : "Administra tu lista de invitados, confirmaciones y detalles desde tu panel."}</p>
        </div>
        <a class="site-footer__dashboard-link" href="/panel">
          <Icon name="solar:settings-minimalistic-outline" size={21} />
          <span>{t("nav.panel")}</span>
        </a>
      </section>

      <div class="site-footer__bottom">
        <small>© 2024–{year} Nvitaciones · {t("footer.rights")}</small>
         <address>
            {isEnglish
              ? "CMN Design · Los Patios Center, unit 8 · Ixtapa-Zihuatanejo, Guerrero 40880, Mexico"
              : "CMN Design · C.C. Los Patios, local 8 · Ixtapa-Zihuatanejo, Guerrero, C.P. 40880, México"}
          </address>
        <a class="site-footer__terms" href="/terminos-condiciones">{t("nav.terms")}</a>
        <a class="site-footer__cmn" href="https://www.facebook.com/cmndiseno" target="_blank" rel="noopener noreferrer" aria-label={isEnglish ? "Visit CMN Design on Facebook" : "Visitar CMN Diseño en Facebook"}>
          <img src="/cmn-logo.svg" alt="CMN Design" width="85" height="40" loading="lazy" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  @use "sass:color";
  @use "../estilos/_variables.scss" as *;

  .site-footer {
    position: relative;
    z-index: 10;
    //margin-top: 2rem;
    padding: 5.5rem 0 5.25rem;
    background: $primario;
    color: $fondoGlobal;
  }

  .site-footer__inner {
    width: 100%;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(230px, 1.5fr) repeat(3, minmax(135px, 0.8fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: 2.5rem;
  }

  .site-footer__brand {
    max-width: 330px;
  }

  .site-footer__logo-link {
    display: inline-flex;
    align-items: center;
    border-radius: 0.25rem;
  }

  .site-footer__logo {
    display: block;
    width: clamp(150px, 14vw, 205px);
    height: auto;
  }

  .site-footer__tagline {
    max-width: 30ch;
    margin: 1.15rem 0 1rem;
    color: $fondoGlobal;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .site-footer address {
    color: $fondoGlobal;
    font-size: 0.7rem;
    font-style: normal;
    line-height: 1.5;
    color: $terciario;
  }

  .site-footer__group h2 {
    margin: 0 0 1rem;
    color: $fondoGlobal;
    font-size: 1rem;
    font-weight: 700;
  }

  .site-footer__group ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none !important;
  }

  .site-footer__group li {
    margin: 0;
    padding: 0;
    list-style: none !important;
  }

  .site-footer__group li::marker {
    content: "";
  }

  .site-footer__group a,
  .site-footer__terms {
    color: $fondoGlobal;
    font-size: 0.88rem;
    line-height: 1.45;
    text-decoration: none;
    text-underline-offset: 0.2em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .site-footer__group a:hover,
  .site-footer__terms:hover {
    text-decoration: underline;
  }

  .site-footer__group a:focus-visible,
  .site-footer__terms:focus-visible,
  .site-footer__logo-link:focus-visible,
  .site-footer__cmn:focus-visible {
    outline: 2px solid $secundario;
    outline-offset: 4px;
  }

  .site-footer__dashboard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem clamp(1.25rem, 3vw, 2rem);
    border-radius: 0.75rem;
    background: rgba($terciario, .05);
    @extend .sombra2;

  }

  .site-footer__dashboard h2 {
    margin: 0 0 0.3rem;
    color: $terciario;
    font-size: 1.05rem;
    font-weight: bold;
  }

  .site-footer__dashboard p {
    max-width: 58ch;
    margin: 0;
    color: $terciario;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .site-footer__dashboard-link {
    display: inline-flex;
    min-height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.7rem 1rem;
    border-radius: 0.4rem;
    background: $primario;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .site-footer__dashboard-link:hover {
    transform: translateY(-1px);
    background: color.adjust($primario, $lightness: -7%);
  }

  .site-footer__dashboard-link:focus-visible {
    outline: 3px solid $primario;
    outline-offset: 3px;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    gap: 1.5rem;
    padding-top: 1.2rem;
    color: $fondoGlobal;
  }

  .site-footer__bottom small {
    margin-right: auto;
    font-size: 0.76rem;
    line-height: 1.5;
  }



  .site-footer__cmn img {
    display: block;
    width: 72px;
    height: auto;
  }

  @include tableta {
    .site-footer__main {
      grid-template-columns: minmax(220px, 1.3fr) repeat(2, minmax(140px, 1fr));
      row-gap: 2rem;
    }

    .site-footer__social {
      grid-column: 2 / -1;
    }

    .site-footer__social ul {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  @media (min-width: $cel + 1px) and (max-width: $tableta - 2px) {
    .site-footer__main {
      grid-template-columns: minmax(220px, 1.3fr) repeat(2, minmax(140px, 1fr));
      row-gap: 2rem;
    }

    .site-footer__social {
      grid-column: 2 / -1;
    }

    .site-footer__social ul {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  @include cel {
    .site-footer {
      margin-top: 1rem;
      padding: 4.5rem 1rem 6rem;
    }

    .site-footer__main {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.8rem 1.6rem;
      padding-bottom: 3.75rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
      max-width: 34rem;
    }

    .site-footer__social {
      grid-column: auto;
    }

    .site-footer__social ul {
      display: grid;
      gap: 0.75rem;
    }

    .site-footer__dashboard {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
    }

    .site-footer__dashboard-link {
      width: 100%;
    }

    .site-footer__bottom {
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      padding-top: 1rem;
    }

    .site-footer__bottom small {
      width: 100%;
      margin: 0;
    }

    .site-footer__cmn {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__group a,
    .site-footer__terms,
    .site-footer__dashboard-link {
      transition: none;
    }
  }
</style>
