---
// Importaciones principales
const slug = Astro.params.slug ?? "";
import { getProductPrice } from "../../js/cart";
import { calculateDeliveryDate } from "../../js/utils";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

// Componentes
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import Btn from "../../components/Btn.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SocialShare from "../../components/SocialShare.astro";
import RelatedProducts from "../../components/Pagos/RelatedProducts.astro";
import PreviewModal from "../../components/PreviewModal.astro";
import BeneficioCard from "../../components/BeneficioCard.astro";
import BannerGeneral from "../../components/BannerGeneral.astro";
import Faq from "../../components/Faq.astro";
import MesasHome from "../../components/MesasHome.astro";
import SliderControls from "../../components/SliderControls.astro";
// Datos
import nvitacionesData from "./nvitaciones.json";

const lang = Astro.locals.lang || "es";
const isEn = lang === "en";

const panelTestimonials = isEn ? [
  {
    stars: 5,
    text: "They were wonderful! All our guests loved the interactive experience.",
    author: "— Chris & Sarah / Miami, FL",
  },
  {
    stars: 5,
    text: "The LUX invitation was stunning and everyone RSVP'd on time. Highly recommended!",
    author: "— Sophia & David / Austin, TX",
  },
  {
    stars: 5,
    text: "Loved the LUX design and the customer service was so attentive.",
    author: "— Andrea P. / San Diego, CA",
  },
  {
    stars: 5,
    text: "They guided me throughout the entire process from purchase to sending out my first invite.",
    author: "— Emily Watson / New York, NY",
  },
] : [
  {
    stars: 5,
    text: "Estuvieron excelentes, a todos mis amigos les encantaron",
    author: "— Chucho González / Zihuatanejo Gro.",
  },
  {
    stars: 5,
    text: "La invitación LUX quedó perfecta y todos confirmaron, ¡muy recomendable!",
    author: "— Sofía Martínez / Morelia, Mich.",
  },
  {
    stars: 5,
    text: "Me encantó el diseño LUX y fueron muy atentos.",
    author: "— Andrea P. / Guadalajara, Jal.",
  },
  {
    stars: 5,
    text: "Me ayudaron durante todo el proceso desde la compra hasta que mande mi primer invitación.",
    author: "— Fátima Osorio / CDMX",
  },
];

function getTestimonialIndex(seed: string | undefined, length: number) {
  const normalized = seed || "default";
  return (
    Math.abs(
      normalized
        .split("")
        .reduce((acc, char) => acc * 31 + char.charCodeAt(0), 0),
    ) % length
  );
}

const testimonial =
  panelTestimonials[getTestimonialIndex(slug, panelTestimonials.length)];

// Helper functions for translation
function localizeCategory(cat?: string, l: string = "es") {
  if (!cat) return l === "en" ? "Invitations" : "Sin categoría";
  if (l !== "en") return cat;
  const lower = cat.toLowerCase();
  if (lower.includes("boda")) return "Weddings";
  if (lower.includes("xv") || lower.includes("quince")) return "Quinceañera";
  if (lower.includes("cumple")) return "Birthdays";
  if (lower.includes("bautizo")) return "Baptism";
  if (lower.includes("baby")) return "Baby Shower";
  return cat;
}

function localizeVersion(ver?: string, l: string = "es") {
  if (!ver) return l === "en" ? "Standard" : "Sin versión";
  if (l !== "en") return ver;
  const lower = ver.toLowerCase();
  if (lower.includes("clas")) return "Classic";
  if (lower.includes("esenc")) return "Essential";
  if (lower.includes("lux")) return "Lux";
  return ver;
}

function localizeProductName(name: string, l: string = "es") {
  if (l !== "en") return name;
  return name
    .replace(/Invitaci[oó]n de Bodas?/gi, "Wedding Invitation")
    .replace(/Invitaci[oó]n de XV A[ñn]os?/gi, "Quinceañera Invitation")
    .replace(/Invitaci[oó]n de Quincea[ñn]era/gi, "Quinceañera Invitation")
    .replace(/Invitaci[oó]n/gi, "Invitation")
    .replace(/Cl[aá]sica/gi, "Classic")
    .replace(/Esencial/gi, "Essential");
}

function localizeBeneficio(
  beneficio: { titulo: string; parrafo: string; imaFondo: string },
  isEnglish: boolean,
  isWedding: boolean
) {
  if (!isEnglish) return beneficio;
  
  const titleLower = beneficio.titulo.toLowerCase();
  let titulo = beneficio.titulo;
  let parrafo = beneficio.parrafo;

  if (titleLower.includes("abren") || titleLower.includes("reciben")) {
    titulo = "When they open it";
    parrafo = isWedding
      ? "Your special couple song plays softly, they read your customized animated love quote, and enjoy your romantic photo gallery."
      : "Your favorite soundtrack plays in the background, they read your animated quote, and enjoy your interactive photo gallery.";
  } else if (titleLower.includes("confirman")) {
    titulo = "When they RSVP";
    parrafo = "They confirm attendance in seconds, choose their assigned passes, and everything syncs instantly with your private dashboard.";
  } else if (titleLower.includes("llega") || titleLower.includes("día") || titleLower.includes("dia")) {
    titulo = "When the big day arrives";
    parrafo = isWedding
      ? "They have one-tap GPS navigation to the ceremony and reception, the detailed schedule, dress code, and gift registry right on their phone."
      : "They access the interactive GPS map, celebration timeline, dress code, and gift registry with a single tap.";
  }

  return {
    titulo,
    parrafo,
    imaFondo: beneficio.imaFondo,
  };
}

type LocalizedField = string | { es?: string; en?: string };

// Define the type for nvitacionInfo to include detalles
type NvitacionInfo = {
  id: string;
  precioTachado?: string | boolean; // Make precioTachado optional and accept string or boolean
  slug: string;
  muestra?: LocalizedField;
  nombre?: LocalizedField;
  titulo?: LocalizedField;
  descripcion?: LocalizedField;
  detalles?: LocalizedField;
  beneficios: {
    titulo: string;
    parrafo: string;
    imaFondo: string;
  }[];
  categoria: string;
  tipo: string;
  version: string;
  imagenes: string[];
  video?: string; // Add video property
};

function getLocalizedText(
  field?: LocalizedField,
  l: string = "es",
  fallback: string = ""
): string {
  if (!field) return fallback;
  if (typeof field === "string") return field;
  return (l === "en" ? field.en : field.es) || field.es || field.en || fallback;
}

// Configuración de imágenes
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/cart/**/*.{jpg,jpeg,png,gif,webp}",
  { eager: true },
);

// Helper para verificar si es ImageMetadata
function isImageMetadata(value: any): value is ImageMetadata {
  return (
    value &&
    typeof value === "object" &&
    "src" in value &&
    "width" in value &&
    "height" in value
  );
}

// Función para cargar las imágenes del producto
async function getProductImages(nvitacionInfo: NvitacionInfo | undefined) {
  if (!product) return [];

  try {
    const imagenes = [];

    // Primero añadir la imagen de portada/Stripe si está disponible (poster de video/portada)
    if (product.data.images?.length > 0) {
      imagenes.push(product.data.images[0]);
    }

    // Luego añadir las imágenes detalladas desde nvitacionInfo
    if (nvitacionInfo?.imagenes) {
      for (const imagePath of nvitacionInfo.imagenes) {
        const normalizedPath = imagePath.replace(/\\/g, "/");
        const moduleKey = Object.keys(imageModules).find((key) => {
          const keyLower = key.toLowerCase();
          const pathLower = normalizedPath.toLowerCase();
          return keyLower.endsWith(pathLower.replace("../../assets/", ""));
        });

        if (moduleKey && moduleKey in imageModules) {
          imagenes.push(imageModules[moduleKey].default);
        } else {
          console.error(`No se pudo cargar la imagen: ${imagePath}`);
        }
      }
    }

    return imagenes;
  } catch (error) {
    console.error("Error cargando imágenes:", error);
    return product.data.images || [];
  }
}

// Buscar en nvitaciones.json por slug
const nvitacionInfo: NvitacionInfo | undefined = nvitacionesData.find(
  (item) => item.slug === slug,
);

// Si no encuentra el slug, devolver 404
if (!nvitacionInfo) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

// Obtener el producto de Stripe usando el ID mapeado
const product = await getEntry("productos", nvitacionInfo.id);

// Manejo de 404: Verificar si el producto existe y está activo
if (!product || !product.data.active) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const imagenes = await getProductImages(nvitacionInfo);

const price = await getProductPrice(product, lang);

// Extraer símbolo de moneda y número (soporta decimales y separadores)
const match = price.match(/^([^\d]+)([\d,.]+)/);
let priceTachado = price;
if (match) {
  const currency = match[1];
  // Convertir a número (eliminando comas)
  const priceNumber = Number(match[2].replace(/,/g, ""));
  const priceTachadoNumber = Math.round(priceNumber * 1.4);

  // Formatear con separador de miles y dos decimales
  const priceTachadoStr = priceTachadoNumber.toLocaleString(isEn ? "en-US" : "es-MX", {
    minimumFractionDigits: 0,
  });

  priceTachado = `${currency}${priceTachadoStr}`;
}
const productId = product.data.id;

// Calcular precio por invitado dinámicamente
const numericPrice = Number(price.replace(/,/g, "").replace(/[^\d.]/g, ""));
const costPerGuest = isEn ? (numericPrice / 100).toFixed(2) : Math.round(numericPrice / 100);

const customName = getLocalizedText(nvitacionInfo?.nombre || nvitacionInfo?.titulo, lang);
const displayedName = customName || localizeProductName(product.data.name, lang);

const customDescription = getLocalizedText(nvitacionInfo?.descripcion || nvitacionInfo?.detalles, lang);
const displayedDescription = customDescription || product.data.description || "";

const displayedCategory = localizeCategory(nvitacionInfo?.categoria || (product.data.metadata as Record<string, string> | undefined)?.Categoria, lang);
const displayedVersion = localizeVersion(nvitacionInfo?.version, lang);
const isWedding = (nvitacionInfo?.categoria || "").toLowerCase().includes("boda") || (product?.data?.name || "").toLowerCase().includes("boda");

let previewUrl = getLocalizedText(nvitacionInfo?.muestra, lang);
if (isEn && previewUrl && !previewUrl.includes("lang=")) {
  previewUrl += (previewUrl.includes("?") ? "&" : "?") + "lang=en";
}

// Meta description emocional para SEO
const metaDescription = isEn
  ? `The most complete digital invitation for your celebration — ${price.replace(/\.00$/, "")} · ≈ $${costPerGuest} per guest. Includes music, animated gallery, countdown and live RSVP.`
  : `La invitación digital más completa para tu boda — ${price.replace(/\.00$/, "")} · ≈ $${costPerGuest} por invitado. Con música, galería animada, cuenta regresiva y confirmación en tiempo real. Personalizada a tus colores.`;
---

<Layout
  title=`${displayedName} - ${isEn ? "Digital Invitations" : "Invitación Digitales para tu evento"}`
  description={metaDescription}
  whatsappProduct={displayedName}
  whatsappIconOnly={true}
>
  <div class="grid contenido">
    <Nav />

    <div class="breadcrumb-container">
      <Breadcrumb
        categoria={nvitacionInfo?.tipo === "PDF"
          ? "pdf"
          : displayedCategory.toLowerCase()}
        nombre={displayedName}
      />
    </div>

    <div
      id="producto-conte"
      data-category={nvitacionInfo?.categoria?.toLowerCase() ?? ""}
    >
      <div id="izq">
        <div id="fix">
          <div
            class="gallery-carousel-wrapper"
            id="nv-gallery"
            data-video-url={nvitacionInfo?.video}
          >
            <div class="gallery-carousel-track" id="nv-carousel-track">
              {
                imagenes.map((imagen, index) => (
                  <div
                    class={`gallery-slide ${index === 0 ? "active" : ""}`}
                    data-index={index}
                    data-video-url={
                      index === 0 && nvitacionInfo?.video
                        ? nvitacionInfo.video
                        : undefined
                    }
                  >
                    <div class="slide-media-wrap">
                      {isImageMetadata(imagen) ? (
                        <Image
                          src={imagen}
                          loading={index === 0 ? "eager" : "lazy"}
                          alt={`${product.data.name} - ${index + 1}`}
                          class="gallery-image"
                          quality="max"
                        />
                      ) : (
                        <img
                          src={imagen}
                          loading={index === 0 ? "eager" : "lazy"}
                          alt={`${product.data.name} - ${index + 1}`}
                          class="gallery-image"
                        />
                      )}
                      {index === 0 && nvitacionInfo?.video && (
                        <button
                          id="nv-play"
                          class="video-play"
                          aria-label="Reproducir video"
                        >
                          <Icon name="mdi:play-circle" color="white" size={70} />
                        </button>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>

            <SliderControls count={imagenes.length} id="nv-gallery-controls" />
          </div>
        </div>
      </div>

      <div id="der">
        <div id="titulo">
          <ul class="metadata">
            {
              nvitacionInfo && (
                <>
                  {/* {nvitacionInfo.categoria && (
                    <li>Categoría: {nvitacionInfo.categoria}</li>
                  )} */}
                  {/* {nvitacionInfo.tipo && <li>Tipo: {nvitacionInfo.tipo}</li>} */}
                  {nvitacionInfo.version && (
                    <li>{isEn ? "Version" : "Versión"}: {displayedVersion}</li>
                  )}
                </>
              )
            }
          </ul>
          <!-- <p>{product.data.id}</p> -->
          <h1>{displayedName}</h1>

          <div id="conteVerNvitacion">
            <p>{displayedDescription}</p>
            {
              nvitacionInfo && previewUrl && (
                <>
                  <div class="liga-muestra">
                    <Btn
                      id="preview-btn"
                      liga="#"
                      texto={isEn ? "<b>View</b> Demo Invitation" : "<b>Ver</b> Nvitación demo"}
                      icono="mdi:chevron-right"
                      clases="btn-ver-nvitaciones"
                      claro={false}
                    />
                  </div>
                  <PreviewModal url={previewUrl} />
                </>
              )
            }

          </div>

        </div>

        <div class="buttons-container">
          <!-- Bloque de precio emocional -->
          <div class="price-block">
            <div class="price-header">
              {
                nvitacionInfo?.precioTachado && (
                  <p class="precioTachado">
                    {isEn ? "Was:" : "Antes:"} {priceTachado}
                    <sup>.00</sup>
                  </p>
                )
              }
              <p class="main-price">
                {price.replace(/\.00$/, "")}<sup>.00</sup>
              </p>
            </div>

            <p class="price-anchor-detail">
              <b>{isEn ? `Equivalent to $${costPerGuest} USD` : `Equivale a $${costPerGuest}MXN`}</b> <small>{isEn ? "(estimate for 100 guests)." : "(cálculo x100 personas)."}</small> {isEn ? "The more guests you have, the lower the cost per guest because" : "¡Entre más invitados tengas, más barato porque"} <b>{isEn ? "unlimited sends are included!" : "tus envíos son ilimitados!"}</b>
            </p>

            <Btn
              data-cart
              data-action="buy-now"
              data-productid={product.data.id}
              liga="#"
              clases="btn-claro btn-carrito"
              texto={isEn ? "Get this invitation →" : "Quiero esta invitación →"}
              icono="mdi:cart-check"
              claro={true}
            />
            <!-- <p class="price-note">
              Compra ahora y personaliza tu invitación, con los colores, tipografía, música, fotos y datos de tu evento · Lista en 2 días hábiles 
            </p> -->
            <p id="fecha-estimada">
              <!-- <b>Compra ahora y agenda tu invitación sin preocupaciones.</b>  -->
              {isEn ? "Estimated delivery date:" : "Fecha estimada de entrega:"} {calculateDeliveryDate(2, lang)}
            </p>


            <p class="price-vs">
              <b>{isEn ? "Paper invitations: $4–$6 each" : "Invitación impresa: $40–$70 pesos c/u"}</b> {isEn ? "— no music, no interactive maps, no live RSVP, plus delivery hassle and printing delays." : "— sin música, sin galerías, sin mapa, sin confirmación. Súmale repartirlas una por una: más gasto y tiempo perdido."}
            </p>
          </div>

         
          <!-- <Btn
            data-cart
            data-action="increment"
            data-productid={product.data.id}
            liga="#"
            texto="Guardar en carrito"
            clases="btn-bordes"
            claro={false}
            icono="mdi:cart-plus"
          /> -->

          <div id="ahora"></div>

          <div id="quesucede">
            <input
              type="checkbox"
              id="quesucede-toggle"
              class="quesucede-toggle"
            />
            <label for="quesucede-toggle" class="quesucede-label"
              >{isEn ? "What happens after purchase?" : "¿Qué sucede después de mi compra?"}</label
            >
            <ul class="quesucede-content">
              <li>
                <b>{isEn ? "We contact you" : "Te escribimos"}</b> {isEn ? "promptly with a form to collect your photos and event details" : "a la brevedad y te enviamos un formulario para recopilar las fotos y detalles de tu evento"}
              </li>
              <li>
                <b>{isEn ? "You get instant access" : "Obtienes acceso"}</b> {isEn ? "to your guest dashboard to manage RSVPs and seating tables." : "a tu panel de invitados para generar y gestionar todas tus invitaciones."} <small>
                  <b>{isEn ? "Included in Classic and Lux" : "Aplica en 'Clásica' y 'Lux'"}</b>
                </small>
              </li>
              <li>
                <b>{isEn ? "Review your custom invitation" : "Revisas tu invitación personalizada"}</b> {isEn ? "and request changes with up to 2 rounds of edits" : "y puedes solicitar cambios hasta en 2 rondas de ajustes"}
              </li>
            </ul>
          </div>

           <div class="panel-testimonial">
            {
              panelTestimonials.map((t, index) => {
                const isDefault =
                  index === getTestimonialIndex(slug, panelTestimonials.length);
                return (
                  <div
                    class="testimonial-item"
                    data-index={index}
                    style={isDefault ? "display: block;" : "display: none;"}
                  >
                    <div class="stars">
                      {Array.from({ length: t.stars }).map(() => (
                        <Icon name="solar:star-bold" class="star-icon" />
                      ))}
                    </div>
                    <p class="testimonial-text">{t.text}</p>
                    <span class="testimonial-author">{t.author}</span>
                  </div>
                );
              })
            }
          </div>

          
          <a id="terminos" href="/terminos-condiciones"
            >{isEn ? "View terms & conditions" : "ver terminos y condiciones"}</a
          >
          <SocialShare
            url={Astro.url.toString()}
            title={isEn ? `Check out this invitation on Nvitaciones.com: ${displayedName}` : `Mira esta ${nvitacionInfo?.tipo || "invitación"} en Nvitaciones.com: ${displayedName}`}
          />
        </div>

        <div id="datosjson">
          {
            nvitacionInfo && nvitacionInfo.beneficios && (
              <div class="beneficios-conte">
                {nvitacionInfo.beneficios.map((beneficio) => {
                  const loc = localizeBeneficio(beneficio, isEn, isWedding);
                  return (
                    <BeneficioCard
                      titulo={loc.titulo}
                      parrafo={loc.parrafo}
                      imaFondo={loc.imaFondo}
                    />
                  );
                })}
              </div>
            )
          }

          <!-- NUEVA sección: por qué vale lo que vale -->
          <div class="value-section">
            <h4>
              {isEn ? `What $${costPerGuest} gives to each of your guests` : `Lo que $${costPerGuest} pesos le dan a cada uno de tus invitados`}
            </h4>
            <ul class="value-list">
              <li>
                <b>{isEn ? "Their name on the invite" : "Su nombre en la invitación"}</b> {isEn ? "— personalized, not a generic card" : "— no es una tarjeta masiva"}
              </li>
              <li>
                <b>{isEn ? "Your favorite song" : "Tu música"}</b> {isEn ? "playing automatically as they open it" : "sonando cuando la abren"}
              </li>
              <li><b>{isEn ? "Animated photo gallery" : "Tus fotos, animadas"}</b>{isEn ? ", before reading a single line" : ", antes de leer un solo detalle"}</li>
              <li>
                <b>{isEn ? "Detailed celebration timeline" : "Itinerario detallado"}</b> {isEn ? "for your event" : "de tu evento"}
              </li>
              <li>
                <b>{isEn ? "Personalized message" : "Mensaje personalizado"}</b> {isEn ? "for special VIP guests" : "para invitados especiales"}
              </li>
              <li><b>{isEn ? "RSVP in real time" : "Confirman"}</b> {isEn ? "directly from their phone" : "asistencia en ese mismo momento"}</li>
              <li><b>{isEn ? "GPS map" : "Un mapa"}</b> {isEn ? "guiding them straight to the venue" : "que los lleva directo al lugar"}</li>
              <li>
                <b>{isEn ? "An invitation kept" : "Una invitación que"}</b> {isEn ? "on their smartphone, not lost in a drawer" : "guardan en su teléfono — no en un cajón"}
              </li>
              <li>
                <b>{isEn ? "Lodging suggestions" : "Si tus invitados viajan"}</b>{isEn ? " for out-of-town guests" : ", les recomiendas hospedaje"}
              </li>
              <li class="enfasis">
                <b>{isEn ? "And for you" : "Y para tí"}</b>, {isEn ? "a private guest & table seating dashboard that saves you hours of stress." : "un panel privado para organizar a tus invitados y las mesas de tu evento, lo que te ahorrará horas de trabajo y estrés."}
              </li>
            </ul>
          </div>

          {
            /* Si el producto tiene "video" lo manejamos en la galería principal como poster + play */
          }
        </div>
      </div>
    </div>
  </div>
 <MesasHome />
  <div class="grid contenido">
    <BannerGeneral
      encabezado={isEn ? "What you receive with your <b>Nvitación</b>" : "Recibes con tu <b>Nvitación</b>"}
      texto={isEn ? `
    <ul>
    <li><b>Dedicated 1-on-1 support.</b></li>
    <li>Your invitation ready in <b>2 business days</b> after submitting details.</li>
    <li><b>Guest Management Dashboard</b> to control RSVPs and seating.</li>
    <li><b>Web invitation remains active</b> throughout the planning and 1 week post-event.</li>
    <li><mark>Unlimited sends.</mark></li>
    </ul>
    <small>*Guest dashboard included in "Classic and Lux" versions</small>
    <br>
    ` : `
    <ul>
    <li><b>Trato personalizado.</b></li>
    <li>Tu invitación,<b> 2 días hábiles</b> después del envío de tus datos.</li>
    <li>
   <b>Panel de invitados</b>, controla tus invitaciones.
    </li>
    <li>
    <b>Tu invitación web te acompaña</b> durante todo el proceso y permanece disponible hasta la semana posterior al evento.
    </li>
    <li><mark>Envíos ilimitados.</mark></li>
       
        </ul>
        <small>*Panel de invitados exclusivo de la versión "Lux y Clásica"</small>
        <br>
        `}
      tema="secundario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/recibes.webp"
      margenAbajo={true}
    >
    </BannerGeneral>
  </div>


  <div class="grid contenido otrosProductos">
    <RelatedProducts
      currentProductId={product.id}
      category={nvitacionInfo?.categoria ||
        (product.data.metadata as Record<string, string> | undefined)
          ?.Categoria ||
        ""}
    />
  </div>

  <Faq />
  <Footer />

  <!-- Barra de compra sticky en móvil -->
  <div class="mobile-sticky-bar" id="mobile-sticky-bar">
    <div class="mobile-sticky-bar-content">
      <Btn
        data-cart
        data-action="buy-now"
        data-productid={product.data.id}
        liga="#"
        clases="btn-claro btn-carrito mobile-sticky-btn"
