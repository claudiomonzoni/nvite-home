</style>

<script>
  import { generateRandomSales } from "../../js/utils";

  class ProductPage {
    private initialized = false;

    constructor() {
      // Inicializar cuando el documento esté listo y al navegar con Astro viewTransitions
      document.addEventListener("astro:page-load", () => {
        this.initialized = false;
        this.init();
      });
      if (document.readyState === "complete") {
        this.init();
      } else {
        document.addEventListener("DOMContentLoaded", () => this.init());
      }
    }

    init() {
      if (this.initialized) return;
      this.initialized = true;

      this.initializeSalesMessage();
      this.initializeBuyNowButtons();
      this.initializeGallery();
      this.initializePreviewModal();
      this.initializeRandomTestimonial();
      this.initializeMobileStickyBar();
    }

    // Seleccionar un testimonio aleatorio al cargar la página
    initializeRandomTestimonial() {
      const items = document.querySelectorAll(".testimonial-item");
      if (items.length === 0) return;

      // Ocultar todos
      items.forEach((item) => {
        (item as HTMLElement).style.display = "none";
      });

      // Mostrar uno aleatorio
      const randomIndex = Math.floor(Math.random() * items.length);
      (items[randomIndex] as HTMLElement).style.display = "block";
    }

    // Manejo de ventas aleatorias
    initializeSalesMessage() {
      if (document.getElementById("vendidos")) return;

      const productId = document
        .querySelector("[data-productid]")
        ?.getAttribute("data-productid");

      if (!productId) return;

      const cookieKey = `sales_${productId}`;
      const existingNumber = document.cookie
        .split(";")
        .find((c) => c.trim().startsWith(`${cookieKey}=`))
        ?.split("=")[1];

      let salesNumber = existingNumber
        ? parseInt(existingNumber)
        : generateRandomSales();

      if (!existingNumber) {
        const expires = new Date();
        expires.setDate(expires.getDate() + 7);
        document.cookie = `${cookieKey}=${salesNumber};expires=${expires.toUTCString()};path=/`;
      }

      if (salesNumber > 0) {
        const productContainer = document.getElementById("producto-conte");
        const category = (
          productContainer?.dataset?.category || ""
        ).toLowerCase();

        let subject = "parejas";
        if (category.includes("quince")) {
          subject = "quinceañeras";
        } else if (category.includes("boda") || category.includes("bodas")) {
          subject = "parejas";
        }

        const vendidosDiv = document.createElement("p");
        vendidosDiv.id = "vendidos";
        vendidosDiv.innerHTML = `<b>${salesNumber} ${subject} han confiado en esta invitación en los últimos 3 meses.</b>`;

        const conteVerNvitacion = document.getElementById("conteVerNvitacion");
        if (conteVerNvitacion?.parentNode) {
          conteVerNvitacion.insertAdjacentElement("afterend", vendidosDiv);
        } else {
          const descriptionP =
            document.querySelector("#precio + p") ||
            document.querySelector("#titulo p");
          if (descriptionP && descriptionP.parentNode) {
            descriptionP.parentNode.insertBefore(
              vendidosDiv,
              descriptionP.nextSibling,
            );
          } else {
            const precio = document.getElementById("precio");
            if (precio && precio.parentNode) {
              precio.parentNode.insertBefore(vendidosDiv, precio);
            } else {
              const titulo = document.getElementById("titulo");
              titulo?.appendChild(vendidosDiv);
            }
          }
        }
      }
    }

    // Manejo de galería de imágenes y video (implementación robusta)
    // Esta función inicializa la galería, el poster principal y el video.
    // Se destruye cualquier instancia previa para que funcione correctamente
    // con las transiciones de Astro (viewTransitions / SPA navigation).
    initializeGallery() {
      const GKEY = "__NV_GALLERY__";
      try {
        (window as any)[GKEY]?.destroy?.();
      } catch (e) {}

      const root = document.getElementById("nv-gallery");
      if (!root) return;

      const track = root.querySelector("#nv-carousel-track") as HTMLElement | null;
      const slides = Array.from(root.querySelectorAll(".gallery-slide")) as HTMLElement[];
      const controls = root.querySelector("#nv-gallery-controls") as HTMLElement | null;
      const videoPlayBtn = root.querySelector("#nv-play") as HTMLButtonElement | null;
      const videoUrl = root.getAttribute("data-video-url");

      if (!track || !slides.length || !controls) return;

      const playBtn = controls.querySelector(".play-btn") as HTMLButtonElement | null;
      const playIcon = playBtn?.querySelector(".play-icon");
      const pauseIcon = playBtn?.querySelector(".pause-icon");
      const replayIcon = playBtn?.querySelector(".replay-icon");
      const segments = Array.from(controls.querySelectorAll(".pill-segment")) as HTMLElement[];

      let currentIndex = 0;
      let isPlaying = false;
      let finished = false;
      let slideDuration = 5000;
      let raf: number | null = null;
      let slideStartTime = 0;
      let videoEl: HTMLVideoElement | null = null;

      const updatePlayPauseIcon = () => {
        if (isPlaying) {
          replayIcon?.classList.add("hidden");
          playIcon?.classList.add("hidden");
          pauseIcon?.classList.remove("hidden");
        } else {
          pauseIcon?.classList.add("hidden");
          if (finished) {
            playIcon?.classList.add("hidden");
            replayIcon?.classList.remove("hidden");
          } else {
            replayIcon?.classList.add("hidden");
            playIcon?.classList.remove("hidden");
          }
        }
      };

      const updateSegments = (index: number, progressPct: number = 0) => {
        segments.forEach((el, idx) => {
          const progressEl = el.querySelector(".segment-progress") as HTMLElement | null;
          if (idx === index) {
            el.classList.add("active-segment");
            if (progressEl) progressEl.style.width = Math.round(progressPct) + "%";
          } else {
            el.classList.remove("active-segment");
            if (progressEl) progressEl.style.width = "0%";
          }
        });
      };

      const isMobileView = () => window.matchMedia("(max-width: 768px)").matches;

      const coverImg = slides[0]?.querySelector(".gallery-image") as HTMLElement | null;

      const destroyVideo = () => {
        if (videoEl) {
          try { videoEl.pause(); } catch(e) {}
          videoEl.remove();
          videoEl = null;
        }
        const mediaWrap = slides[0]?.querySelector(".slide-media-wrap");
        if (mediaWrap) {
          const existingVideos = mediaWrap.querySelectorAll("video");
          existingVideos.forEach((v) => v.remove());
        }
        if (coverImg) coverImg.style.display = "";
        if (videoPlayBtn) videoPlayBtn.style.display = "flex";
      };

      const goToSlide = (index: number) => {
        if (index < 0 || index >= slides.length) return;

        if (index !== 0) destroyVideo();

        slides[currentIndex]?.classList.remove("active");
        currentIndex = index;
        slides[currentIndex]?.classList.add("active");

        updateSegments(currentIndex, 0);

        if (isMobileView()) {
          const targetSlide = slides[currentIndex];
          if (targetSlide) {
            const scrollLeftPos = targetSlide.offsetLeft - 16;
            track.scrollTo({ left: scrollLeftPos, behavior: "smooth" });
          }
        } else {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }

        if (isPlaying) {
          slideStartTime = performance.now();
        }
      };

      const pause = () => {
        isPlaying = false;
        updatePlayPauseIcon();
        if (raf !== null) {
          cancelAnimationFrame(raf);
          raf = null;
        }
      };

      const tick = (ts: DOMHighResTimeStamp) => {
        if (!isPlaying) return;
        const elapsed = ts - slideStartTime;
        const progress = Math.min(elapsed / slideDuration, 1);
        updateSegments(currentIndex, progress * 100);

        if (progress >= 1) {
          if (currentIndex === slides.length - 1) {
            finished = true;
            pause();
            return;
          }
          goToSlide(currentIndex + 1);
          slideStartTime = performance.now();
        }
        raf = requestAnimationFrame(tick);
      };

      const play = () => {
        if (isPlaying) return;
        if (finished) {
          finished = false;
          goToSlide(0);
        }
        isPlaying = true;
        updatePlayPauseIcon();
        slideStartTime = performance.now();
        raf = requestAnimationFrame(tick);
      };

      const togglePlayPause = () => {
        if (isPlaying) pause();
        else play();
      };

      playBtn?.addEventListener("click", togglePlayPause);

      const segmentClickHandlers: Array<{ el: HTMLElement; handler: (e: Event) => void }> = [];
      segments.forEach((seg, idx) => {
        const handler = (e: Event) => {
          e.stopPropagation();
          goToSlide(idx);
        };
        seg.addEventListener("click", handler);
        segmentClickHandlers.push({ el: seg, handler });
      });

      let scrollTimeout: any = null;

      const handleTrackScroll = () => {
        if (!isMobileView()) return;
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const slideWidth = slides[0]?.offsetWidth || 1;
          const gap = 12;
          const newIndex = Math.round(track.scrollLeft / (slideWidth + gap));
          if (newIndex >= 0 && newIndex < slides.length && newIndex !== currentIndex) {
            slides[currentIndex]?.classList.remove("active");
            currentIndex = newIndex;
            slides[currentIndex]?.classList.add("active");
            updateSegments(currentIndex, 0);
            if (currentIndex !== 0) destroyVideo();
          }
        }, 80);
      };

      track.addEventListener("scroll", handleTrackScroll, { passive: true });

      const handleVideoPlayClick = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        pause();
        destroyVideo();

        videoEl = document.createElement("video");
        videoEl.src = videoUrl!;
        videoEl.controls = true;
        videoEl.autoplay = true;
        videoEl.playsInline = true;
        videoEl.style.width = "100%";
        videoEl.style.height = "auto";
        videoEl.style.borderRadius = "12px";

        const mediaWrap = slides[0]?.querySelector(".slide-media-wrap");
        if (mediaWrap) {
          if (coverImg) coverImg.style.display = "none";
          if (videoPlayBtn) videoPlayBtn.style.display = "none";
          mediaWrap.appendChild(videoEl);
        }

        videoEl.addEventListener("ended", () => {
          destroyVideo();
        });
      };

      if (videoPlayBtn && videoUrl) {
        videoPlayBtn.addEventListener("click", handleVideoPlayClick);
      }

      (window as any)[GKEY] = {
        destroy() {
          pause();
          destroyVideo();
          track.removeEventListener("scroll", handleTrackScroll);
          playBtn?.removeEventListener("click", togglePlayPause);
          if (videoPlayBtn) videoPlayBtn.removeEventListener("click", handleVideoPlayClick);
          segmentClickHandlers.forEach(({ el, handler }) => el.removeEventListener("click", handler));
          try { delete (window as any)[GKEY]; } catch(e) {}
        }
      };

      goToSlide(0);
      updatePlayPauseIcon();
    }

    // Manejo de botones de compra
    initializeBuyNowButtons() {
      const buyNowButtons = document.querySelectorAll(
        '[data-action="buy-now"]',
      );
      buyNowButtons.forEach((button) =>
        button.addEventListener("click", this.handleBuyNow),
      );
    }

    private handleBuyNow(event: Event) {
      event.preventDefault();
      const button = event.currentTarget as HTMLElement;
      const productId = button.getAttribute("data-productid");
      if (!productId) return;

      const cartItems = this.getCartItemsFromCookie();
      if (!cartItems.includes(productId)) {
        cartItems.push(productId);
        document.cookie = `cartItems=${JSON.stringify(cartItems)};path=/;max-age=31536000`;
        document.dispatchEvent(new CustomEvent("cart:updated"));
      }

      window.location.href = "/nvitaciones/checkout";
    }

    private getCartItemsFromCookie(): string[] {
      const cookie = document.cookie
        .split(";")
        .find((c) => c.trim().startsWith("cartItems="))
        ?.split("=")[1];

      return cookie ? JSON.parse(cookie) : [];
    }

    // Manejo del modal de previsualización
    initializePreviewModal() {
      const previewBtn = document.getElementById("preview-btn");
      const modal = document.getElementById("preview-modal");
      const closeBtn = modal?.querySelector(".close-btn");
      const backdrop = modal?.querySelector(".modal-backdrop");

      const openModal = () => {
        // Si es dispositivo móvil (teléfono), abrir en una pestaña nueva.
        const isMobile = window.matchMedia("(max-width: 768px)").matches;
        const urlAttr = modal?.getAttribute("data-url");
        if (isMobile && urlAttr) {
          try {
            window.open(urlAttr, "_blank");
          } catch (e) {
            // Fallback: navegar en la misma pestaña
            window.location.href = urlAttr;
          }
          return;
        }

        // En tablet o escritorio, abrir en modal con iframe (comportamiento actual)
        modal?.classList.add("active");
        document.body.style.overflow = "hidden";
        modal?.dispatchEvent(new CustomEvent("modal:open"));
      };

      const closeModal = () => {
        modal?.classList.remove("active");
        document.body.style.overflow = "";
        modal?.dispatchEvent(new CustomEvent("modal:close"));
      };

      previewBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });

      closeBtn?.addEventListener("click", closeModal);
      backdrop?.addEventListener("click", closeModal);
    }

    // Inicializa la barra de compra flotante en móvil con IntersectionObserver
    initializeMobileStickyBar() {
      // Limpiar clase de transiciones previas
      document.body.classList.remove("has-mobile-sticky-bar");

      const priceBlock = document.querySelector(".price-block");
      const stickyBar = document.getElementById("mobile-sticky-bar");
      if (!priceBlock || !stickyBar) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            // Solo mostramos la barra flotante si el bloque de precio NO es visible
            // Y además ha salido por la parte superior de la pantalla (top < 0)
            const isScrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
            if (isScrolledPast) {
              stickyBar.classList.add("show");
              document.body.classList.add("has-mobile-sticky-bar");
            } else {
              stickyBar.classList.remove("show");
              document.body.classList.remove("has-mobile-sticky-bar");
            }
          });
        },
        {
          rootMargin: "0px 0px -60px 0px", // Margen de anticipación
        }
      );

      observer.observe(priceBlock);
    }
  }

  // Inicializar la página
  new ProductPage();
</script>
