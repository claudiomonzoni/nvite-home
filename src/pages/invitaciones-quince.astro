---
import { Icon } from "astro-icon/components";
import Btn from "../components/Btn.astro";
import Caracteristicas from "../components/Caracteristicas.astro";
import Hero from "../components/HeroNuevo.astro";
import Layout from "../layouts/Layout.astro";
import BannerGeneral from "../components/BannerGeneral.astro";
import Footer from "../components/Footer.astro";
import CaracteristicasGrid from "../components/CaracteristicasGrid.astro";
import Banner from "../components/Banner.astro";
import Ofertashome from "../components/Ofertashome.astro";
import MostrarNvitaciones from "../components/Pagos/MostrarNvitaciones.astro";
import quinceCaracteristicasImg from "../assets/quince/quince-caracteristicas.webp";

import coverDesktopQuince from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel-intQuince.webp";
import coverMobileQuince from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel-intQuince-cel.webp";
import Cardcuadro from "../components/Cardcuadro.astro";
import MesasHome from "../components/MesasHome.astro";
import Faq from "../components/Faq.astro";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);

const schemaQuinceService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Invitaciones Digitales de XV Años con RSVP y Gestor de Mesas",
  "serviceType": "Diseño de Invitaciones de Quinceañera",
  "description": "Diseño profesional de invitaciones digitales de XV años en todo México. Confirmación RSVP por WhatsApp, pases digitales con QR, gestor de mesas y proveedores.",
  "provider": {
    "@type": "ProfessionalService",
    "name": "Nvitaciones",
    "url": "https://nvitaciones.com"
  },
  "areaServed": {
    "@type": "Country",
    "name": "México"
  }
};
---

<Layout
  title={t('quince.meta.title')}
  description={t('quince.meta.description')}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaQuinceService)} />
  <div class="grid contenido"></div>

  <Hero
    h1={t('quince.hero.h1')}
    p={t('quince.hero.p')}
    textoValidacion={t('landing.hero.validation')}
    imagenDesktop={coverDesktopQuince}
    imagenMobile={coverMobileQuince}
  />

  <div class="grid contenido">
    <div id="choro">
      <h2>{t('quince.intro.h2')}</h2>
      <p set:html={t('quince.intro.p')} />
    </div>
  </div>

  <div id="nvitaciones">
    <MostrarNvitaciones dondeEstoy="quince" />
  </div>

  <CaracteristicasGrid
    matriz={[
      {
        imagen: quinceCaracteristicasImg,
        titulo: lang === 'en' ? "Personalized <span>Invitations</span>" : "Invitaciones <span>personalizadas</span>",
        texto: lang === 'en'
          ? "The invitation carries each person's name — friends, family, classmates. Every invite feels deeply personal from the very first glance."
          : "La invitación lleva el nombre de cada quien — sus amigas, su familia, sus compañeras. Cada invitación llega personal y sentida, antes de que lean una sola línea.",
        enlace: "#precios",
      },
      {
        imagen: "mdi:email-check",
        titulo: lang === 'en' ? "Attendance Confirmation" : "Confirmación de asistencia",
        texto: lang === 'en' ? "Keep control of attendees and make RSVP confirmation effortless for your guests." : "Ten control de los asistentes a tu evento, facilítales a tus invitados su confirmación.",
        enlace: "#",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? "Unlimited invitations, send them to all your friends and loved ones." : "Invitaciones ilimitadas, envíalas a todos tus amigos y seres queridos.",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? "With <span>all the essential info</span> for your Quinceañera" : "Con <span>toda la información</span> necesaria de tus 15 años",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? "<span>Zero</span> stress sending invitations" : "<span>Cero</span> estrés enviando invitaciones",
      },
    ]}
  />

  <MesasHome />

  <div id="precios" class="grid contenido">
    <Banner dondeEstoy="quince" />
  </div>

  <section class="grid contenido">
    <div class="flex">
      <Cardcuadro
        titulo={t('bodas.card.lodging.title')}
        description={t('bodas.card.lodging.desc')}
        fondo="/hospedaje.webp"
        icono="mdi:hotel-outline"
      />
      <Cardcuadro
        titulo={t('bodas.card.confirmed.title')}
        description={t('bodas.card.confirmed.desc')}
        fondo="/confirmando.webp"
        icono="mdi:account-arrow-right-outline"
      />
      <Cardcuadro
        titulo={t('bodas.card.qr.title')}
        description={t('bodas.card.qr.desc')}
        fondo="/qr-nvitaciones-3.webp"
        icono="mdi:qrcode"
      />
    </div>
    <BannerGeneral
      encabezado={t('bodas.banner1.heading')}
      texto={t('bodas.banner1.text')}
      tema="primario azul"
      icono="mdi:archive-clock-outline"
      urlImagen="../assets/home/gale/confirmacion.webp"
    />
    <BannerGeneral
      encabezado={t('bodas.banner2.heading')}
      texto={t('bodas.banner2.text')}
      tema="secundario "
      icono="mdi:music"
      izquierda={true}
      urlImagen="../assets/home/gale/musica.webp"
    />

    <BannerGeneral
      encabezado={t('bodas.banner3.heading')}
      texto={t('bodas.banner3.text')}
      tema="primario"
      icono="mdi:image-plus"
      urlImagen="../assets/home/gale/frase.webp"
    />
  </section>

  <div class="grid contenido">
    <BannerGeneral
      encabezado={t('landing.bannerGeneral.heading')}
      texto={t('landing.bannerGeneral.text')}
      tema="terciario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/recibes.webp"
      margenAbajo={true}
    >
      <Btn
        liga="#formu"
        texto={lang === 'en' ? "Get free demo →" : "Quiero mi ejemplo gratis →"}
        clases="btn-oscuro"
        claro={true}
        blank={false}
      >
        <Icon name="bag" size={25} />
      </Btn>
    </BannerGeneral>
  </div>

  <section class="grid contenido">
    <div id="conteCaracteristicas">
      <Caracteristicas
        encabezado={t('landing.guarantee.title')}
        texto={t('landing.guarantee.text')}
        icono="mdi:shield-crown-outline"
        fondo="/fondo-nvite-caracteristicas.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.delivery.title')}
        texto={t('landing.delivery.text')}
        icono="mdi:package-variant-closed-delivered"
        fondo="/fondo-nvite-caracteristicas-2.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.changes.title')}
        texto={t('landing.changes.text')}
        icono="mdi:connect-without-contact"
        fondo="fondo-nvite-caracteristicas-3.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.support.title')}
        texto={t('landing.support.text')}
        icono="mdi:support"
        fondo="fondo-nvite-caracteristicas-4.png"
        colorBg="#FFF1E1"
      />
    </div>
  </section>

  <div class="grid contenido" id="faq">
    <Faq />
  </div>

  <section class="grid contenido" id="formulario">
    <div class="flex">
      <div class="fondo-formu">
        <div class="bande">
          <h3>{lang === 'en' ? 'Try your Invitation with zero commitment' : 'Prueba tu Nvitación sin compromiso'}</h3>
          <p set:html={t('landing.form.desc')} />
        </div>

        <div id="formu">
          <form>
            <label for="nombre">{t('landing.form.name')}</label>
            <input type="text" id="nombre" placeholder={t('landing.form.namePlaceholder')} />
            <label for="fecha">{t('landing.form.date')}</label>
            <input type="date" name="fecha" id="fecha" />
            <label for="evento">{t('landing.form.type')}</label>
            <select name="evento" id="evento">
              <option value="Boda">{t('landing.form.boda')}</option>
              <option value="Xv">{t('landing.form.quince')}</option>
              <option value="Cumple">{lang === 'en' ? 'Birthday' : 'Cumpleaños'}</option>
            </select>

            <Btn
              liga="#"
              id="empezar"
              texto={t('landing.form.send')}
              clases="desactivado, btn-oscuro"
              claro={false}
              blank={true}
            >
              <Icon name="mdi:whatsapp" />
            </Btn>
          </form>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  .intro {
    line-height: 1.1em;
    text-align: center;
    font-size: clamp(1.3rem, 1.7vw, 2.7rem);
    margin: $margen $margen-min;
  }
  #colores {
    padding-top: $margen;
    text-align: center;
    padding-bottom: $margen;
    h2 {
      color: $primario;
      b {
        color: $acento;
      }
    }
  }
  #bandejacolor {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: $margen-cel;
    h3 {
      color: $acento;
      padding: 0 0 $margen-min 0;
      border-bottom: dashed 0.1rem $terciario;
    }
    .item {
      padding: $margen;
      @include cel {
        padding: 0;
      }
    }
  }
</style>

<script>
  const mivideoquince = document.getElementById(
    "video-quince-cel",
  ) as HTMLVideoElement;
  const play = document.getElementById("play") as HTMLDivElement;

  if (play && mivideoquince) {
    play.addEventListener("click", playPause);
  }

  function playPause() {
    if (mivideoquince) {
      if (mivideoquince.paused) mivideoquince.play();
      else mivideoquince.pause();
    }
  }
</script>
