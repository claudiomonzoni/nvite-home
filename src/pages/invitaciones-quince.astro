---
export const prerender = true;
import { Icon } from "astro-icon/components";
import Btn from "../components/Btn.astro";
import Caracteristicas from "../components/Caracteristicas.astro";
import Hero from "../components/HeroNuevo.astro";
import Layout from "../layouts/Layout.astro";
import BannerGeneral from "../components/BannerGeneral.astro";
import Footer from "../components/Footer.astro";
import CaracteristicasGrid from "../components/CaracteristicasGrid.astro";
import Banner from "../components/Banner.astro";
import Ofertashome from "../components/Ofertashome.astro";
import MostrarNvitaciones from "../components/Pagos/MostrarNvitaciones.astro";
import quinceCaracteristicasImg from "../assets/quince/quince-caracteristicas.webp";

import coverDesktopQuince from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel-intQuince.webp";
import coverMobileQuince from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel-intQuince-cel.webp";
import Cardcuadro from "../components/Cardcuadro.astro";
---

<Layout
  title="Invitaciones Digitales de XV Años con RSVP | Nvitaciones México"
  description="Invitaciones digitales para XV años en México. Desde $20 por invitada — con su canción, su galería y su nombre en cada invitación. Confirmación automática. Lista en 2 días hábiles."
>
  <div class="grid contenido"></div>

  <Hero
    h1='Invitaciones digitales </br>de <b>Xv años </b> </br> <span id="spanHeroH1">El día más especial de su vida, merece la invitación perfecta. </span>'
    p='<span id="pHero">Sus invitadas abren su invitación desde WhatsApp y confirman con un clic.</span> Tú sabes en tiempo real quién va a festejarla.'
    textoValidacion="Más de <b>23,788</b> invitaciones enviadas en México"
    imagenDesktop={coverDesktopQuince}
    imagenMobile={coverMobileQuince}
  />

  <div class="grid contenido">
    <div id="choro">
      <h2>Invitaciones que enamoran a primera vista</h2>

      <p>
        Un día planeado con tanto amor merece el mejor comienzo. Tu invitación
        digital es la primera experiencia de los invitados; hazla tan hermosa
        como la fiesta misma.
      </p>
    </div>
  </div>

  <div id="nvitaciones">
    <MostrarNvitaciones dondeEstoy="quince" />
  </div>



  <CaracteristicasGrid
    matriz={[
      {
        imagen: quinceCaracteristicasImg,
        titulo: "Invitaciones <span>personalizadas</span>",
        texto:
          "La invitación lleva el nombre de cada quien — sus amigas, su familia, sus compañeras. Cada invitación llega personal y sentida, antes de que lean una sola línea.",
        enlace: "#precios",
      },
      {
        imagen: "mdi:email-check",
        titulo: "Confirmación de asistencia",
        texto:
          "Ten control de los asistentes a tu evento, facilítales a tus invitados su confirmación.",
        enlace: "#",
      },
      {
        imagen: "mdi:infinity-box",
        texto:
          "Invitaciones ilimitadas, envíalas a todos tus amigos y seres queridos.",
      },
      {
        imagen: "mdi:infinity-box",
        texto: "Con <span>toda la información</span> necesaria de tus 15 años",
      },
      {
        imagen: "mdi:infinity-box",
        texto: "<span>Cero</span> estrés enviando invitaciones",
      },
    ]}
  />



  <div id="precios" class="grid contenido">
    <Banner dondeEstoy="quince" />
  </div>

  <section class="grid contenido">
      <div class="flex">
   <Cardcuadro
      titulo="Recomendación de <b>hospedaje</b>"
      description="<b>¿Tus invitados viajan?</b> Dales sugerencias de hospedaje y aprovecha los descuentos hoteleros con tus invitados."
      fondo="/hospedaje.webp"
      icono="mdi:hotel-outline"
    />
    <Cardcuadro
    titulo="Porcentaje de <b>confirmados</b>"
    description="<b>Empuja a confirmar a los rezagados</b> aprovechado el empuje que da mostrar, que todos van."
    fondo="/confirmando.webp"
    icono="mdi:account-arrow-right-outline"
    />
    <Cardcuadro
       titulo="Pases <b>QR</b>"
       description="<b>Al confirmar</b> tus invitados, tendrán un código QR para una entrada sin contratiempos a tu evento."
       fondo="/qr-nvitaciones-3.webp"
       icono="mdi:qrcode"
     />
  </div>
    <BannerGeneral
      encabezado="Confirmación de asistencia"
      texto="Tus invitados sabrán exactamente cuántos días faltan para el evento y desde la invitación podrán <b>confirmar su asistencia</b>"
      tema="primario azul"
      icono="mdi:archive-clock-outline"
      urlImagen="../assets/home/gale/confirmacion.webp"
    >
    </BannerGeneral>
    <BannerGeneral
      encabezado="Invitación digital con Música"
      texto="Agrega <b>tu canción favorita</b> y los detalles de tu evento"
      tema="secundario "
      icono="mdi:music"
      izquierda={true}
      urlImagen="../assets/home/gale/musica.webp"
    />

    <BannerGeneral
      encabezado="Invitación digital con Frase de amor y galería de fotos"
      texto="Expresa con palabras lo que sientes en una <b>frase animada</b> y muestra hasta 6 fotos en una galería de imágenes"
      tema="primario"
      icono="mdi:image-plus"
      urlImagen="../assets/home/gale/frase.webp"
    />

    /
  


  </section>

    <div class="grid contenido">
    <BannerGeneral
      encabezado="Recibes con tu <b>Nvitación</b>"
      texto={`
    <ul>
    <li><b>Trato personalizado.</b></li>
    <li>Tu invitación,<b> 2 días hábiles</b> después del envío de tus datos.</li>
    <li>
   <b>Panel de invitados</b>, controla tus invitaciones.
    </li>
    <li>
<b>Tu invitación web te acompaña</b> durante todo el proceso y permanece disponible hasta la semana posterior al evento.
    </li>
    <li><mark>Envíos ilimitados.</mark></li>
       
        </ul>
        <small>*Panel de invitados no aplica en la versión "basic"</small>
        <br>
        `}
      tema="terciario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/recibes.webp"
      margenAbajo={true}
    >
      <Btn
        liga="#formu"
        texto="Quiero mi ejemplo gratis →"
        clases="btn-oscuro"
        claro={true}
        blank={false}
      >
        <Icon name="bag" size={25} />
      </Btn>
    </BannerGeneral>
  </div>
  

  
  <section class="grid contenido">
    <div id="conteCaracteristicas">
      <Caracteristicas
        encabezado="garantía"
        texto="Tu invitación <b>siempre en línea.</b>"
        icono="mdi:shield-crown-outline"
        fondo="/fondo-nvite-caracteristicas.png"
        colorBg="#FFF1E1"
        ;
      />

      <Caracteristicas
        encabezado="entrega"
        texto="En 48 horas <b>o menos.</b>"
        icono="mdi:package-variant-closed-delivered"
        fondo="/fondo-nvite-caracteristicas-2.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado="cambios"
        texto="Ajustes <b>sin complicaciones</b>."
        icono="mdi:connect-without-contact"
        fondo="fondo-nvite-caracteristicas-3.png"
        colorBg="#FFF1E1"
        ;
      />

      <Caracteristicas
        encabezado="soporte"
        texto="Te guiamos <b>paso a paso.</b>"
        icono="mdi:support"
        fondo="fondo-nvite-caracteristicas-4.png"
        colorBg="#FFF1E1"
      />
    </div>
  </section>

  <section class="grid contenido" id="formulario">
    <div class="flex">
      <div class="fondo-formu">
        <div class="bande">
          <h3>Prueba tu Nvitación <br /> sin compromiso</h3>
          <p>
            <b>¿Tienes dudas o pedidos especiales?</b>, <br /> Escríbenos por WhatsApp
            y hagamos que tu invitación sea perfecta <br />😊
          </p>
        </div>

        <div id="formu">
          <form>
 

            <label for="nombre">Nombre</label>
            <input type="text" id="nombre" placeholder="Tu nombre" />
            <label for="fecha">Fecha del evento</label>
            <input type="date" name="fecha" id="fecha" />
            <label for="evento">Tipo de evento</label>
            <select name="evento" id="evento">
              <option value="Boda">Boda</option>
              <option value="Xv">XV años</option>
              <option value="Cumple">Cumpleaños</option>
            </select>

            <Btn
              liga="#"
              id="empezar"
              texto="<b>Enviar</b> ahora"
              clases="desactivado, btn-oscuro"
              claro={false}
              blank={true}
            >
              <Icon name="mdi:whatsapp" />
            </Btn>
          
          </form>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  .intro {
    line-height: 1.1em;
    text-align: center;
    font-size: clamp(1.3rem, 1.7vw, 2.7rem);
    margin: $margen $margen-min;
  }
  #colores {
    padding-top: $margen;
    text-align: center;
    padding-bottom: $margen;
    h2 {
      color: $primario;
      b {
        color: $acento;
      }
    }
  }
  #bandejacolor {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: $margen-cel;
    h3 {
      color: $acento;
      padding: 0 0 $margen-min 0;
      border-bottom: dashed 0.1rem $terciario;
    }
    .item {
      padding: $margen;
      @include cel {
        padding: 0;
      }
    }
  }
</style>

<script>
  const mivideoquince = document.getElementById(
    "video-quince-cel",
  ) as HTMLVideoElement;
  const play = document.getElementById("play") as HTMLDivElement;

  play.addEventListener("click", playPause);

  function playPause() {
    if (mivideoquince.paused) mivideoquince.play();
    else mivideoquince.pause();
  }
</script>
