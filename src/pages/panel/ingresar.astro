---
import Layout from "../../layouts/panelInvitados.astro";
---

<Layout title="Ingreso a panel de invitador">
  <div id="ingreso">
    <div class="izq">
      <div class="bandeja">
        <img
          src="/nvita-logo.svg"
          alt="Nvita invitaciones digitales"
          id="logo"
        />
        <h1>Ingresa a tu panel de invitados</h1>
        <p>Administra, edita y agrega invitados a tu evento.</p>

        <form data-authForm action="../api/ingresar.json">
          <label for="email"
            >Email

            <input
              type="email"
              name="email"
              id="email"
              autocomplete="username"
              placeholder="Agrega un email válido"
            />
          </label>
          <label for="password"
            >Contraseña

            <input
              type="password"
              name="password"
              id="password"
              autocomplete="password"
              aria-describedby="auth-error"
              placeholder="Ingresa tu contraseña "
            />
          </label>
          <p id="auth-error" data-form-error role="alert" hidden></p>
          <button type="submit">Ingresar</button>
        </form>
      </div>
    </div>
    <div class="der">
      <img src="/panel-ingreso.webp" alt="ingresar a panel nvita" />
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "../../estilos/_variables.scss" as *;
  #logo {
    max-width: 200px;
    margin: $margen-cel;
  }

  #ingreso {
    display: flex;
    flex-direction: row;
    flex-wrap:wrap;
    justify-content: center;
    align-items: center;
    height: 100vh;
    width: 100vw;
    background-color: $fondoGlobal;
    color: #fff;
  }
  h1 {
    font-size: clamp(2rem, 3vw, 5rem);
    color: $primario;
  }
  .izq {
    display: flex;
    flex: 1 0 50%;
    .bandeja {
      padding: $margen;
      text-align: center;
    }
    @include cel {
      .bandeja {
        padding: $margen-cel;
      }
      order: 2;
    }
  }
  form {
    display: flex;
    flex-wrap: wrap;
    text-align: left;
    width: 40%;
    margin: 0 auto;
    @include cel {
      width: 100%;
    }
  }
  label {
    flex: 1 0 100%;
    font-weight: bold;
    color: $acento;
    @include cel {
      flex: 1 0 100%;
      text-align: center;
      input{
        text-align: center;
      }
    }
  }
  input {
    width: 100%;
    border-radius: 10px;
    margin-top: .4rem;
    padding: .5rem .7rem;
  }
  button {
    flex: 1 0 fit-content;
    margin-top: $margen-cel;
    max-width: 250px;
    background-color: $acento;
    border: none;
    padding: .7rem;
    border-radius: 10px;
    color: #fff;
    font-weight: bold;
    font-size: clamp(1rem, .7vw, 1.2rem);
    &:disabled {
      cursor: wait;
      opacity: .65;
    }
    @include cel {
      left: 50%;
      transform: translateY( -50%);
      max-width: 100%;
      margin-top: $margen;
    }
  }
  [aria-invalid="true"] {
    border: 2px solid #d9534f;
    outline: none;
  }
  #auth-error {
    flex: 1 0 100%;
    margin: $margen-cel 0 0;
    color: $primario;
    font-size: .8rem;
    border: solid 1px $secundario;
    padding: .5rem $margen-min;
    border-radius: $radio;
  }
  .der {
    flex: 1 0 50%;
    height: 100dvh;
background-color: $primario;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @include cel {
      order: 1;
      height: 25dvh;
      display: none;
    }
  }
</style>
