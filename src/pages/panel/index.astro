---
import Layout from "../../layouts/panelInvitados.astro";
import Menu from "../../components/PanelInvitados/Menu.astro";
import Invitado from "../../components/PanelInvitados/Invitado.astro";
import type { InvitadoProps } from "../../components/PanelInvitados/Invitado.astro";
import AgregarInvitado from "../../components/PanelInvitados/AgregarInvitado.astro";
import EditarInvitado from "../../components/PanelInvitados/EditarInvitado.astro";
import AddonCTA from "../../components/PanelInvitados/AddonCTA.astro";
import GestorMesas from "../../components/PanelInvitados/GestorMesas.astro";
import GestorProveedores from "../../components/PanelInvitados/GestorProveedores.astro";
import type { ProveedorProps } from "../../components/PanelInvitados/GestorProveedores.astro";
import { Usuario, Invitados, Mesas, Proveedores, PagosProveedor, TareasProveedor, db, eq, desc, inArray } from "@/db";
import { Icon } from "astro-icon/components";

type MesaData = {
  id: number;
  usuarioId: number;
  nombre: string;
  capacidad: number;
};

// Ensure the user is authenticated
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect("/panel/ingresar");
}

const usuarioEmail = user.email;
const usuarioId = user.id;
const tipoInvitacion = user.tipo;
const ruta = user.ruta;
const nombreEvento = user.nombreEvento;
const fechaEvento = user.fechaEvento;
const addonMesas = user.addonMesas;
// user may not have addonProveedores in its type; cast to any to avoid TS error
const addonProveedores = (user as any).addonProveedores ?? user.ruta?.includes("lux");

let invitadosData: InvitadoProps[] = [];
let mesasData: MesaData[] = [];
let proveedoresData: ProveedorProps[] = [];

try {
  // Obtén los datos de los invitados
  invitadosData = await db
    .select()
    .from(Invitados)
    .where(eq(Invitados.usuarioId, usuarioId))
    .orderBy(desc(Invitados.id));

  // Ordenar: sin confirmar primero (!confirmado && !noAsiste), luego confirmados (confirmado && !noAsiste), y al final no asiste (noAsiste)
  invitadosData.sort((a, b) => {
    const getCategory = (inv: InvitadoProps) => {
      if (inv.noAsiste) return 3;
      if (inv.confirmado) return 2;
      return 1;
    };
    const catA = getCategory(a);
    const catB = getCategory(b);
    if (catA !== catB) {
      return catA - catB;
    }
    return b.id - a.id; // Mantener orden cronológico por ID dentro de cada grupo
  });

  // Obtén las mesas si tiene el add-on activo
  if (addonMesas) {
    mesasData = await db
      .select()
      .from(Mesas)
      .where(eq(Mesas.usuarioId, usuarioId));
  }

  // Obtén los proveedores si es plan LUX o tiene add-on activo
  if (addonProveedores) {
    const provs = await db
      .select()
      .from(Proveedores)
      .where(eq(Proveedores.usuarioId, usuarioId));

    if (provs.length > 0) {
      const pIds = provs.map((p) => p.id);
      const pagos = await db.select().from(PagosProveedor).where(inArray(PagosProveedor.proveedorId, pIds));
      const tareas = await db.select().from(TareasProveedor).where(inArray(TareasProveedor.proveedorId, pIds));

      proveedoresData = provs.map((p) => {
        const pPagos = pagos.filter((pago) => pago.proveedorId === p.id);
        const pTareas = tareas.filter((tarea) => tarea.proveedorId === p.id);
        const totalPagado = pPagos.reduce((sum, pago) => sum + pago.monto, 0);

        return {
          ...p,
          totalPagado,
          saldoPendiente: Math.max(0, p.presupuestoTotal - totalPagado),
          pagos: pPagos,
          tareas: pTareas,
        };
      });
    }
  }
} catch (error) {
  console.error("Error al obtener los datos:", error);
  invitadosData = [];
  mesasData = [];
  proveedoresData = [];
}

// Calcular estadísticas de confirmación
const totalInvitados = invitadosData.length;
const totalConfirmados = invitadosData.filter((inv) => inv.confirmado && !inv.noAsiste).length;
const porcentajeConfirmados = totalInvitados > 0 ? (totalConfirmados / totalInvitados) * 100 : 0;

const totalPasesAsignados = invitadosData.reduce(
  (sum, inv) => sum + parseInt(inv.pasesOriginales || inv.pases || "0"),
  0
);

const totalPasesConfirmados = invitadosData.reduce(
  (sum, inv) => sum + (inv.confirmado && !inv.noAsiste ? parseInt(inv.pases || "0") : 0),
  0
);

const pasesLiberados = invitadosData.reduce((sum, inv) => {
  const original = parseInt(inv.pasesOriginales || inv.pases || "0");
  if (inv.noAsiste) {
    return sum + original;
  }
  if (inv.confirmado) {
    const confirmados = parseInt(inv.pases || "0");
    return sum + Math.max(0, original - confirmados);
  }
  return sum;
}, 0);

const pasesPendientes = invitadosData.reduce(
  (sum, inv) =>
    !inv.confirmado && !inv.noAsiste
      ? sum + parseInt(inv.pasesOriginales || inv.pases || "0")
      : sum,
  0
);

// Calcular días restantes y alertas dinámicas de cuenta regresiva
let diasRestantes = null;
let alertaTipo = null; // "motivacional" | "celebrativa"
let totalPendientesConfirmacion = 0; 
if (fechaEvento) {
  const hoy = new Date();
  hoy.setHours(0, 0, 0, 0);
  const fechaEv = fechaEvento instanceof Date ? fechaEvento : new Date(fechaEvento);
  if (!isNaN(fechaEv.getTime())) {
    fechaEv.setHours(0, 0, 0, 0);

    const diffTime = fechaEv.getTime() - hoy.getTime();
    diasRestantes = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    // Contar los invitados que aún no confirman (y no han cancelado/asisten)
    totalPendientesConfirmacion = invitadosData.filter(
      (inv) => !inv.confirmado && !inv.noAsiste
    ).length;

    if (diasRestantes <= 15 && diasRestantes >= 0) {
      if (porcentajeConfirmados >= 80 || totalPendientesConfirmacion === 0) {
        alertaTipo = "celebrativa";
      } else {
        alertaTipo = "motivacional";
      }
    }
  }
}

import { useTranslations } from "../../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
---

<Layout title={nombreEvento ? `Panel - ${nombreEvento}` : t('panel.menu.title')}>
  <Menu tipo={tipoInvitacion} ruta={ruta} nombreEvento={nombreEvento} invitados={invitadosData} proveedores={proveedoresData} />
  
  <!-- Banner de Cuenta Regresiva Amigable (Alineado en el grid original) -->
  {alertaTipo && (
    <section class="grid contenido no-margin-bottom">
      <div class={`alerta-panel ${alertaTipo}`}>
        <div class="alerta-icon">
        </div>
        <div class="alerta-mensaje">
          {alertaTipo === "celebrativa" ? (
            <span>
              <strong>{lang === 'en' ? `Only ${diasRestantes} ${diasRestantes === 1 ? 'day' : 'days'} until the big day! 🎉` : `¡Solo ${diasRestantes} ${diasRestantes === 1 ? 'día' : 'días'} para el gran día! 🎉`}</strong> {t('panel.countdown.celebrate', { days: diasRestantes ?? 0, dayText: diasRestantes === 1 ? t('panel.countdown.day') : t('panel.countdown.days') })}
            </span>
          ) : (
            <span>
              <strong>{lang === 'en' ? `${diasRestantes} ${diasRestantes === 1 ? 'day' : 'days'} until the big day.` : `${diasRestantes} ${diasRestantes === 1 ? 'día' : 'días'} para el gran día.`}</strong> {t('panel.countdown.motivational', { days: diasRestantes ?? 0, dayText: diasRestantes === 1 ? t('panel.countdown.day') : t('panel.countdown.days'), pending: totalPendientesConfirmacion, invText: totalPendientesConfirmacion === 1 ? t('panel.countdown.invitation') : t('panel.countdown.invitations'), passes: pasesPendientes, passText: pasesPendientes === 1 ? t('panel.countdown.pass') : t('panel.countdown.passes') })}
            </span>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Pestañas de Navegación del Panel si Add-ons o LUX están activos -->
  {(addonMesas || addonProveedores) && (
    <section class="grid contenido no-margin-bottom">
      <div class="tabs-container">
        <button class="tab-btn active" data-tab="invitados">
          <Icon name="mdi:account-group-outline" size={20} />
          <span>{t('panel.tabs.invitations')}</span>
        </button>

        {addonMesas && (
          <button class="tab-btn" data-tab="mesas">
            <Icon name="mdi:table-furniture" size={20} />
            <span>{t('panel.tabs.tables')}</span>
          </button>
        )}

        {addonProveedores && (
          <button class="tab-btn" data-tab="proveedores">
            <Icon name="mdi:store-outline" size={20} />
            <span>{t('panel.tabs.vendors')}</span>
          </button>
        )}
      </div>
    </section>
  )}

  <!-- Contenido de la pestaña INVITADOS -->
  <div
    id="tab-invitados"
    class="tab-content active"
    data-nombre-evento={nombreEvento || "Mi Evento"}
    data-fecha-evento={fechaEvento && !isNaN(new Date(fechaEvento).getTime()) ? new Date(fechaEvento).toISOString().split('T')[0] : ""}
    data-invitados={JSON.stringify(invitadosData)}
  >
    <section class="grid contenido">
      <div id="hero">
        <div class="barra-progreso-container">
          <h3>{t('panel.hero.progressTitle')}</h3>
          <div class="barra-progreso">
            <div
              class="barra"
              style={`--progress: ${
                invitadosData.length > 0
                  ? Math.round(
                      (invitadosData.filter(
                        (inv) => inv.confirmado && !inv.noAsiste
                      ).length /
                        invitadosData.length) *
                        100
                    )
                  : 0
              }%`}
            >
            </div>
          </div>
          <p class="porcentaje-texto">
            <span class="porcentaje"
              >{
                invitadosData.length > 0
                  ? Math.round(
                      (invitadosData.filter(
                        (inv) => inv.confirmado && !inv.noAsiste
                      ).length /
                        invitadosData.length) *
                        100
                    )
                  : 0
              }%</span
            > {lang === 'en' ? 'of invitations confirmed,' : 'de invitaciones confirmadas,'}
            <span class="confirmados">{totalPasesConfirmados}</span> {lang === 'en' ? 'passes confirmed,' : 'pases confirmados,'}
            <span class="pendientes">{pasesPendientes}</span> {lang === 'en' ? 'passes to confirm' : 'pases por confirmar'}
          </p>
        </div>
        <div class="estadisticas">
          <div class="stat-item">
            <span class="stat-numero">{invitadosData.length}</span>
            <span class="stat-label">{t('panel.stats.created')}</span>
          </div>
            <div class="stat-item">
            <span class="stat-numero"
              >{invitadosData.filter((inv) => inv.InvitacionEnviada).length}</span
            >
            <span class="stat-label">{t('panel.stats.sent')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-numero">{totalPasesAsignados}</span>
            <span class="stat-label">{t('panel.stats.assignedPasses')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-numero">{totalPasesConfirmados}</span>
            <span class="stat-label">{t('panel.stats.confirmedPasses')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-numero">{pasesLiberados}</span>
            <span class="stat-label">{t('panel.stats.releasedPasses')}</span>
          </div>
          <div class="stat-item">
            <span class="stat-numero"
              >{invitadosData.filter((inv) => inv.noAsiste).length}</span
            >
            <span class="stat-label">{t('panel.stats.declined')}</span>
          </div>
        
        </div>

        <div class="section-header invitados-section-header">
          <h2>{t('panel.tabs.invitations')} ({invitadosData.length})</h2>

          <div id="conteAgregar">

            {usuarioId ? (

<button id="btn-exportar-invitados" class="btn-excel" title={t('panel.actions.downloadExcel')}>
              <Icon name="mdi:file-excel-outline" size={18} />
              <span>{t('panel.actions.downloadExcel')}</span>
            </button>
              <button id="agregar-invitado" class="btn-primary-sm">
              <Icon name="mdi:account-plus-outline" size={18} />
              <span>{t('panel.actions.addGuest')}</span>
            </button>
          ) : null}
          </div>
        </div>

        <div class="conteFiltros">
          <div class="filtros-top-row">
            <input
              id="search-input"
              type="text"
              placeholder={t('panel.actions.searchPlaceholder')}
              class="buscador"
            />

            <!-- Selector de Canal de Envío (WhatsApp / SMS / Ambos) -->
            <div class="canal-envio-wrapper">
              <span class="canal-label">{t('panel.channel.label')}</span>
              <div class="canal-botones">
                <button class="canal-btn activo" data-channel="whatsapp" type="button" title="WhatsApp">
                  <Icon name="mdi:whatsapp" size={15} />
                  <span>{t('panel.channel.whatsapp')}</span>
                </button>
                <button class="canal-btn" data-channel="sms" type="button" title="SMS / iMessage">
                  <Icon name="mdi:message-text-outline" size={15} />
                  <span>{t('panel.channel.sms')}</span>
                </button>
                <button class="canal-btn" data-channel="all" type="button" title={t('panel.channel.all')}>
                  <span>{t('panel.channel.all')}</span>
                </button>
              </div>
            </div>
          </div>

          <div class="filtros-estado">
            <button class="filtro-btn activo" data-estado="todos">{t('panel.filters.all')}</button>
            <button class="filtro-btn" data-estado="enviada">{t('panel.filters.sent')}</button>
            <button class="filtro-btn" data-estado="confirmado">{t('panel.filters.confirmed')}</button>
            <button class="filtro-btn" data-estado="NoAsiste">{t('panel.filters.declined')}</button>
            <button class="filtro-btn" data-estado="noEnviada">{t('panel.filters.pending')}</button>
          </div>
        </div>
      </div>

      <ul id="invitados-list">
        {
          invitadosData.length > 0 ? (
            invitadosData.map((invitado: InvitadoProps) => (
              <li
                class="invitado-item"
                data-nombre={invitado.nombre.toLowerCase()}
                data-estado={
                  invitado.confirmado
                    ? "confirmado"
                    : invitado.noAsiste
                      ? "NoAsiste"
                      : invitado.InvitacionEnviada
                        ? "enviada"
                        : "noEnviada"
                }
              >
                <Invitado
                  invitadoData={invitado}
                  ruta={ruta}
                  tipo={tipoInvitacion}
                />
              </li>
            ))
          ) : (
            <p>
              No tienes invitados aún. Usa el botón de abajo para agregar uno.
            </p>
          )
        }
      </ul>

      {
        usuarioId ? (
          <>
            <AgregarInvitado usuarioId={usuarioId} />
            <EditarInvitado />
          </>
        ) : (
          <>{console.error("No se encontró el ID del usuario.")}</>
        )
      }

      <!-- Banner Promo para adquirir add-on de Mesas si no lo tiene comprado -->
      {!addonMesas && (
        <div class="addon-promo-section">
          <AddonCTA
            nombre="Gestor de Mesas"
            descripcion="Distribuye tus invitados en mesas numeradas, calcula espacios libres y controla la capacidad en tiempo real desde tu celular."
            icono="mdi:table-furniture"
          />
        </div>
      )}
    </section>
  </div>

  <!-- Contenido de la pestaña GESTIÓN DE MESAS -->
  {addonMesas && (
    <div id="tab-mesas" class="tab-content">
      <section class="grid contenido">
        <GestorMesas mesas={mesasData} invitados={invitadosData} nombreEvento={nombreEvento} fechaEvento={fechaEvento} />
      </section>
    </div>
  )}

  <!-- Contenido de la pestaña PROVEEDORES -->
  {addonProveedores && (
    <div id="tab-proveedores" class="tab-content">
      <section class="grid contenido">
        <GestorProveedores proveedores={proveedoresData} nombreEvento={nombreEvento} />
      </section>
    </div>
  )}
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Funcionalidad de pestañas (tabs) con persistencia en localStorage
    const tabBtns = document.querySelectorAll(".tab-btn");
    const tabContents = document.querySelectorAll(".tab-content");

    const switchTab = (targetTab: string) => {
      tabBtns.forEach((b) => {
        if (b.getAttribute("data-tab") === targetTab) {
          b.classList.add("active");
          b.classList.add("activo");
        } else {
          b.classList.remove("active");
          b.classList.remove("activo");
        }
      });
      tabContents.forEach((c) => {
        if (c.id === `tab-${targetTab}`) {
          c.classList.add("active");
        } else {
          c.classList.remove("active");
        }
      });
      localStorage.setItem("panelActiveTab", targetTab);
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab");
        if (targetTab) {
          switchTab(targetTab);
        }
      });
    });

    // Restaurar pestaña activa tras recarga
    const savedTab = localStorage.getItem("panelActiveTab");
    if (savedTab && document.getElementById(`tab-${savedTab}`)) {
      switchTab(savedTab);
    }

    // 2. Funcionalidad del buscador y filtros
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const invitadosList = document.getElementById("invitados-list");
    
    if (searchInput && invitadosList) {
      const invitadoItems = invitadosList.querySelectorAll(".invitado-item") as NodeListOf<HTMLLIElement>;
      const filtroBtns = document.querySelectorAll(".filtro-btn") as NodeListOf<HTMLButtonElement>;

      let estadoFiltro = "todos";

      const filtrarInvitados = () => {
        const searchTerm = searchInput.value.toLowerCase().trim();

        invitadoItems.forEach((item) => {
          const nombre = item.getAttribute("data-nombre") || "";
          const estado = item.getAttribute("data-estado") || "";

          const cumpleBusqueda = nombre.includes(searchTerm);
          const cumpleFiltro = estadoFiltro === "todos" || estado === estadoFiltro;

          item.style.display = cumpleBusqueda && cumpleFiltro ? "block" : "none";
        });
      };

      searchInput.addEventListener("input", filtrarInvitados);

      filtroBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filtroBtns.forEach((b) => {
            b.classList.remove("activo");
            b.classList.remove("active");
          });
          btn.classList.add("activo");
          btn.classList.add("active");
          estadoFiltro = btn.getAttribute("data-estado") || "todos";
          filtrarInvitados();
        });
      });
    }

    // 2.1 Selector de Canal de Envío (WhatsApp / SMS / Ambos)
    const canalBtns = document.querySelectorAll(".canal-btn") as NodeListOf<HTMLButtonElement>;
    const setDispatchChannel = (channel: string) => {
      document.documentElement.setAttribute("data-dispatch-channel", channel);
      canalBtns.forEach((btn) => {
        if (btn.getAttribute("data-channel") === channel) {
          btn.classList.add("activo");
          btn.classList.add("active");
        } else {
          btn.classList.remove("activo");
          btn.classList.remove("active");
        }
      });
      localStorage.setItem("nviteDispatchChannel", channel);
    };

    const savedChannel = localStorage.getItem("nviteDispatchChannel") || "whatsapp";
    setDispatchChannel(savedChannel);

    canalBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const channel = btn.getAttribute("data-channel") || "whatsapp";
        setDispatchChannel(channel);
      });
    });

    // 3. Exportar a Excel (SheetJS)
    const loadSheetJS = () => {
      return new Promise<void>((resolve, reject) => {
        if ((window as any).XLSX) {
          resolve();
          return;
        }
        const script = document.createElement("script");
        script.src = "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js";
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("No se pudo cargar la librería de Excel."));
        document.head.appendChild(script);
      });
    };

    const btnExportar = document.getElementById("btn-exportar-invitados") as HTMLButtonElement | null;
    btnExportar?.addEventListener("click", async () => {
      if (!btnExportar) return;
      try {
        btnExportar.disabled = true;
        const originalText = btnExportar.innerHTML;
        btnExportar.innerHTML = "<span>Generando...</span>";
        
        await loadSheetJS();
        
        const tabInvitados = document.getElementById("tab-invitados");
        const invitados = JSON.parse(tabInvitados?.getAttribute("data-invitados") || "[]");
        const nombreEvento = tabInvitados?.getAttribute("data-nombre-evento") || "evento";
        const fechaEvento = tabInvitados?.getAttribute("data-fecha-evento") || "";
        
        interface ExportRow {
          Nombre: string;
          Pases: number;
          Estado: string;
          Tipo: string;
          WhatsApp: string;
          "Invitación Enviada": string;
          "Invitado VIP": string;
          Mesa: string;
        }
        
        const formattedData: ExportRow[] = invitados.map((inv: any) => {
          let estado = "Sin confirmar";
          if (inv.noAsiste) estado = "No asiste";
          else if (inv.confirmado) estado = "Confirmado";
          
          return {
            Nombre: String(inv.nombre || ""),
            Pases: parseInt(String(inv.pases || "0"), 10),
            Estado: estado,
            Tipo: String(inv.tipoInvitacion || "Familiar"),
            WhatsApp: String(inv.numeroWhats || "Sin registrar"),
            "Invitación Enviada": inv.InvitacionEnviada ? "Sí" : "No",
            "Invitado VIP": inv.vip ? "Sí" : "No",
            Mesa: String(inv.mesa || "Sin asignar")
          };
        });
        
        // Ordenar: mesas agrupadas, al final Sin asignar
        formattedData.sort((a, b) => {
          if (a.Mesa !== "Sin asignar" && b.Mesa === "Sin asignar") return -1;
          if (a.Mesa === "Sin asignar" && b.Mesa !== "Sin asignar") return 1;
          if (a.Mesa !== "Sin asignar" && b.Mesa !== "Sin asignar") {
            return a.Mesa.localeCompare(b.Mesa);
          }
          return a.Nombre.localeCompare(b.Nombre);
        });
        
        const XLSX = (window as any).XLSX;
        const worksheet = XLSX.utils.json_to_sheet(formattedData);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "Invitados");
        
        // Ajustar ancho de columnas automáticamente
        const maxLen = formattedData.reduce((acc, row) => {
          acc.Nombre = Math.max(acc.Nombre, row.Nombre.length);
          acc.Estado = Math.max(acc.Estado, row.Estado.length);
          acc.Tipo = Math.max(acc.Tipo, row.Tipo.length);
          acc.WhatsApp = Math.max(acc.WhatsApp, row.WhatsApp.toString().length);
          acc.Mesa = Math.max(acc.Mesa, row.Mesa.length);
          return acc;
        }, { Nombre: 10, Pases: 6, Estado: 15, Tipo: 12, WhatsApp: 15, Mesa: 15 });
        
        worksheet["!cols"] = [
          { wch: maxLen.Nombre + 3 },
          { wch: 10 },
          { wch: maxLen.Estado + 3 },
          { wch: maxLen.Tipo + 3 },
          { wch: maxLen.WhatsApp + 3 },
          { wch: 20 },
          { wch: 15 },
          { wch: maxLen.Mesa + 3 }
        ];
        
        const sanitizedNombre = nombreEvento.toLowerCase().replace(/[^a-z0-9]/g, "-").replace(/-+/g, "-").replace(/^-|-$/g, "");
        const fileName = `invitados-${sanitizedNombre}-${fechaEvento || new Date().toISOString().split("T")[0]}.xlsx`;
        
        XLSX.writeFile(workbook, fileName);
        
        btnExportar.innerHTML = originalText;
        btnExportar.disabled = false;
      } catch (err) {
        console.error(err);
        alert("Ocurrió un error al descargar el Excel.");
        btnExportar.innerHTML = "<span>Descargar Excel</span>";
        btnExportar.disabled = false;
      }
    });
  });
</script>

