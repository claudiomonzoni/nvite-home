<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("manual-search-input");
    const clearBtn = document.getElementById("clear-search-btn");
    const topicButtons = document.querySelectorAll(".topic-item");
    const sections = document.querySelectorAll(".topic-section");
    const accordionItems = document.querySelectorAll(".question-accordion-item");
    const emptyState = document.getElementById("search-empty-state");
    const freqButtons = document.querySelectorAll(".freq-btn");
    const clearFiltersBtn = document.getElementById("clear-filters-btn");

    let activeFilter = "all";
    let searchQuery = "";

    function applyFilterAndSearch() {
      const q = searchQuery.trim().toLowerCase();
      let totalVisibleQuestions = 0;

      sections.forEach((sec) => {
        const secSlug = sec.getAttribute("data-section");
        const matchesTopic = activeFilter === "all" || activeFilter === secSlug;

        let secHasVisibleQuestions = false;
        const questionsInSec = sec.querySelectorAll(".question-accordion-item");

        questionsInSec.forEach((item) => {
          const keywords = item.getAttribute("data-keywords") || "";
          const text = item.textContent.toLowerCase();
          const matchesQuery = q === "" || keywords.includes(q) || text.includes(q);

          if (matchesTopic && matchesQuery) {
            item.style.display = "block";
            secHasVisibleQuestions = true;
            totalVisibleQuestions++;
            if (q.length >= 3) {
              item.open = true;
            }
          } else {
            item.style.display = "none";
          }
        });

        // Mostrar u ocultar la sección completa
        sec.style.display = secHasVisibleQuestions ? "block" : "none";
      });

      if (emptyState) {
        emptyState.style.display = totalVisibleQuestions === 0 ? "block" : "none";
      }

      if (clearBtn) {
        clearBtn.style.display = q.length > 0 ? "flex" : "none";
      }
    }

    // Buscador
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value;
        applyFilterAndSearch();
      });

      // Atajo de teclado Cmd+K / Ctrl+K
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }

    // Limpiar búsqueda
    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchQuery = "";
          searchInput.focus();
          applyFilterAndSearch();
        }
      });
    }

    // Click en categorías del menú lateral
    topicButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        topicButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.getAttribute("data-target") || "all";

        // Si se seleccionó una categoría específica y estamos en desktop, hacemos scroll suave hacia ella
        if (activeFilter !== "all" && window.innerWidth > 960) {
          const targetEl = document.getElementById(`sec-${activeFilter}`);
          if (targetEl) {
            const offset = 90;
            const bodyRect = document.body.getBoundingClientRect().top;
            const elementRect = targetEl.getBoundingClientRect().top;
            const elementPosition = elementRect - bodyRect;
            const offsetPosition = elementPosition - offset;

            window.scrollTo({
              top: offsetPosition,
              behavior: "smooth"
            });
          }
        }

        applyFilterAndSearch();
      });
    });

    // Consultas frecuentes
    freqButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const query = btn.getAttribute("data-query") || "";
        if (searchInput) {
          searchInput.value = query;
          searchQuery = query;
          activeFilter = "all";
          topicButtons.forEach((b) => b.classList.remove("active"));
          topicButtons[0]?.classList.add("active");
          applyFilterAndSearch();
          searchInput.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      });
    });

    // Reset todo
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        activeFilter = "all";
        topicButtons.forEach((b) => b.classList.remove("active"));
        topicButtons[0]?.classList.add("active");
        applyFilterAndSearch();
      });
    }
  });
</script>

