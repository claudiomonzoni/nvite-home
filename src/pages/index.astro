---
//export const prerender = true;
import Banner from "../components/Banner.astro";
import Caracteristicas from "../components/Caracteristicas.astro";
import Hero from "../components/HeroNuevo.astro";
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn.astro";
import Footer from "../components/Footer.astro";
import BannerGeneral from "../components/BannerGeneral.astro";
import { Icon } from "astro-icon/components";
import Faq from "../components/Faq.astro";
import CaracteristicasGrid from "../components/CaracteristicasGrid.astro";
import Testimonios from "../components/Testimonios.astro";
import OfertaTiempo from "../components/OfertaTiempo.astro";
import MostrarNvitaciones from "../components/Pagos/MostrarNvitaciones.astro";
import Slider from "../components/Slider.astro";
import caracteristicasImg from "../assets/home/home-invitaciones-digitales-caracteristicas-nvitaciones.webp";
import coverDesktopHome from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv.webp";
import coverMobileHome from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel.webp";
import MesasHome from "../components/MesasHome.astro";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
---

  <Layout
  title={t('landing.meta.title')}
  description={t('landing.meta.description')}
>

  <Hero h1={t('landing.hero.h1')}
  p={t('landing.hero.p')}
  textoValidacion={t('landing.hero.validation')}
  imagenDesktop={coverDesktopHome}
  imagenMobile={coverMobileHome}/>
  
  <div class="grid contenido">
    <div id="choro">
      <h2>{t('landing.intro.h2')}</h2>
      <p set:html={t('landing.intro.p')}>
      </p>
    </div>
  </div>

  <!-- <div class="grid contenido">
   <OfertaTiempo
     encabezado="<b>Aprovecha 15% </b>de descuento"
     texto="Oferta imperdible. <b>aplica el cupón: NVITAME15</b> a la hora de adquirir tu invitación de boda o 15 años (versión Lux)."
     small="Solo aplica para pagos en línea, <b>la oferta se acaba:</b>"
     horasValidez={25}
     img="/promo.webp"
     porcentaje={15}
   />
 </div> -->

