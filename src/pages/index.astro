        src="https://www.youtube.com/embed/UBu6HRRfCdA"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
  </section> -->
  <div id="nvitaciones">
    <MostrarNvitaciones dondeEstoy="home" />
  </div>

  <div class="grid contenido">
    <Slider />
  </div>



  

  <div class="grid contenido">
    <BannerGeneral
      encabezado={t('landing.bannerGeneral.heading')}
      texto={t('landing.bannerGeneral.text')}
      tema="terciario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/recibes.webp"
      margenAbajo={true}
    >
      <Btn
        liga="#faq"
        texto={t('landing.bannerGeneral.btn')}
        clases="btn-oscuro"
        claro={true}
        blank={false}
      >
        <Icon name="mdi:comment-question-outline" size={25} />
      </Btn>
    </BannerGeneral>
  </div>

  <Testimonios />

  <MesasHome />
  <div id="precios" class="grid pantalla">
    <Banner dondeEstoy="home" />
  </div>

  <div class="grid contenido" id="faq">
    <Faq />
  </div>

  <CaracteristicasGrid
    matriz={[
      {
        imagen: caracteristicasImg,
        titulo: lang === 'en' ? "Let's start with your <span>invitations</span>" : "Iniciemos con tus <span>invitaciones</span>",
        texto: lang === 'en' ? "Modern invitations with the tools to give you total control and peace of mind" : "Invitaciones modernas con las herramientas que te darán el control y la tranquilidad",
        txtbtn: lang === 'en' ? "Contact us" : "Contáctanos",
        icono: "mdi:account-question-outline",
        enlace: "#formu",
      },
      {
        imagen: "mdi:infinity",
        titulo: lang === 'en' ? "Invite without limits" : "Invita sin límites",
        texto: lang === 'en' ? "No extra charges for guest count, invite everyone you love" : "Sin cargos extras por número de invitados, invita a todos los que quieras",
        enlace: "#",
      },
      {
        imagen: "mdi:account-multiple-check-outline",
        titulo: lang === 'en' ? "Encourage RSVPs" : "Motiva confirmaciones",
        texto: lang === 'en' ? "Inspire more guests by showing who has already confirmed attendance" : "Anima a más invitados mostrando en tiempo real quién ya confirmó asistencia",
      },
      {
        imagen: "mdi:infinity-box",
        titulo: lang === 'en' ? "Total control" : "Control total",
        texto: lang === 'en' ? "<span>Track</span> and manage who attends your celebration easily" : "<span>Consulta</span> y gestiona quién asiste a tu evento fácilmente",
      },
      {
        imagen: "mdi:infinity-box",
        titulo: lang === 'en' ? "Assign passes" : "Asigna pases",
        texto: lang === 'en' ? "<span>Assign</span> customized passes per invitation for precise control" : "<span>Asigna</span> pases personalizados por invitación para un control preciso",
      },
    ]}
  />

  <section class="grid contenido">
    <div id="conteCaracteristicas">
      <Caracteristicas
        encabezado={t('landing.guarantee.title')}
        texto={t('landing.guarantee.text')}
        icono="mdi:shield-crown-outline"
        fondo="/fondo-nvite-caracteristicas.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.delivery.title')}
        texto={t('landing.delivery.text')}
        icono="mdi:package-variant-closed-delivered"
        fondo="/fondo-nvite-caracteristicas-2.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.changes.title')}
        texto={t('landing.changes.text')}
        icono="mdi:connect-without-contact"
        fondo="fondo-nvite-caracteristicas-3.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.support.title')}
        texto={t('landing.support.text')}
        icono="mdi:support"
        fondo="fondo-nvite-caracteristicas-4.png"
        colorBg="#FFF1E1"
      />
    </div>
  </section>

  <section class="grid contenido" id="formulario">
    <div class="flex">
      <div class="fondo-formu">
        <div class="bande">
          <h3>{t('landing.form.title')}</h3>
          <p set:html={t('landing.form.desc')} />
        </div>

        <div id="formu">
          <form>
            <label for="nombre">{t('landing.form.name')}</label>
            <input type="text" id="nombre" placeholder={t('landing.form.namePlaceholder')} />
            <label for="fecha">{t('landing.form.date')}</label>
            <input type="date" name="fecha" id="fecha" />
            <label for="evento">{t('landing.form.type')}</label>
            <select name="evento" id="evento">
              <option value="Boda">{t('landing.form.boda')}</option>
              <option value="Xv">{t('landing.form.quince')}</option>
              <option value="Cumple">{lang === 'en' ? 'Birthday' : 'Cumpleaños'}</option>
            </select>

            <Btn
              liga="#"
              id="empezar"
              texto={t('landing.form.send')}
              clases="desactivado, btn-oscuro"
              claro={false}
              blank={true}
            >
              <Icon name="mdi:whatsapp" />
            </Btn>
          </form>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  const mivideoHome = document.getElementById(
    "video-home-cel",
  ) as HTMLVideoElement;
  const play = document.getElementById("play") as HTMLDivElement;

  if (play && mivideoHome) {
    play.addEventListener("click", playPause);
  }

  function playPause() {
    if (mivideoHome) {
      if (mivideoHome.paused) mivideoHome.play();
      else mivideoHome.pause();
    }
  }
</script>
