---
export const prerender = true;
import { Icon } from "astro-icon/components";
import Btn from "../components/Btn.astro";
import Caracteristicas from "../components/Caracteristicas.astro";
import Herointerior from "../components/Herointerior.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
import BannerGeneral from "../components/BannerGeneral.astro";
import Footer from "../components/Footer.astro";
import CaracteristicasGrid from "../components/CaracteristicasGrid.astro";

import PreciosPdf from "../components/PreciosPdf.astro";
import MostrarNvitaciones from "../components/Pagos/MostrarNvitaciones.astro";
import pdfCaracteristicasImg from "../assets/home/pdf-caracteristicas.webp";
---

<Layout
  title="Invitaciones interactivas para XV Años, Bodas y Cumpleaños, ideales para WhatsApp"
  description="Invitaciones digitales interactivas en PDF, con botones a Google Maps, confirmación por WhatsApp y más. Sorprende a tus invitados desde el primer clic."
>
  <div class="grid contenido">
    <Nav />
  </div>

  <Herointerior
    Spanh1="<b>Invitaciones interactivas</b> "
    h1="ideales"
    Spanh2="y sin complicaciones"
    description="<b>Impresiona a tus invitados</b>. con invitaciones en PDF personalizadas y listas para enviar ilimitadamente."
    fondo="#fff"
    imagen="/Nvitaciones-invitaciones-pdf.webp"
    imagencel="/Nvitaciones-invitaciones-pdf-cel.webp"
    
  />

  <div class="grid contenido">
    <div id="choro">
    
          <h2>Invitaciones interactivas <br /> elegancia y practicidad.</h2>

          <p>
            <b>Listas para enviar ilimitadamente.</b> Incluyen botones para confirmar asistencia y ver la ubicación en mapas, sin complicaciones, solo recibelas y envialas por whatsapp.
          </p>
        </div>

  </div>

  <div class="grid contenido">
    <div id="conteCaracteristicas">
      <Caracteristicas
        encabezado="Datos"
        texto="Personaliza las invitaciones con tu información."
        icono="mdi:gear-outline"
        fondo="/fondo-nvite-caracteristicas-3.png"
        colorBg="#fff"
      />

      <Caracteristicas
        encabezado="Envia"
        texto="Por whatsapp o e-mail."
        icono="mdi:invoice-text-send-outline"
        fondo="/fondo-nvite-caracteristicas-3.png"
      />

      <Caracteristicas
        encabezado="Recibe"
        texto="Confirmaciones y mensajes de tus invitados."
        icono="mdi:account-check-outline"
        fondo="/fondo-nvite-caracteristicas-4.png"
        colorBg="#fff"
      />

      <Caracteristicas
        encabezado="Ilimitado"
        texto="Envia a todos tus invitados sin límite."
        icono="mdi:infinity"
        fondo="/fondo-nvite-caracteristicas-2.png"
      />
    </div>
  </div>


<div id="nvitaciones">

  <MostrarNvitaciones dondeEstoy="pdf" />
</div>
  <CaracteristicasGrid
    matriz={[
      {
        imagen: pdfCaracteristicasImg,
        titulo: "Invitaciones <span>economicas</span>",
        texto:
          "Tus invitados recibirán una invitación interactiva con los detalles de tu evento, incluyendo fecha, hora, ubicación y más.",
        enlace: "#precios",
      },
      {
        imagen: "mdi:whatsapp",
        titulo: "Confirmación de asistencia",
        texto:
          "Facilita la confirmación de asistencia con un botón que conecta directamente a WhatsApp.",
        enlace: "#",
      },
      {
        imagen: "mdi:check-circle",
        texto:
          "Incluye enlaces a Google Maps para la recepción y ceremonia",
      },
      {
        imagen: "mdi:infinity-box",
        texto:
          "Itinerarios, mesa de regalos y más.",
      },
      {
        imagen: "mdi:infinity-box",
        texto:
          "Listas para <span>enviarse</span> digitalmente.",
      },
    ]}
  />

  <div id="precios" class="grid contenido">
    <PreciosPdf dondeEstoy="quince" />
  </div>

  <div class="grid contenido">
    <BannerGeneral
      encabezado="Recibes con tu <b>Nvitación PDF</b>"
      texto={`
    <ul>
    <li><b>Trato personalizado</b> durante y después de tu compra</li>
    <li>Recibes tu Nvitación interactiva PDF, con los datos de tu evento <b> a más tardar, 2 días hábiles</b> después del envio de tus datos</li>
 
        <li><mark>tiene envíos ilimitados</mark></li>
   
        </ul>
        <small>*Panel de invitados no aplica en la versión "basic o PDF"</small>
        <br>
        `}
      tema="terciario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/pdf-caracteristicas-2.webp"
      margenAbajo={true}
    >
  
    </BannerGeneral>
  </div>

 
<section class="grid contenido" id="formulario">
  <div class="flex">
    <div class="fondo-formu">
      <div class="bande">
        <h2>Prueba tu Nvitación <br /> sin compromiso</h2>
        <p>
          <b>¿Tienes dudas o pedidos especiales?</b>, <br /> Escríbenos por WhatsApp y hagamos
          que tu invitación sea perfecta <br />😊
        </p>
      </div>

      <div id="formu">
        <form>
          <!-- <h3>
          <img src="/whatsapp.png" alt="logo whatsapp">
          <b>whatsapp</b></h3> -->

          <label for="nombre">Nombre</label>
          <input type="text" id="nombre" placeholder="Tu nombre" />
          <label for="fecha">Fecha del evento</label>
          <input type="date" name="fecha" id="fecha" />
          <label for="evento">Tipo de evento</label>
          <select name="evento" id="evento">
            <option value="Boda">Boda</option>
            <option value="Xv">Xv años</option>
            <option value="Cumple">Cumpleaños</option>
          </select>

          <Btn
            liga="#"
            id="empezar"
            texto="<b>Enviar</b> ahora"
            clases="desactivado, btn-oscuro"
            claro={false}
            blank={true}
          >
            <Icon name="mdi:whatsapp" />
          </Btn>
          <!-- <button type="submit" id="empezar" class="desactivado">Empezemos</button> -->
        </form>
      </div>
    </div>
  </div>
</section>

  <Footer />
</Layout>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  .intro {
    line-height: 1.1em;
    text-align: center;
    font-size: clamp(1.3rem, 1.7vw, 2.7rem);
    margin: $margen $margen-min;
  }
  #colores {
    padding-top: $margen;
    text-align: center;
    padding-bottom: $margen;
    h2 {
      color: $primario;
      b {
        color: $acento;
      }
    }
  }
  #bandejacolor {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(300px, 1fr)
    ); // Ajustar el tamaño mínimo y máximo de los videos
    gap: 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: $margen-cel;

    .mostrando {
      display: block;
    }
    .escondido {
      display: none;
    }
    .item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: $margen;
      h3 {
        color: $primario;
        font-size: clamp(1.5rem, 1.5vw, 1.6rem);
      }

      .video-pdf {
        width: 100%;
        aspect-ratio: 16 / 9; // Mantener proporción de video
        position: relative;

        video {
          width: 100%;
          height: 100%;
          object-fit: cover; // Asegurar que el video se ajuste al contenedor
          border-radius: $radio;
        }

        #play {
          position: absolute;
          top: 50%;
          left: 10%;
          transform: translate(-50%, -50%);
          z-index: 1000;
          display: flex;
          justify-content: center;
          align-items: center;
          padding: 1em;
          @extend .sombra;
          border-radius: 50%;
          aspect-ratio: 1/1;
          cursor: pointer;
          path {
            fill: $acento;
          }
        }
      }

      @include cel {
        padding: 0;
        h3 {
          margin-top: $margen-cel;
        }
      }

    }
  }
</style>

<script>
  function initializeVideoButtons() {
    const items = document.querySelectorAll("#bandejacolor .item");

    items.forEach((item) => {
      const video = item.querySelector("video");
      const playButton = item.querySelector("#play");
      if (!playButton || !video) return;

      const mostrando = playButton.querySelector(".mostrado") as HTMLElement | null;
      const escondido = playButton.querySelector(".escondido") as HTMLElement | null;

      playButton.addEventListener("click", () => {
        if (video.paused) {
          video.play();
          if (mostrando) mostrando.style.display = "none";
          if (escondido) escondido.style.display = "flex";
        } else {
          video.pause();
          if (mostrando) mostrando.style.display = "flex";
          if (escondido) escondido.style.display = "none";
        }
      });

      video.addEventListener("ended", () => {
        if (mostrando) mostrando.style.display = "flex";
        if (escondido) escondido.style.display = "none";
      });
    });

    const choroPlayButton = document.querySelector("#video-home #play");
    const choroVideo = document.querySelector("#video-home video") as HTMLVideoElement | null;
    if (choroPlayButton && choroVideo) {
      const choroMostrando = choroPlayButton.querySelector(".mostrado") as HTMLElement | null;
      const choroEscondido = choroPlayButton.querySelector(".escondido") as HTMLElement | null;

      choroPlayButton.addEventListener("click", () => {
        if (choroVideo.paused) {
          choroVideo.play();
          if (choroMostrando) choroMostrando.style.display = "none";
          if (choroEscondido) choroEscondido.style.display = "flex";
        } else {
          choroVideo.pause();
          if (choroMostrando) choroMostrando.style.display = "flex";
          if (choroEscondido) choroEscondido.style.display = "none";
        }
      });

      choroVideo.addEventListener("ended", () => {
        if (choroMostrando) choroMostrando.style.display = "flex";
        if (choroEscondido) choroEscondido.style.display = "none";
      });
    }
  }

  initializeVideoButtons();
</script>

  document.addEventListener("astro:page-load", initializeVideoButtons);
</script>
