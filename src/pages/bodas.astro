---
import { Icon } from "astro-icon/components";
import Btn from "../components/Btn.astro";
import Caracteristicas from "../components/Caracteristicas.astro";
import Hero from "../components/HeroNuevo.astro";
import Layout from "../layouts/Layout.astro";
import BannerGeneral from "../components/BannerGeneral.astro";
import Footer from "../components/Footer.astro";
import CaracteristicasGrid from "../components/CaracteristicasGrid.astro";
import Banner from "../components/Banner.astro";
import SaveTheDate from "../components/SaveTheDate.astro";
import MostrarNvitaciones from "../components/Pagos/MostrarNvitaciones.astro";
import bodasCaracteristicasImg from "../assets/bodas/caracteristicas-bodas.webp";

import coverDesktopBoda from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-intBoda.webp";
import coverMobileBoda from "../assets/home/nvitaciones-invitaciones-digitales-boda-xv-cel-intBoda.webp";
import MesasHome from "../components/MesasHome.astro";
import Cardcuadro from "../components/Cardcuadro.astro";
import Faq from "../components/Faq.astro";
import LigasBlog from "../components/blog/LigasBlog.astro";
import { useTranslations } from "../i18n/ui";

const lang = Astro.locals.lang || "es";
const t = useTranslations(lang);
const beachWeddingGuides = lang === "en"
  ? [
      {
        href: "/en/blog/beach-wedding-invitations-guest-information",
        title: "What to include in a beach wedding invitation",
        description: "Maps, schedules, lodging details, and other information guests need.",
      },
      {
        href: "/en/blog/organize-beach-wedding-rsvp-guests",
        title: "How to organize beach wedding RSVPs",
        description: "Keep responses, assigned passes, and guest requests in order.",
      },
      {
        href: "/en/blog/beach-wedding-ixtapa-zihuatanejo-guest-guide",
        title: "Ixtapa-Zihuatanejo guest guide",
        description: "Help guests find the travel details for a wedding on the Pacific coast.",
      },
    ]
  : [
      {
        href: "/blog/invitaciones-boda-playa-informacion-invitados",
        title: "Qué incluir en una invitación para boda en la playa",
        description: "Mapas, horarios, hospedaje y los detalles que necesitan tus invitados.",
      },
      {
        href: "/blog/organizar-rsvp-invitados-boda-playa",
        title: "Cómo organizar el RSVP de una boda en la playa",
        description: "Ordena respuestas, pases asignados y necesidades de tus invitados.",
      },
      {
        href: "/blog/boda-playa-ixtapa-zihuatanejo-guia-invitados",
        title: "Guía para invitados de una boda en Ixtapa-Zihuatanejo",
        description: "Comparte información de viaje para celebrar junto al Pacífico.",
      },
    ];

const schemaBodasService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": lang === "en" ? "Digital invitations for beach weddings" : "Invitaciones digitales para bodas en la playa",
  "serviceType": lang === "en" ? "Beach wedding digital invitation design" : "Diseño de invitaciones digitales para bodas en la playa",
  "description": t("bodas.meta.description"),
  "provider": {
    "@type": "ProfessionalService",
    "name": "Nvitaciones",
    "url": "https://nvitaciones.com"
  },
  "areaServed": {
    "@type": "Country",
    "name": lang === "en" ? "Mexico" : "México"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": lang === "en" ? "Wedding invitations" : "Invitaciones de boda",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": lang === "en" ? "Lux digital wedding invitation" : "Invitación Digital de Boda Lux"
        },
        "priceCurrency": "MXN",
        "price": "1699"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": lang === "en" ? "Classic digital wedding invitation" : "Invitación Digital de Boda Clásica"
        },
        "priceCurrency": "MXN",
        "price": "1299"
      }
    ]
  }
};
---

<Layout
  title={t('bodas.meta.title')}
  description={t('bodas.meta.description')}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaBodasService)} />
  <div class="grid contenido"></div>

  <Hero
    h1={t('bodas.hero.h1')}
    p={t('bodas.hero.p')}
    textoValidacion={t('landing.hero.validation')}
    imagenDesktop={coverDesktopBoda}
    imagenMobile={coverMobileBoda}
  />

  <div class="grid contenido">
    <div id="choro">
      <h2>{t('bodas.intro.h2')}</h2>
      <p set:html={t('bodas.intro.p')} />
    </div>
  </div>

  <div id="nvitaciones">
    <MostrarNvitaciones dondeEstoy="bodas" />
  </div>

  <CaracteristicasGrid
    matriz={[
      {
        imagen: bodasCaracteristicasImg,
        titulo: lang === 'en' ? "Personalized <span>Invitations</span>" : "Invitaciones <span>personalizadas</span>",
        texto: lang === 'en' 
          ? "Your guests deserve to see their name before reading a single line. Every invitation arrives fully customized with their name and assigned passes."
          : "La persona más importante para ti merece ver su nombre antes de leer una sola línea. Cada invitación llega personalizada — con el nombre del invitado y los pases que le corresponden.",
        enlace: "#precios",
      },
      {
        imagen: "mdi:email-check",
        titulo: lang === 'en' ? "Attendance Confirmation" : "Confirmación de asistencia",
        texto: lang === 'en' ? "Total control of attendees, making RSVP confirmation effortless for your guests." : "Ten control de los asistentes a tu evento, facilítales a tus invitados su confirmación.",
        enlace: "#",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? "Unlimited invitations, send them to all your loved ones." : "Invitaciones ilimitadas, envíalas a todos tus amigos y seres queridos.",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? " <span>all the essential details</span> for your wedding" : "Con <span>toda la información</span> necesaria para tu boda",
      },
      {
        imagen: "mdi:infinity-box",
        texto: lang === 'en' ? "<span>Zero</span> stress chasing guest responses manually" : "<span>Cero</span> estrés por buscar a tus invitados en persona",
      },
    ]}
  />

  <MesasHome />

  <div id="precios" class="grid contenido">
    <Banner dondeEstoy="bodas" />
  </div>

  <section class="grid contenido">
    <div class="flex">
      <Cardcuadro
        titulo={t('bodas.card.lodging.title')}
        description={t('bodas.card.lodging.desc')}
        fondo="/hospedaje.webp"
        icono="mdi:hotel-outline"
      />
      <Cardcuadro
        titulo={t('bodas.card.confirmed.title')}
        description={t('bodas.card.confirmed.desc')}
        fondo="/confirmando.webp"
        icono="mdi:account-arrow-right-outline"
      />
      <Cardcuadro
        titulo={t('bodas.card.qr.title')}
        description={t('bodas.card.qr.desc')}
        fondo="/qr-nvitaciones-3.webp"
        icono="mdi:qrcode"
      />
    </div>


    <LigasBlog
      ariaLabel={lang === "en" ? "Beach wedding guides" : "Guías para bodas en la playa"}
      eyebrow={lang === "en" ? "Plan with confidence" : "Planea con más claridad"}
      title={lang === "en" ? "Planning a beach wedding? Start here." : "¿Planeas una boda en la playa? Empieza por aquí."}
      description={lang === "en"
        ? "Practical guides to help you share travel details, collect replies, and make the celebration easier for your guests."
        : "Guías prácticas para compartir detalles del viaje, organizar confirmaciones y hacer más sencilla la celebración para tus invitados."}
      readLabel={lang === "en" ? "Read the guide" : "Leer la guía"}
      links={beachWeddingGuides}
    />

    <!-- <BannerGeneral
      encabezado={t('bodas.banner1.heading')}
      texto={t('bodas.banner1.text')}
      tema="primario"
      icono="mdi:archive-clock-outline"
      urlImagen="../assets/home/gale/confirmacion.webp"
    />
    <BannerGeneral
      encabezado={t('bodas.banner2.heading')}
      texto={t('bodas.banner2.text')}
      tema="secundario"
      icono="mdi:music"
      izquierda={true}
      urlImagen="../assets/home/gale/musica.webp"
    />

    <BannerGeneral
      encabezado={t('bodas.banner3.heading')}
      texto={t('bodas.banner3.text')}
      tema="primario"
      icono="mdi:image-plus"
      urlImagen="../assets/home/gale/frase.webp"
    /> -->
  </section>

  <div class="grid contenido">
    <BannerGeneral
      encabezado={t('landing.bannerGeneral.heading')}
      texto={t('landing.bannerGeneral.text')}
      tema="terciario"
      icono="mdi:deal"
      urlImagen="../assets/home/gale/recibes.webp"
      margenAbajo={true}
    >
      <Btn
        liga="#formu"
        texto={lang === 'en' ? 'Get your invitation' : 'Obtén tu invitación'}
        clases="btn-oscuro"
        claro={true}
        blank={false}
      >
        <Icon name="bag" size={25} />
      </Btn>
    </BannerGeneral>
  </div>

  <div class="grid contenido">
    <SaveTheDate
      h2={lang === 'en' ? "Save the date <span>Free</span>" : "Save the date <span>Gratis</span>"}
      p={lang === 'en' ? "<b>Download your free Save the Date</b> in PDF format and share your date with loved ones." : "<b>Descarga gratis tu Save the Date</b>, en formato PDF y comparte con tus seres queridos la fecha de tu boda."}
      imagenes={[
        {
          imagen: "/reserva-la-fecha-1.webp",
          liga: "https://drive.google.com/file/d/1p8vFvo8Nrcfg1hc7kWKPuZelHMvTDyEW/view?usp=drive_link",
        },
        {
          imagen: "/reserva-la-fecha-2.webp",
          liga: "https://drive.google.com/file/d/17ZyXf4TW5NZvJTBz8l3n8tFrXHpDIPsI/view?usp=drive_link",
        },
        {
          imagen: "/reserva-la-fecha-3.webp",
          liga: "https://drive.google.com/file/d/1r_vCzGdy2ahv0QqYPf23KGxokH_9ncQ5/view?usp=drive_link",
        },
      ]}
    />
  </div>

  <section class="grid contenido">
    <div id="conteCaracteristicas">
      <Caracteristicas
        encabezado={t('landing.guarantee.title')}
        texto={t('landing.guarantee.text')}
        icono="mdi:shield-crown-outline"
        fondo="/fondo-nvite-caracteristicas.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.delivery.title')}
        texto={t('landing.delivery.text')}
        icono="mdi:package-variant-closed-delivered"
        fondo="/fondo-nvite-caracteristicas-2.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.changes.title')}
        texto={t('landing.changes.text')}
        icono="mdi:connect-without-contact"
        fondo="fondo-nvite-caracteristicas-3.png"
        colorBg="#FFF1E1"
      />

      <Caracteristicas
        encabezado={t('landing.support.title')}
        texto={t('landing.support.text')}
        icono="mdi:support"
        fondo="fondo-nvite-caracteristicas-4.png"
        colorBg="#FFF1E1"
      />
    </div>
  </section>

  <!-- <div class="grid contenido" id="faq">
    <Faq />
  </div> -->

  <section class="grid contenido" id="formulario">
    <div class="flex">
      <div class="fondo-formu">
        <div class="bande">
          <h3>{lang === 'en' ? 'Try your Invitation with zero commitment' : 'Prueba tu Nvitación sin compromiso'}</h3>
          <p set:html={t('landing.form.desc')} />
        </div>

        <div id="formu">
          <form>
            <label for="nombre">{t('landing.form.name')}</label>
            <input type="text" id="nombre" placeholder={t('landing.form.namePlaceholder')} />
            <label for="fecha">{t('landing.form.date')}</label>
            <input type="date" name="fecha" id="fecha" />
            <label for="evento">{t('landing.form.type')}</label>
            <select name="evento" id="evento">
              <option value="Boda">{t('landing.form.boda')}</option>
              <option value="Xv">{t('landing.form.quince')}</option>
              <option value="Cumple">{lang === 'en' ? 'Birthday' : 'Cumpleaños'}</option>
            </select>

            <Btn
              liga="#"
              id="empezar"
              texto={t('landing.form.send')}
              clases="desactivado, btn-oscuro"
              claro={false}
              blank={true}
            >
              <Icon name="mdi:whatsapp" />
            </Btn>
          </form>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style lang="scss">
  @use "../estilos/_variables.scss" as *;

  .intro {
    line-height: 1.1em;
    text-align: center;
    font-size: clamp(1.3rem, 1.7vw, 2.7rem);
    margin: $margen $margen-min;
  }
  #colores {
    padding-top: $margen;
    text-align: center;
    padding-bottom: $margen;
    h2 {
      color: $primario;
      b {
        color: $acento;
      }
    }
  }
  #bandejacolor {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin-bottom: $margen-cel;
    h3 {
      color: $acento;
      padding: 0 0 $margen-min 0;
      border-bottom: dashed 0.1rem $terciario;
    }
    .item {
      padding: $margen;
      @include cel {
        padding: 0;
      }
    }
  }

</style>

<script>
  const mivideobodas = document.getElementById(
    "video-bodas-cel",
  ) as HTMLVideoElement;
  const play = document.getElementById("play") as HTMLDivElement;

  if (play && mivideobodas) {
    play.addEventListener("click", playPause);
  }

  function playPause() {
    if (mivideobodas) {
      if (mivideobodas.paused) mivideobodas.play();
      else mivideobodas.pause();
    }
  }
</script>
