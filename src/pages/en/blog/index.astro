---
import { getCollection } from "astro:content";
import BlogIndex from "../../../components/blog/BlogIndex.astro";

export const prerender = true;

const allPosts = await getCollection("blog", ({ data }) => !data.draft && data.language === "en");
const posts = allPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const alternates = [
  { lang: "es-MX", href: new URL("/blog", Astro.site).href },
  { lang: "en-US", href: new URL("/en/blog", Astro.site).href },
];
---

<BlogIndex
  posts={posts}
  language="en"
  languageUrls={{ es: "/blog", en: "/en/blog" }}
  alternates={alternates}
/>
