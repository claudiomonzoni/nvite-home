---
interface Props {
  title: string;
}

const { title } = Astro.props;
import "../estilos/globales.scss";
import {Font} from "astro:assets";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const lang = Astro.locals.lang || "es";
---

<!doctype html>
<html lang={lang === "en" ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="¡Que tu celebración sea inolvidable!, transforma las invitaciones de tu evento en una experiencia única con las invitaciones digitales de nvitaciones.com"
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <!-- Preload local Hurme font used in headers -->
    <link rel="preload" href="/fonts/hurme/HurmeGeometricSans4-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hurme/HurmeGeometricSans4-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Load Montserrat from Google Fonts non-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Bitter&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Bitter&display=swap"
      />
    </noscript>

    <Font cssVariable="--font-hurme" />
  </head>
  <body>
    <slot />
    <script>
  
      import { formSubmit } from "../pages/panel/lib/formSubmit";
      const form = document.querySelectorAll(
        "[data-authForm]"
      ) as NodeListOf<HTMLFormElement>;
      form.forEach((form) => {
        formSubmit(form);
      });
    </script>
  </body>
</html>


